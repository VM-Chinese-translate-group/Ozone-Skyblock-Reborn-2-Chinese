	quest.000303D086D2B044.quest_desc: ["Plant on grass to grow a sheep. Make sure to give it plenty of breathing room to grow."]
	quest.0019EFE1E929FEE1.quest_desc: ["Compact your produce into blocks!"]
	quest.003E76D37F01200A.quest_desc: ["Used to create simulations of mobs."]
	quest.00A306AED17F4112.quest_desc: ["All the stars in one convenient item"]
	quest.00C0AA4EA85737DA.quest_desc: ["Special apples that give different buffs! Hold shift while hovering over the apple to see its effects."]
	quest.00C42B07AAD68884.quest_desc: ["Essence Armor pieces are higher tier armor that can be upgraded using Augments."]
	quest.00D9318B5F7FDE7F.quest_desc: [
		"Ytones is the ultimate toolkit for builders who like their blocks sleek, futuristic, and endlessly versatile. With dozens of stone-like block sets — each featuring 16 stylish variations — you'll never run out of ways to spice up your builds. Whether you're designing a sci-fi lab, a modern metropolis, or just want something cooler than cobblestone, this mod has you covered."
		""
		"Craft the base blocks using a key ingredient, then use the stonecutter to access all variations — or even better, cycle them on the fly right in your hotbar! Just use two keys (G and H by default) to cycle through styles, hold Alt and scroll (fully configurable), or tap the hotbar key again (1–9) to swap instantly. No menus, no mess — just building flow."
	]
	quest.00D9318B5F7FDE7F.quest_subtitle: "Ytones"
	quest.00F6C5FCDC744A0D.quest_desc: ["Made out of one of every singularity"]
	quest.0131425E80E90FDE.quest_desc: ["Casings are both decorative and functional blocks used to craft and build various machines and devices within the mod."]
	quest.0169FD8AF8F2DDA4.quest_desc: ["Uses lava to generate RF."]
	quest.018240DF74627D73.quest_desc: ["Made of 10,000 aluminum ingots"]
	quest.01855C6724B85B3F.quest_desc: ["Catalysts are used in complex crafting recipes. They get harder to craft as they move higher in tiers."]
	quest.01855C6724B85B3F.quest_subtitle: "Extended Crafting"
	quest.018EC033B894DA77.quest_desc: ["在铸件台上使用以浇铸板材、齿轮和金属棒。"]
	quest.018EC033B894DA77.title: "铸模"
	quest.0190AAD17D5DE20D.quest_desc: ["Uses furnace fuel to generate RF."]
	quest.01A800996EF1127A.quest_desc: [
		"气动工艺全部都是关于气压的内容。查阅手册来学习这个模组，并跟随手册完成这条任务线。"
		""
		"开始气动工艺，你需要用TNT（或迷你TNT）炸铁锭来制作压缩铁锭。虽然产率不是100%，但开局还是比较合适的。以后我们可以用压力室达到更高产率，还能进行自动化。"
		""
		"气动工艺在游戏中期提供了一些很棒的盔甲，在JEI里看看吧！"
	]
	quest.01A800996EF1127A.quest_subtitle: "Pneumaticcraft"
	quest.01B8A92F5254E941.quest_desc: ["拥有同样的物品存储总量，但能容纳四种不同物品！"]
	quest.02316C06703C7D2B.quest_desc: ["A basic crafting material used as a key ingredient in many of Extended Crafting's advanced components."]
	quest.0231C9D125B29E7E.quest_desc: [
		"基础升级新增的功能有：红石模式。"
		""
		"升级是一种能够对管道进行增强的物品，可以提升管道的传输速度、效率，或是加入新的功能，例如过滤和堆叠。"
	]
	quest.0231C9D125B29E7E.quest_subtitle: "Pipez"
	quest.02518A623FB00BE0.quest_desc: ["多方块机器，燃烧生物柴油，产生大量RF能源。"]
	quest.02518A623FB00BE0.title: "柴油发电机"
	quest.0278D5659AD6BEEB.quest_desc: ["MEGA Cells is an add-on for Applied Energistics 2 providing higher tiers of storage, ranging in capacity from 1M to as high as 256M!"]
	quest.0278D5659AD6BEEB.quest_subtitle: "MEGA Cells"
	quest.0278D5659AD6BEEB.title: "MEGA Cell Housing"
	quest.028B1F38AD6F918C.quest_desc: ["An infinite energy storage and transfer block that supplies unlimited power across dimensions to any connected machines or networks."]
	quest.02A55B5EEAAA0776.quest_desc: ["Crafting component for Powah items."]
	quest.02A6BB2D5AFC44AC.quest_desc: [
		"To create seeds for mobs, you need to collect souls. This can be done in two ways."
		"- Soulium Dagger"
		"- Soul Extractor"
		""
		"Souls are collected using Soul Jars. Each Soul Jar can hold the souls of a single mob type. The amount of souls required to fill a Soul Jar differs depending on the mob."
	]
	quest.02AA09894A7363BD.quest_desc: [
		"能够生成无限多的圆石（以及其他方块）！只需要将其放置在水源方块和熔岩源方块之间。"
		""
		"要生成圆石以外的其他方块，请参阅JEI。"
		""
		"存在更高级的版本，详见JEI。"
	]
	quest.02AA09894A7363BD.quest_subtitle: "Cobblegen Galore"
	quest.02B0D8895641DC69.quest_desc: [
		"Complete this quest by successfully landing on Mars."
		""
		"Note: Mars contains Plutonium (radioactive)."
	]
	quest.02CC10C8AD373D9B.quest_desc: ["一个良好的开端。木桶可以用来从桶和坩埚间运输水。耐久有限。用它来运输熔岩不太明智。"]
	quest.02E01BE2547A5F38.quest_desc: ["Klein Stars are great sources of EMC - even better when you can get them from seeds!"]
	quest.02E01BE2547A5F38.quest_subtitle: "Mystical Agriculture"
	quest.03122E9277646415.quest_desc: ["Prevents hostile mobs from spawning, large radius"]
	quest.032193BAE8D6E08E.quest_desc: ["Elemental seeds create elemental essence - needed for Awakened Supremium."]
	quest.0390812A07C4ABB8.quest_desc: ["Biodisel plus biofuel plus sky stone dust in a refinery will create Stellaris oil."]
	quest.03A0FA63A3AFBC5D.quest_desc: [
		"在普通难度下合成金属块非常简单，但在专家模式则相当难。"
		""
		"专家模式：用镐子破坏矿石方块以得到粗矿，将粗矿3x3合成为粗矿块，再手持粗矿块右击充满熔岩的石桶。游戏后期会有更好的制作金属块的方式，详见JEI。"
	]
	quest.03AC14A7BE6B4833.quest_desc: ["Take a seat and eat some lunch!"]
	quest.03B8D5EE6E52994C.quest_desc: ["Applied Energistics 2 adds components and mechanics to provide logistics and storage solutions. You can replace your massive room full of chests with a compact ME Network, but that's just the beginning of things. Applied Energistics is meant to work with and allow automation of other mods in a modpack. You can set up your system to, with a single click, craft all of the prerequisites (and the final result) of a complex crafting chain, or keep certain quantities of items in stock, crafting more as needed, or simply transfer items around your base."]
	quest.03B8D5EE6E52994C.quest_subtitle: "Appled Energistics 2"
	quest.03D53824229BCB6C.quest_desc: ["Upgraded essences are crafted using the previous tier of essence and an infusion crystal. Used to create Tier 3 seeds. (Crystals are required in expert mode)"]
	quest.03EB4D6A471B02DF.quest_desc: ["Defeat the Ender Dragon in exchange for a coin. Repeatable every hour."]
	quest.03EB4D6A471B02DF.quest_subtitle: "Coins avaliable!"
	quest.03EB4D6A471B02DF.title: "Bounty"
	quest.03F21A20BD91F3CA.quest_desc: ["Defeating a Forgotten Guardian in the Undergarden will earn you between four and sixteen forgotten nuggets. Consider using an Explorer's Compass to find the catacombs structure that they spawn in."]
	quest.04194DB3DE85D3B4.quest_desc: ["The Emerald Jetpack is the top-tier jetpack in this mod."]
	quest.04368E0530B208BD.quest_desc: [
		"Right click to instantly mine vein of ore. Mines (left click) in the following modes (cycle with G):"
		"- Standard: breaks one block at a time"
		"- 3x tall shot: breaks 3 blocks at once vertically"
		"- 3x wide-shot: breaks 3 blocks at once horizontally"
		"- 3x long-shot: breaks 3 blocks at once in a line in front of you"
	]
	quest.046AA10B979CE7CF.quest_desc: ["游戏中后期物品的合成材料！"]
	quest.0479C735A364CBDA.quest_desc: ["Crafted using Zanite Gemstones, the Altar can be used to enchant Gravitite Ore."]
	quest.04E6EB2D8FFE1EBA.quest_desc: ["Grassy plants (grass, wheat, rice etc) cut with a Knife will occasionally yield Straw, a firm and useful fiber"]
	quest.04F821C6068063F1.quest_desc: ["Components are used to craft catalysts. They get harder to craft as they move higher in tiers."]
	quest.05016BF9CC2CA48B.quest_desc: [
		"The ender gate can wirelessly pull power from the ender cell (Works similar to Flux Networks). Both can be upgraded. "
		""
		"Remember to put a battery into the ender cell for energy storage!"
	]
	quest.050E9ECB6D658C96.quest_desc: ["实体传送带能够将生物和物品水平移动。"]
	quest.0565492F3A30C232.quest_desc: ["Obtained by reprocessing ludicrite with magnetite, which is a waste product from using bluetonium as fuel in a reactor."]
	quest.05C818675A4A2782.quest_desc: ["Generates power from coal and the sun."]
	quest.05C818675A4A2782.title: "Generators"
	quest.05CACCE1488AB6C8.quest_desc: ["A safe place for messages from friends. And bills, and spam, and other junk..."]
	quest.05E67DC4DEA264A6.quest_desc: ["Create a mining laser setup for each Industrial Foregoing lens (see JEI for a list)."]
	quest.05EC1D616C2A9AD8.quest_desc: ["Sends wireless redstone signals."]
	quest.05FDF7CEC51457BE.quest_desc: [
		"Can be used in digestion, fermentation, and liquefaction recipes."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.0621C7B771E959F0.quest_desc: [
		"The essence that started it all..."
		""
		"Inferium Essence is one of the key materials needed to craft Mystical Agriculture blocks and items. It can be collected by killing both hostile and passive mobs and by farming Inferium Seeds."
		""
		"Used to create Tier 1 and Elemental seeds. (Crystals are required in expert mode)"
	]
	quest.06397541643EE9E4.quest_desc: [
		"Endgame blocks restricted, 4 durability."
		"Will not work on Chaos Block, Ultimate Block, Infinity Block, Infinity Crux, Ultimate Crux, Klein Star Crux, HDPE Block, Plutonium Block, Polonium Block, or Anitmatter Block."
		""
		"Right-click a block with a wand → it becomes an Enlivened Block entity."
		""
		"Enlivened entities can be captured/duplicated by other mods , providing a renewable source of that block. Note: Does not work if the spawner does not copy NBT."
		""
		"Use a Mob Imprisonment Tool on your new entity and duplicate in the Industrial Foregoing Mob Duplicator."
	]
	quest.066243CCEE772F0A.quest_desc: [
		"Magic Beans are a collection of colorful beans can be found in smaller vaults in the Troll Caves. A Diamond Pickaxe or a pickaxe of similar strength is normally needed to crack the vault open and claim the beans. You may also get Magic Beans as a very lucky drop from killing Trolls."
		""
		"When Magic Beans are planted in Uberous Soil, they will grow a giant beanstalk, reaching to cloud level. This serves as a convenient way to access the Cloud Cottage over the Highlands.  "
	]
	quest.066E2CD8219B369B.quest_desc: ["一阶升级，鼠标指针悬停在物品上以查看详细信息，能够合成金升级。"]
	quest.0678B5715CCEEE6A.quest_desc: ["The Chemical Injection Chamber uses Hydrogen Chloride gas to turn ores into 4 Shards. It is the start of x4 ore processing and requires a steady supply of Hydrogen Chloride, which in turn requires the player to have a Thermal Evaporation Plant running."]
	quest.067ECCB49F68CBFA.quest_desc: ["可升级的钉刺，击杀时视为玩家击杀，需要红石信号激活。"]
	quest.06937888BFF8D767.quest_desc: [
		"Ender IO machines that have an upgrade slot require capacitors to function."
		""
		"Depending on their Base Modifier, Capacitors can increase the Speed, Range or Energy Storage of machines."
		""
		"Level: 8"
	]
	quest.06A46A5949A9F3BA.quest_desc: [
		"Complete this quest by successfully landing on Venus."
		""
		"Note: Venus contains Neptunium (radioactive)."
	]
	quest.06BAFFA40A561DA9.quest_desc: [
		"Farmer's Delight is a mod that gently expands upon farming and cooking in Minecraft."
		""
		"The Stove is a direct upgrade to the Campfire's cooking features, and a suitable heat source for the Cooking Pot."
	]
	quest.06BAFFA40A561DA9.quest_subtitle: "农夫乐事"
	quest.072C62252199E65E.quest_desc: [
		"Liquid in a solid form; allows for easy transportation and alchemical processing."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.072C62252199E65E.title: "Water and Lava"
	quest.072FE6E79644DE29.quest_desc: ["Crafting component and energy storage item used to build and upgrade generators, energy cells, and other power-related devices."]
	quest.0780F0AC57703234.quest_desc: [
		"Right click to instantly till dirt on the charge level (V, shift+V)."
		""
		"- 1x1"
		"- 3x3"
		"- 5x5"
		"- 7x7"
	]
	quest.07A675B5899C6904.quest_desc: ["Essence Armor pieces are higher tier armor that can be upgraded using Augments."]
	quest.07ACB0F8CBD46771.quest_desc: [
		"Wireless power! What more could you want?"
		""
		"Removes energy from the flux network"
	]
	quest.07FD17445A955429.quest_desc: ["Enables you to automate complex crafting recipes. Putting an inventory on top will allow it to automatically pull items into the crafting table."]
	quest.0802317B97D895D4.quest_desc: ["[ \"Must complete the quest \", { \"text\": \"Canola Press\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"5F0F1FFB4160C1C0\" } }, \" to unlock.\" ]"]
	quest.0802317B97D895D4.quest_subtitle: "10 Coins"
	quest.0802317B97D895D4.title: "Rare Reward Bag"
	quest.080B650EBD5E9738.quest_desc: ["Processors are one of the primary ingredients in AE2 devices and machines. They are also one of your first big automation challenges. There are three types of processor, made with gold, Certus Quartz Crystal, and diamond respectively. They are made using presses in an Inscriber, in a multi-step process (usually achieved via a series of inscribers and filtered piping)."]
	quest.080B650EBD5E9738.title: "Processors"
	quest.08179DC19520193E.quest_desc: ["These crafting tables are used for more complex crafting recipes. Automated versions are also avaliable. See JEI for more details."]
	quest.083961E5D54A4AF2.quest_desc: ["Crafting component. Upgradable to next tier, see JEI."]
	quest.0845CA46AAFECAA1.quest_desc: [
		"A portal to another void world."
		""
		"Note: The void world that this portal takes you to has been known to sometimes cause performance issues. Take care when putting important machines or bases in here!"
		""
		"Do not launch a Stellaris rocket from the void dimension - bad things will happen!"
	]
	quest.0845CA46AAFECAA1.quest_subtitle: "JAVD"
	quest.08740A0C3F39848D.quest_desc: ["压力管道的强化版——可以承受更高压力！"]
	quest.089EE930957020B6.quest_desc: [
		"Right click to instantly turn dirt into path or harvest a layer at a time dirt and sand. Right click on gravel, clay, or snow to instantly harvest the vein. Based on the charge level (V, shift+V)."
		""
		"- disabled/1 block to path"
		"- 3x3"
		"- 5x5"
		"- 7x7"
		""
		"Harvests the normal shovel blocks extremely quickly."
	]
	quest.08B173A9EF4FB5AF.quest_desc: ["Extended Crafting adds more ways to craft items, more items to craft with, and more utilities for crafting. "]
	quest.08BB82725AF1F810.quest_desc: ["陶瓷坩埚可以用来获取熔岩，只需将其放置在热源上（一开始可以用火把或营火）并在坩埚里放入圆石即可。"]
	quest.08C405602991B1A9.quest_desc: ["Catalysts are used in complex crafting recipes. They get harder to craft as they move higher in tiers."]
	quest.091A0CAD568B9566.quest_desc: [
		"The Basic variant is your starter Reactor. With a maximum size of 5x5x5 blocks (external dimensions), it's the perfect solution to start the mod!"
		""
		"See the book for details and how to set up."
	]
	quest.091A0CAD568B9566.title: "Basic Reactor Components"
	quest.091C5591FC5A4116.quest_desc: ["石子可以合成圆石。"]
	quest.092088B386465246.quest_desc: ["A refined redstone-based material used in crafting advanced components and late-game machinery."]
	quest.0949229274785FB0.quest_desc: ["Load chunks so stuff keeps on ticking when you aren't around. 3x3 area."]
	quest.0955CDE0AF99C578.quest_desc: ["Cyanite and water in a reprocesser will create blutonium."]
	quest.09616105B2147867.quest_desc: [
		"铁钉刺能够放置在固体方块的任意面上，伤害接触到它们的生物和玩家，被杀死的生物将会掉落经验和常见掉落物。"
		""
		"Mob Grinding Utils模组鼓励玩家采用新方式进行刷怪，获取掉落物和经验。模组内包括了一个完全模块化的系统供玩家探索并使用，以最大化刷怪场的效率。"
	]
	quest.09616105B2147867.quest_subtitle: "Mob Grinding Utils"
	quest.096BF1C5A9A0F0B4.quest_desc: ["Just like the stove from Farmer's Delight!"]
	quest.097A73052FFD1BFA.quest_desc: ["连接排液孔，将熔融金属从镕铸炉中排出。"]
	quest.097B7BF8B0CBC549.quest_desc: ["抑制以其为中心半径八格范围内的实体传送行为，可以装在固体方块的任意面，右击开关。（译者注：物品上的描述不够准确，请以此任务描述为准）"]
	quest.098EE0E9BA10FE16.quest_desc: [
		"A vat for alchemical digestion, required for exaltation."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.099682D4CF5D3CFF.quest_desc: ["Place over a pipe to cover it with a facade!"]
	quest.09B16A1A15C81262.quest_desc: ["An upgraded furnace with a base cook time of 40"]
	quest.0A765530617B2B94.quest_desc: [
		"Chaos block and Anitmatter block restricted, 16 durability."
		""
		"Right-click a block with a wand → it becomes an Enlivened Block entity."
		""
		"Enlivened entities can be captured/duplicated by other mods , providing a renewable source of that block. Note: Does not work if the spawner does not copy NBT."
		""
		"Use a Mob Imprisonment Tool on your new entity and duplicate in the Industrial Foregoing Mob Duplicator."
	]
	quest.0AA83FF3BDF54213.quest_desc: [
		"EnderIO conduits can be placed in the same block as other conduits."
		""
		"Note: EnderIO cables are known to sometimes cause lag. If you experience this, consider switching to a different cable type."
	]
	quest.0AA83FF3BDF54213.title: "Conduits - Tier 1"
	quest.0AE2BFC6D900AD0F.quest_desc: ["扩大风扇的作用范围——高度，宽度，以及距离。"]
	quest.0AE2BFC6D900AD0F.title: "风扇升级"
	quest.0AFC1C633F5E6D38.quest_desc: ["Tier 2 - Can store 200 stacks."]
	quest.0B3E66925374481B.quest_desc: ["Produce and sustain 1 million EMC/second."]
	quest.0B49965D7D3DF4F9.quest_desc: [
		"Build a portal from stone bricks (same shape as a standard nether portal) and activate with the catalyst."
		""
		"The Undergarden is a dark, subterranean world located deep below the bedrock of the Overworld. The flora here has adapted to their conditions and can grow anywhere, independent of light. Strange creatures call these dark lands home, and are plagued by the invasive Rotspawn, monsters originating from a chaotic, mysterious realm."
	]
	quest.0B49965D7D3DF4F9.quest_subtitle: "The Undergarden"
	quest.0B49965D7D3DF4F9.title: "Into the Undergarden"
	quest.0B5848C907E7753B.quest_desc: ["用染料在末影箱子上染出颜色，相同颜色排列的末影箱子将互相配对。你可以链接两个及以上的末影箱子，无缝存取输送物品！"]
	quest.0B5848C907E7753B.quest_subtitle: "Ender Storage"
	quest.0BB68FE5EE0D7D63.quest_desc: [
		"无需接触就能链接附近的所有抽屉（使用升级延伸链接范围）。"
		""
		"你需要使用链接工具将抽屉链接到存储控制器。"
	]
	quest.0BC9DE119AF74A7A.quest_desc: ["Fluix ME Glass Cable is the simplest cable to make, transfers power and up to 8 channels. It comes in 17 different colors, the default being Fluix, and can be dyed any color using any of the 16 dyes."]
	quest.0BD2E8188BB912CB.quest_desc: [
		"Crafters are machines added by RFTools that will automatically craft items given a recipe, the necessary components and RF power. Multi-step crafting can be done in a single machine, limited only by the number of recipe slots."
		""
		"Crafter Tier 3 can remember 8 recipes."
	]
	quest.0BEC6FB4D100F23E.quest_desc: [
		"Even faster than the previous two tiers!"
		""
		"Place the torch on the ground and right-click to access the GUI."
	]
	quest.0C3DB4A72DC396C5.quest_desc: ["腐肉是一种可以食用的食物，但有很大概率给食用者施加饥饿效果。由僵尸掉落。"]
	quest.0C3DB4A72DC396C5.quest_subtitle: "Minecraft"
	quest.0C71AB75B63CC9A4.quest_desc: ["It does not use durability. Right-clicking a Dirt block with the Hoe of the Green Earth will place a 9x9 square of Farmland centered on the clicked block. "]
	quest.0C80CE674E69189A.quest_desc: ["为受到怪物捣碎器伤害的生物施加各种效果——每种最多放置10个。"]
	quest.0C80CE674E69189A.title: "捣碎器升级"
	quest.0CA6B94A84718B7D.quest_desc: [
		"Your starting point for Project E."
		""
		"Through crafting with the Philosopher's Stone (press C), you have discovered that the intense heat created when crafting can allow you to smelt 7 dusts or ores with a catalyst (namely charcoal or coal)."
		""
		"The Philosopher's Stone will also allow you to transmute dirt into sand and sand into grass. Stone can become cobblestone and likewise. Charging it (press V to charge, shift-V to discharge) will affect a wider area."
		""
		"Used to craft a variety of alchemical items and materials, the Philosopher's Stone is not consumed in the process."
	]
	quest.0CAFAE72AAEDE844.quest_desc: ["Obtained by reprocessing bluetonium and cyanite."]
	quest.0D1BC89C6E1168E2.quest_desc: [
		"Salt represents the \"body\" or the \"physical matter\" of an object."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.0D1BC89C6E1168E2.title: "Alchemical Salts"
	quest.0D2292A3FEECE0BB.quest_desc: [
		"Not an easy feat, but results in a substancial reward if you decide to attempt it. Collect trophies as you conquor your way through the Twilight Forest. The advancements page can help you with progression."
		""
		"&2Note: This quest is optional!&r"
	]
	quest.0D2292A3FEECE0BB.title: "Twilight Trophies"
	quest.0D30B2FB51D802FD.quest_desc: ["Power from the sun, but more advanced!"]
	quest.0D455041F06B11CF.quest_desc: ["Adds energy into the flux network"]
	quest.0D65B3E94CC15633.quest_desc: ["Once your model is Basic or higher, you can use the simulation chamber to run simulations of your model. Simulations will always produce a generalized prediction, and may also produce a Mob Prediction, based on the accuracy of the model. The higher tier of the model, the higher the accuracy, up to 99.5% at Self Aware. Running simulations requires energy (based on the model type) and a catalyst item, which is usually a Prediction Matrix."]
	quest.0DA6AB6E6D1BF58C.quest_desc: ["Enables you to automate complex crafting recipes. Putting an inventory on top will allow it to automatically pull items into the crafter."]
	quest.0DA822417944D807.quest_desc: ["Slay a chicken and cook its meat to obtain cooked chicken"]
	quest.0DA822417944D807.quest_subtitle: "Minecraft"
	quest.0DDA934D37D96D6C.quest_desc: ["多方块结构组件，排液孔用于将液体从熔炼炉排出。"]
	quest.0E012180FF171EA3.quest_desc: ["最高级的压力管道。"]
	quest.0E0DCFDDD225CBE9.quest_desc: ["Surrounding yourself in dark matter seems like such a good idea! It absorbs a large amount of damage taken. You are nearly invincible with the set of armor. At times, you think that you can see movement within the sheen of armor."]
	quest.0E352A7DB0D0E65D.quest_desc: ["Build a house out of bedrock."]
	quest.0E7A8DAC2DBAEB4D.quest_desc: ["延长可以与终端进行交互的距离，16格范围。"]
	quest.0EBFD58D6F06DFE7.quest_desc: ["每次升级都会增加存储空间以及升级槽位。"]
	quest.0EC5F7CAC60A570B.quest_desc: ["Try not to think about it"]
	quest.0EC9E0D3EA56886C.quest_desc: [
		"Using advanced connectors you can overcome the limitation of regular connectors and access the down side of a furnace from any other side. Advanced connectors have other advantages. They allow higher speeds for item and fluid transfer (10 ticks minimum per operation as opposed to 20) and can store more RF (which means they can also transfer more RF)."
		""
		"One warning: an advanced energy connector can still not extract energy from another side. The reason for this is that it is actually the generator/producer itself that pushes energy and it will not do that through that other side. Insertion of energy to another side does work however."
	]
	quest.0EF2FB5DA629DB4A.quest_desc: ["Even with the dark matter armor, you can still take a noticeable amount of damage when things start getting hairy. You decide to try throwing some red matter at the problem like any good alchemist, and find that this new Red Matter Armor blocks so much incoming damage you can't even feel anything apart from the actual kinetic energy pushing you around. But... Maybe you can go even one step further?"]
	quest.0F146A084493D964.quest_desc: ["Right click to turn wood into stripped logs and right click again to harvest instantly."]
	quest.0F2C31359D60538C.quest_desc: ["每次升级都会增加存储空间以及升级槽位。"]
	quest.0FCE294048DE59F6.quest_desc: ["Energy cubes can be used to hold large amounts of RF. The higher the tier, the more RF can be stored. Tier 1!"]
	quest.10233A3DC0B81EA4.quest_desc: ["Put into a drawer to hold an almost unlimited amount of an item"]
	quest.10233A3DC0B81EA4.quest_subtitle: "Functional Storage"
	quest.1045FDFE8AF10401.quest_desc: ["Stores power; can be a multiblock as well. Works across long distances and through dimensions"]
	quest.10540A8680E2AEF8.quest_desc: [
		"进阶升级新增的功能有：分配规则。"
		""
		"升级是一种能够对管道进行增强的物品，可以提升管道的传输速度、效率，或是加入新的功能，例如过滤和堆叠。"
	]
	quest.108159E6D64C856A.quest_desc: [
		"Tainted Gold is a material blessed with the deeper, darker aspects of aura, meaning they take much longer to infuse while using less aura in the process. Note that the same infusion is possible using the materials' block form."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.10CE847A01CF2909.quest_desc: [
		"Ender IO machines that have an upgrade slot require capacitors to function."
		""
		"Depending on their Base Modifier, Capacitors can increase the Speed, Range or Energy Storage of machines."
		""
		"Level: 6"
	]
	quest.10ED928F001EA290.quest_desc: ["The main block that handles transferring items, fluids, energy, or redstone through the laser network using configurable cards."]
	quest.10F60275E430ACDE.quest_desc: ["Crafting ingredient for hammers - 5x5x1"]
	quest.1108CD5FBC79FE9C.quest_desc: ["Injectors must be correct tier for crafting, see JEI. Power is required for fusion crafting. This is the maximum tier injector."]
	quest.112AE0A9B15941D2.quest_desc: ["这些管道可以升级，以获得更快的速度和过滤功能。"]
	quest.112AE0A9B15941D2.title: "Pipez"
	quest.117E924B8AD92073.quest_desc: ["The 4 circuit presses are used to craft processors in the inscriber. Use Mystical Agriculture to craft these presses."]
	quest.117E924B8AD92073.title: "Inscriber Presses"
	quest.117F5E5B6230A038.quest_desc: ["Special apples that give different buffs! Hold shift while hovering over the apple to see its effects."]
	quest.11E0906BD605061E.quest_desc: ["The covered cable variant offers no gameplay benefits over its Fluix ME Glass Cable counterpart. It can however be used as an alternate aesthetic choice if you prefer the covered look."]
	quest.11ED9715C659F22E.quest_desc: ["An upgraded furnace with a base cook time of 5"]
	quest.11F12A03CE38A8C7.quest_desc: [
		"Iron Chests模组为原版金属提供了对应材质的箱子！他们的容量各不相同，随着不断地升级，箱子的容量也会逐渐增加！"
		""
		"铜箱子由原版箱子升级而来。"
	]
	quest.11F12A03CE38A8C7.quest_subtitle: "Iron Chests"
	quest.11F34F6309A89E31.quest_desc: ["Tier 3 - Can store 300 stacks."]
	quest.120A4A99099FE5E4.quest_desc: ["Infinite-capacity storage block that provides and stores unlimited amounts of any fluid."]
	quest.1221C842C42C7F66.quest_desc: [
		"The Drive is the device you plug your storage cells into in order to use them for network storage. It has 10 slots which each accept a cell."
		""
		"If for some reason you want to, you can push and pull the cells from its inventory with any item logistics like hoppers or ae2 busses."
		""
		"It can be rotated with a Certus Quartz Wrench."
	]
	quest.1230550E4A5B23AC.quest_desc: [
		"Right click to instantly mine vein of ore. Mines (left click) in the following modes (cycle with G):"
		"- Standard: breaks one block at a time"
		"- 3x tall shot: breaks 3 blocks at once vertically"
		"- 3x wide-shot: breaks 3 blocks at once horizontally"
		"- 3x long-shot: breaks 3 blocks at once in a line in front of you"
	]
	quest.1231D9AF9F07AD12.quest_desc: ["Receives teleported players from a matter transmitter."]
	quest.1245AA386AB7F298.quest_desc: [
		"Crafters are machines added by RFTools that will automatically craft items given a recipe, the necessary components and RF power. Multi-step crafting can be done in a single machine, limited only by the number of recipe slots."
		""
		"Crafter Tier 1 can remember 2 recipes."
	]
	quest.1248104A9F7A3F32.quest_desc: ["Iron Jetpacks is a modern Jetpacks mod that is both feature-rich and easy to use. Jetpacks get better as you craft higher tiers. Coils are an integral part of the jetpack crafting process. See JEI."]
	quest.125C064F10CFBF60.quest_desc: [
		"筛子和锤：能够插入升级，快速地处理大量物品。需要能量（RF）。"
		""
		"压缩机：压缩筛出的物品，对所有自动筛矿系统来说都是很好的补充！需要能量（RF）。"
	]
	quest.125C064F10CFBF60.quest_subtitle: "Ex Machinis"
	quest.125C064F10CFBF60.title: "通量升级"
	quest.125E5D92A7D84955.quest_desc: ["沉浸工程多方块机器，以3x3x3形式搭建，手持工程师锤右击中心即可形成多方块结构。焦炉消耗煤炭，产生焦煤和杂酚油，详情查阅JEI或工程师手册。"]
	quest.125E5D92A7D84955.title: "焦炉"
	quest.1273EAF9DC0A7479.quest_desc: ["Found via mining in the Aether."]
	quest.12A5561178489FCC.quest_desc: [
		"The controller is the routing hub of a ME Network. Without it, a network is \"ad-hoc\" and can only have a max of 8 channel-using devices total."
		""
		"It is not possible to have 2 controllers in one ME Network."
		""
		"The controller provides 32 Channels per face."
		""
		"The controller requires 6 AE/t per controller block to function. Each controller block can store 8000 AE, so larger networks might require additional energy storage. See energy for details."
		""
		"Multiblock Controllers can be built in a fairly free form."
		""
		"However, there are a few rules that must be followed:"
		"- All controller blocks on a ME Network must be connected; else the blocks will turn red."
		"- The size of the controller must be within 7x7x7; else it will turn red."
		"-A controller can have 2 adjacent blocks in at most 1 axis; if a block violates this rule, it will disable and turn red."
	]
	quest.12AE4AE8955D0364.quest_desc: ["空气压缩机的升级版。"]
	quest.12B32970DF51871F.quest_desc: ["Hold shift key when hovering over the item to see stats."]
	quest.12D23F12FACE2F36.quest_desc: ["An upgraded furnace with a base cook time of 20"]
	quest.12E388A337027D9F.quest_desc: ["The Destruction Gadget allows you to void a large area."]
	quest.12F60B0E98F9D419.quest_desc: ["Tier 4, max tier - Can store 500 stacks."]
	quest.13010CE647E918A3.quest_desc: [
		"Ender IO machines that have an upgrade slot require capacitors to function."
		""
		"Depending on their Base Modifier, Capacitors can increase the Speed, Range or Energy Storage of machines."
		""
		"Level: 7"
	]
	quest.130380166BF98207.quest_desc: ["一个多方块结构，能够将流体灌入物品。例如将药水灌入空瓶或是为工具灌入润滑剂等液体。"]
	quest.130380166BF98207.title: "灌装机"
	quest.137F5A524DB75A97.quest_desc: ["Potion ingredient, found in nether fortresses."]
	quest.1388958122E58F71.quest_desc: ["Potion ingredient, slay a ghast to obtain."]
	quest.138FFE0F7A3437A7.quest_desc: ["奇异储罐是一种基础的流体储罐，能够容纳32桶流体。用它来存储刷怪场的经验吧！你还可以合成一个地漏经验奇异储罐，将你的经验存储为流体经验。"]
	quest.13E86FB30A4078F6.quest_desc: ["Froststeel can be found in the Frostfield biome of the Undergarden. Consider using the Nature's Compass to find the biome."]
	quest.14582B862A91C1E6.quest_desc: ["每次升级都会增加存储空间以及升级槽位。"]
	quest.14ADE52746F0F97D.quest_desc: [
		"Once the amount of aura required becomes too much for the Aura Cache to store without having to refill it on too regular of a basis, one can employ the help of an Aura Trove - a higher tier version of the Aura Cache that has three times its storage capacity."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.14F9F9F05968992D.quest_desc: [
		"Complete this quest by successfully landing on Mercury."
		""
		"Note: Mercury contains Uranium (radioactive)."
	]
	quest.151A5E0BF0ED82FC.quest_desc: ["A limitless power source that provides infinite energy output to connected machines and networks without requiring any fuel."]
	quest.153E5E7C7B50FBE8.quest_desc: ["Crafting ingredient for hammers - 3x3x3"]
	quest.156FE2D8DEE4B866.quest_desc: [
		"Used to infuse items; also used to craft Utherium Crystals."
		""
		"Note: this process can be automated with hoppers, with inputs and outputs similar to a vanilla furnace."
	]
	quest.157B60FE82028B25.quest_desc: [
		"To use framed blocks:"
		""
		"- Right click the block with almost any solid block to make it look alike."
		"- Right click the block with a fluid container to make it look like the fluid in the container."
		"- Right click the block with Glowstone Dust to make it produce light."
		"- Right click the block with a Framed Hammer to remove the camo."
		"- Right click the block with an empty fluid container to remove a fluid camo."
	]
	quest.159B578700BEC915.quest_desc: ["Crafting component. Upgradable to next tier, see JEI."]
	quest.15AF28F4684F51EF.quest_desc: [
		"要获得下界岩，首先要取得巫水，将装满水的桶放置在菌丝体方块上（用菌丝孢子右击泥土即可生成）即可获得巫水。接下来在石桶中混合巫水与熔岩，即可获得下界岩。"
		""
		"你也可以用熔岩和巫水制作刷下界岩机——就像用熔岩和水制作刷石机一样！"
	]
	quest.15B720B7F41B48E7.quest_desc: [
		"Right click to instantly mines blocks based on the charge level (V, shift+V)."
		""
		"- disabled"
		"- 3x3x2"
		"- 5x5x3"
		""
		"Does not mine dirt or gravel. It's also a powerful weapon and can be used as a tool to mine a single block at a time."
	]
	quest.1642C50313F491BA.quest_desc: ["A better version of the Charger - Parallel charging."]
	quest.1642C50313F491BA.quest_subtitle: "ExtendedAE"
	quest.165D83DA8A47584E.quest_desc: ["Control circuits are used to craft several Mekanism items and machines. Tier 8."]
	quest.169D553ED480C513.quest_desc: ["Storage Components are the core of all AE2 cells, determining the capacity of the cells. Each tier increases the capacity by 4x and costs 3 of the previous tier."]
	quest.16A0E92787B231F4.quest_desc: ["Long day? Try a nice bath to relieve your stress!"]
	quest.16BD3B7720BB6FC5.quest_desc: ["Klein Star Vier holds up to 3,200,000 EMC and is also used in the crafting of the Klein Star Sphere."]
	quest.16F2FE28C9730B3C.quest_desc: ["手持链接工具左击末影抽屉即可复制抽屉频率，接下来右击（译者注：经测试为潜行右击）其他末影抽屉即可将两个抽屉同步。"]
	quest.16F347B287BA5A57.quest_desc: [
		"A device to recombine Alchemical Sulfur, Salt, and Mercury into items."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.1714FDAD185BC9EC.quest_desc: ["Build a base on each planet. You should be able to breathe without a space suit."]
	quest.172A4BF34F6B369D.quest_desc: ["A full set of infinity armor will grant you creative flight and invincibility - even from a /kill command."]
	quest.172D9D871C55C62F.quest_desc: ["A way to tick accelerate blocks, Time-in-a-Bottle style. The longer it is kept in your inventory, the more time you can save! Click a block multiple times to speed it up even faster!"]
	quest.172D9D871C55C62F.quest_subtitle: "Gadgets Against Grind"
	quest.175ABA1A1E81745D.quest_desc: ["Energy storage item that holds and transfers RF"]
	quest.177B785A9ECE8F52.quest_desc: ["Allows the alchemist to use the power of the Transmutation Table without having to place it down on a surface."]
	quest.178C361C75E72C69.quest_desc: ["Storage Components are the core of all AE2 cells, determining the capacity of the cells. Each tier increases the capacity by 4x and costs 3 of the previous tier."]
	quest.17B3F0BE4B8E85AA.quest_desc: ["Klein Star Drei holds up to 800,000 EMC and is also used in the crafting of Klein Star Vier. "]
	quest.17BA6849B6B75EE5.quest_desc: ["Drops from Sludge (blue slime-like creatures)."]
	quest.17C31E1EEEC41B2E.quest_desc: ["Crafting ingredient for hammers - 5x5x5"]
	quest.17D11E1D85B0544A.quest_desc: ["Enables you to automate complex crafting recipes. Putting an inventory on top will allow it to automatically pull items into the crafting table."]
	quest.17E258709C662348.quest_desc: ["Red Matter is a component added by ProjectE. As an item with a high EMC value, it is suitable to be used as a template in an Energy Condenser to store EMC. As a crafting component, Red Matter is used in the crafting of high-end machines, tools, armor and accessories."]
	quest.18172E2A9B99A66D.quest_desc: [
		"A device to extract Alchemical Sulfur from items using a Solvent."
		""
		"Place the cauldron on top of the braizer. Fill the braizer with blaze rods to heat the cauldron!"
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.1830BED4361BCD12.quest_desc: ["Ironwood Ingot is an item that can be obtained from smelting Raw Ironwood."]
	quest.18353B88A8A3CB0B.quest_desc: ["Injectors must be correct tier for crafting, see JEI. Power is required for fusion crafting. Injectors are upgradable to next tier."]
	quest.185C4CC2B44FE1B1.quest_desc: ["Use the basic enchanting infuser to choose which enchantments to put on your gear."]
	quest.18603E2137F4A2BE.quest_desc: ["Infinite-capacity storage block that provides and stores unlimited amounts of any gas."]
	quest.18B4F54EE5BDD901.quest_desc: [
		"Higher Capacity cable, can carry 32 channels unlike standard cable which can only carry 8, however it doesn't support buses so you must first step down from dense to a smaller cable (such as Fluix ME Glass Cable or Fluix ME Smart Cable) before using buses or panels."
		""
		"Dense cables slightly override the \"shortest path\" behavior of channels, channels will take the shortest path to a dense cable, and then the shortest path through that dense cable to a controller."
	]
	quest.191D4B8350A5B75C.quest_desc: ["x8 faster than the standard Export Bus – high-throughput for items."]
	quest.191D4B8350A5B75C.quest_subtitle: "ExtendedAE"
	quest.1931453DB6A06D5B.quest_desc: [
		"Crafters are machines added by RFTools that will automatically craft items given a recipe, the necessary components and RF power. Multi-step crafting can be done in a single machine, limited only by the number of recipe slots."
		""
		"Crafter Tier 2 can remember 4 recipes."
	]
	quest.1953C0F0AE829809.quest_desc: [
		"Converts mercery from its crystal form into its flux form."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.19645F031C69B3EB.quest_desc: ["Prosperity Shards are used to craft many of the core items in the mod, including Resource Seeds, Essence Tools and Essence Armor."]
	quest.19653FCE91F4A285.quest_desc: [
		"A device to extract Alchemical Mercury from items."
		""
		"Place the distiller on top of the braizer. Fill the braizer with blaze rods to heat the distiller!"
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.197DA8087ED0110A.quest_desc: ["二阶升级，鼠标指针悬停在物品上以查看详细信息，能够合成钻石升级。"]
	quest.19F535AFD9F48A8A.quest_desc: [
		"To create Awakened Supremium, you will need to collect rare material called Cognizant Dust. This is done by killing either a Wither or the Ender Dragon using an Essence Weapon that is enchanted with Mystical Enlightenment."
		""
		"You will also need to build a special Altar. You will need an Awakening Altar, Awakening Pedestals and Essence Vessels. Placing the Altar in the world will show you where to place the Pedestals and Essence Vessels."
	]
	quest.1A0DA69E34F2D7E8.quest_desc: ["用于将空印刷电路版曝露在紫外线下，形成可用成品的机器。"]
	quest.1A1B057049B2AB58.quest_desc: ["The crafting core is used to craft several end-game items. See all uses in JEI."]
	quest.1A1B057049B2AB58.quest_subtitle: "Extended Crafting"
	quest.1A378D0D3AA38021.quest_desc: ["A unique crafting method of Powah, uses items and energy to craft recipes"]
	quest.1A40E97E9775C979.quest_desc: ["An upgraded space suit with the added power of jet-propelled flight!"]
	quest.1A40E97E9775C979.title: "Jet Suit"
	quest.1A518FF85B798517.quest_desc: [
		"Aura and its presence in the world has been a conundrum to researchers for a long time now. Back in the day, they used to use Bottles to collect aura and to be able to analyze it in greater detail as it becomes visible to the naked eye that way. Soon after, complaints from uninformed civilians started troubling them: \"Other scientists already have a use for bottles, this will cause issues\", they said."
		""
		"As such, and to shut out all the incoherent blabber, they created the Bottle and Cork: A similar, yet slightly different utensil to the bottle that can be used exclusively to collect aura by simply interacting with the air while holding it."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.1AB8244D9A52E7F4.quest_desc: ["Crafted using the energizing orb. Used in crafting recipes for hardened tier Powah items."]
	quest.1AE2DA480EB23947.quest_desc: ["用于制造塑料，详情查阅JEI和手册。"]
	quest.1AE506C74AF7D407.quest_desc: ["The best draconic scientists have figured out a way to duplicate chaos shards. Breaking down a chaos shard into its tiniest fragments will allow you to transform it into something that can be refined to create large chaos fragments."]
	quest.1B146007CA8A3052.quest_desc: [
		"There is only one type of rocket in Stellaris; you can improve your rocket using various upgrades."
		""
		"Make sure you only take off in your rocket from the overworld (the dimension where you started the pack) or the planets! Otherwise, messy things can happen!"
	]
	quest.1B17A64C7D6C88F7.quest_desc: ["Transmit power wirelessly to charge items in your inventory!"]
	quest.1B1E9AFA7D0B0970.quest_desc: ["将升级安装到镕铸炉中，获得更快的速度，或关闭合金功能！"]
	quest.1B1E9AFA7D0B0970.title: "升级"
	quest.1B20650DA11BD5F6.quest_desc: ["Max Blocks: 128"]
	quest.1B4A6ACF29C9DD46.quest_desc: ["The Combiner allows the player to create an ore block from 8 dust. Place the ore dust in the top slot, and some cobblestone in the bottom slot, and it will combine to make the ore block. It requires 1000 power per operation. Works with the dust of copper, iron, tin, osmium, obsidian (only needs 4) and gold. Also allows 1 Flint to a gravel block and 16 Redstone/Lapis to their ores."]
	quest.1B5C8B86CFDBB051.quest_desc: [
		"完成任务所需的物品需要放在物品栏才能被检测到。一定要将任务物品放进物品栏，等待FTB Quest检测 -> 任务未完成 = 没有奖励！"
		""
		"任务奖励包含硬币，硬币可以在硬币商店中兑换奖励袋！"
		""
		"在任务书中点击物品、在JEI中搜索都可以找到物品的配方，也可以将鼠标指针指向物品按\"r\"键来查看配方。同样，按\"u\"键可以查看物品的用途。"
		""
		"你可以通过\"蹲起\"让树和作物生长（多次按下潜行键——记得关闭粘滞键），你还可以连锁破坏方块（用到了FTB Ultimine模组，默认按键是反引号键\"`\"）。"
		""
		"要获取更多生命值，试试吃下各种各样的食物！（吃下十种独特食物后你将获得第一颗额外生命）"
		""
		"你没必要在完成一个章节的所有任务后再开始下一章，但有些任务只有在前置任务完成后才能解锁。"
	]
	quest.1B5C8B86CFDBB051.quest_subtitle: "重要信息！"
	quest.1B6FEBB8D9440617.quest_desc: ["能够粉碎成尘土，在筛子中使用可以获取资源！"]
	quest.1B940854A058386C.quest_desc: ["Converts organic materials into biomass fuel"]
	quest.1BAB46320F75A91B.quest_desc: [
		"When starting out as a magical botanist, it proves beneficial to use the powers of nature on a more direct level before delving directly into aura itself. The Ritual of the Forest uses properties of Gold Powder to incorporate the power of natural ingredients directly into a fresh, growing tree, devouring it in the process, but at the same time, transforming it into useful tools and items."
		""
		"To construct this ritual, one has to place Gold Powder in the configuration shown in the guidebook, with some Wooden Stands around that which will hold the ingredients. Then, the correct sapling must be placed in the middle, and, either through some kind of fertilizer, or through the inevitability of time, its growth will cause the ritual to start. Note that care needs to be taken as rituals require specific types of saplings."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.1BAB46320F75A91B.title: "Ritual of the Forest"
	quest.1BDB8EDBC8F52E9E.quest_desc: ["While bearing some similarity to Fluix ME Covered Cable in appearance, they provide diagnostic function by visualizing the channel usage on the cables, the channels appear as lit colored lines that run along the black stripe on the cables giving you an understanding of how your channels are being used on your network. For regular smart cables, the first four channels show as lines matching the color of the cable, the next four show as white lines. For dense smart cable, each stripe represents 4 channels."]
	quest.1BE5549EE1591D23.quest_desc: ["多方块结构组件，这些方块作为镕铸炉的主体，将会在熔铸过程中承受高温。"]
	quest.1C06B9727A06A7D8.quest_desc: [
		"Crafting CPUs are multiblocks, and must be solid rectangular prisms with no gaps. They are made out of several components."
		""
		"Each CPU must contain at least 1 crafting storage block (and the minimum viable CPU is in fact just a single 1k crafting storage)."
		""
		"Crafting storages are available in all the standard cell sizes (1k, 4k, 16k, 64k, 256k). They store the ingredients and intermediate ingredients involved in a craft, so larger or more storages are required for the CPU to handle crafting jobs with more ingredients."
	]
	quest.1C30D7DF9779DD9C.quest_desc: ["A machine that grinds items like ores into dusts, providing basic ore doubling."]
	quest.1C3512BA7B488C67.quest_desc: [
		"Note: Most machines in the Mekanism mod can be upgraded into factories."
		""
		"The Metallurgic Infuser is the first step in the Mekanism tech tree. The Metallurgic Infuser is a machine used in the production of Steel Ingots, Bronze Ingots, Enriched Alloy, and Obsidian Ingots."
	]
	quest.1C707A653F0D6D54.quest_desc: [
		"No restrictions, unlimited durability."
		""
		"Right-click a block with a wand → it becomes an Enlivened Block entity."
		""
		"Enlivened entities can be captured/duplicated by other mods , providing a renewable source of that block. Note: Does not work if the spawner does not copy NBT."
		""
		"Use a Mob Imprisonment Tool on your new entity and duplicate in the Industrial Foregoing Mob Duplicator."
	]
	quest.1CFE1ABB42819D7E.quest_desc: ["怪物风扇可以将生物推向各个方向（甚至包括垂直方向）。它拥有三种增强效果的升级可供选择——宽度、高度和距离升级。"]
	quest.1CFE1ABB42819D7E.quest_subtitle: "Mob Grinding Utils"
	quest.1D0B7AA898DB7CD4.quest_desc: ["（缓慢）生成无限熔岩！需要放入流体抽屉。"]
	quest.1D1E009C95C47AC9.quest_desc: ["Crafting material needed to make Packaged Auto machines."]
	quest.1D33C862778D1437.quest_desc: ["All items, fluids, or energy piped into here will be voided."]
	quest.1D48817AB6A06772.quest_desc: [
		"There are six tiers of seeds in Mystical Agricuture."
		""
		"Tier 6 seeds require insanium essence to craft and a corresponding crux in order to grow."
	]
	quest.1D96A6DC181BE5ED.quest_desc: ["Crafting component and energy storage item used to build and upgrade generators, energy cells, and other power-related devices."]
	quest.1DA6EB3AB3035A0F.quest_desc: ["An endgame material created by infusing Draconium with Energy and other items."]
	quest.1DC74FAB7A521DB0.quest_desc: ["A drop from defeating the Warden."]
	quest.1E0F3E9A7AE4D2F5.quest_desc: ["全自动电路板制作。"]
	quest.1E0F3E9A7AE4D2F5.title: "气动装配"
	quest.1E6EE65389C1E9D7.quest_desc: ["A powerful material refined from Draconium Dust, used to craft advanced energy systems, tools, and high-tier technology."]
	quest.1EC14A5DEA09E671.quest_desc: ["Made of 10,000 emeralds"]
	quest.1EE7658030431E1A.quest_desc: [
		"The manual will guide you through how to complete this quest line."
		""
		"Powah is a tech mod that adds various ways to generate, store, and transmit... you guessed it... power!"
		""
		"Mod Features:"
		"- Energy Storage (Energy Cell, Ender Network)"
		"- Ender Network (Ender Cell, Ender, Gate)"
		"- Generators (Furnator, Magmatic Generator, Thermoelectric Generator, Solar panel, Reactors)"
		"- Other Machines (Discharger, Energy Hopper, Player Transmitter)"
	]
	quest.1EE7658030431E1A.quest_subtitle: "Powah"
	quest.1F40FE21EC2AEF22.quest_desc: ["一把能造成4点伤害的剑。"]
	quest.1F40FE21EC2AEF22.quest_subtitle: "Minecraft"
	quest.1F894A409738DBF4.quest_desc: ["This machines is needed to craft more advanced items and machines, such as more complex machine frames."]
	quest.1F901B2CE53B3F58.quest_desc: [
		"Ingot of the Skies is a powerful metal infused with divine energy. Offer the gods a spirit of calling along with either an infused iron infot or a tainted gold ingot."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.1FCBF2B893EEA7D9.quest_desc: ["Control circuits are used to craft several Mekanism items and machines. Tier 6."]
	quest.1FCF25002DEC80BA.quest_desc: ["Special apples that give different buffs! Hold shift while hovering over the apple to see its effects."]
	quest.1FD449A4EB2E1A06.quest_desc: ["The reaction chamber is a machine that uses a ton of power to provide very efficient ways of processing materials. It is used in the creation of various items needed to progress in AdvancedAE as well as offering efficient recipes for other mods."]
	quest.1FD449A4EB2E1A06.quest_subtitle: "Advanced AE"
	quest.202A8B47E8AE3376.quest_desc: ["LaserIO seeks to replicate the mechanics of EnderIO - allowing you to interact with items, fluids, energy, and redstone -- all from the same block face! Furthermore, 9 separate configurations can be placed per block face, leading to nearly limitless potential for logistics around transportation of resources. "]
	quest.202A8B47E8AE3376.quest_subtitle: "Laser IO"
	quest.202C97EC62E3FD47.quest_desc: ["潜行右击空气即可切换模式，右击抽屉开关对应选项。"]
	quest.20AA10B19EA9E15F.quest_desc: [
		"At some point, one realizes that a Furnace is just too slow and consuming of resources to use efficiently. The Extraneous Firestarter speeds up a Furnace tthat it is placed on any side of, along with giving it the necessary heat to smelt any sort of material. Note that, while consuming the required aura for this, the natural levels might drop into the negatives, causing diminishing returns."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.20E32463368357B4.quest_desc: ["四阶升级，鼠标指针悬停在物品上以查看详细信息，能够合成最大存储升级。"]
	quest.210491F044A5BC31.quest_desc: ["No more torches needed to light up your interiors!"]
	quest.210F3A7CABB85DC8.quest_desc: ["Right click to instantly harvest leaves, wool, and mushrooms (from mooshrooms). The charge level (V, shift+V) controls the area sheared based on charge."]
	quest.21460544B92AF9B4.quest_desc: ["Infuses blaze rods to make them provide more power for longer"]
	quest.216A0851EAD69DCF.quest_desc: [
		"Take to the skies! Used to craft a wooden jetpack."
		""
		"Jetpacks make use of Forge Energy to allow the player to fly. Higher tier Jetpacks can have greater speed and energy capacity."
		""
		"Jetpacks require Forge Energy to function. They can be charged using a charging block from any mod that supports Forge Energy."
		""
		"The Jetpack engine can be toggled on and off using a keybinding (default V). When the engine is on you can press the Space Bar to fly."
		""
		"Every Jetpack has a Hover Mode, which allows for more precise movements. Enabling this mode (default keybinding H) will cause your Jetpack to hover in place with varying levels of descent. While hovering your Jetpack will consume power."
		""
		"You can change the speed of your Jetpack using Throttle Controls. This is done using the Throttle Control keybindings (default , and .)."
		""
		"Jetpacks can be equipped as an Accessory in the Body slot."
		""
		"Note: If the player wears a Jetpack in both the Accessory slot and the Chestplate slot, the Jetpack in the Chestplate slot will take priority."
	]
	quest.216A0851EAD69DCF.quest_subtitle: "Iron Jetpacks"
	quest.219B7ED265976105.quest_desc: ["Mine nether quartz ore in the nether to obtain."]
	quest.21C27FA410438560.quest_desc: ["Catalysts are used in complex crafting recipes. They get harder to craft as they move higher in tiers."]
	quest.21D2F298B32D5B95.quest_desc: [
		"Chisel adds a huge variety of decorative blocks to the game. The mod is very useful for people who like the construction aspect of Minecraft. "
		""
		"Access to new blocks is provided mostly through one tool, the chisel."
		""
		"Right clicking opens the chiseling interface."
	]
	quest.21D2F298B32D5B95.quest_subtitle: "Chisel Modern"
	quest.21D5CF2BC04467D4.quest_desc: [
		"The water separator transforms water into Oxygen and Hydrogen."
		""
		"The machine works by putting water in the second slot. It will then generate Hydrogen and Oxygen that you can gather by placing buckets under the tanks."
	]
	quest.21ECEC8F3D1691F1.quest_desc: ["The Infusion Crystal is an item used for crafting higher tier essences. There is a regular Infusion Crystal as well as an upgraded Master Infusion Crystal. The main difference between them is the amount of uses each crystal has."]
	quest.21FD5B61FBBCA913.quest_desc: [
		"&2Tick acceleration in the midgame! Other options later in progression include the temporal pouch and torcherino.&r"
		""
		"Industrial Foregoing: Souls uses souls extracted from Wardens to accelerate your machines. To do it you need to extract souls from a Warden using a Soul Laser Base with a Blue Lens. As always the Stasis Chamber will be your friend."
		""
		"Once you have some souls stored, now you need to place a Soul Surge pointing at the block you want to accelerate and connect it using Soul Pipes to the Soul Laser Base. You can stop the Soul Surge from working by applying a redstone signal to it."
		""
		"Each soul lasts for 15 seconds and makes the machine 4 times faster."
	]
	quest.21FD5B61FBBCA913.quest_subtitle: "Industrial Foregoing Souls"
	quest.2201A958694C7F35.quest_desc: ["Cables (and connectors) can have four different colors (and a base version). These are used to be able to distinguish multiple distinct networks adjacent to each others (to prevent the cables from connecting). A controller will adapt its color to the first colored cable it can find around it and then remember that (unless that color is totally removed)."]
	quest.220E723BF056F6D6.quest_desc: ["Components are used to craft catalysts. They get harder to craft as they move higher in tiers."]
	quest.2226EAAF3B304A2D.quest_desc: [
		"要给你的竹蜻蜓帽充能的话，可以在JEI查找Charging Gadgets模组中的\"充能站\"。"
		""
		"Propeller Hats模组添加了多种等级的竹蜻蜓帽，供你四处飞行。竹蜻蜓帽由FE驱动，所以你需要某种充电器来为其充电。"
	]
	quest.2230558554C39B34.quest_desc: ["Made of 10,000 tin ingots"]
	quest.22350912A0D709A2.quest_desc: [
		"Growth Accelerators are used to increase the growth rate of the plant planted above them. They can be stacked below each other to provide additional growth speed."
		""
		"Each tier has an increased range, but provide the same amount of growth. Placing the maximum amount of each tier will be just as efficient as using only the max tier. Note that the range is relative to 1 block below the crop."
		""
		"Place them underneath the block your plant is planted on. In the case of crops, that would be underneath the farmland block. Stack additional Growth Accelerators below it for more plant growth speed."
	]
	quest.22350912A0D709A2.title: "Growth Accelerators"
	quest.224198469D23B8E6.quest_desc: ["Tier 1. The only armor pieces in Draconic Evolution for 1.21.1 are the chestplates. Modules are needed to make it function, see JEI."]
	quest.22576BE5F4FD9868.quest_desc: ["Use the digital miner at least once in every dimension."]
	quest.2283BAFB726F6AF7.quest_desc: ["Enables you to automate complex crafting recipes. Putting an inventory on top will allow it to automatically pull items into the crafter."]
	quest.228FC9A995457D3C.quest_desc: ["This block generator has a speed of 32"]
	quest.22B16AE1B2684DCB.quest_desc: [
		"&2For tick acceleration earlier in the game, look up the temporal pouch in JEI!&r"
		""
		"This is a small, simple mod that adds various torches that can be used to increase the tick rates of tile entities. In other words: they make machines run faster, crops grow faster, etc..."
		""
		"Place the torch on the ground and right-click to access the GUI."
	]
	quest.22CEF75979B60798.quest_desc: [
		"The Cooking Pot is a workstation where you can both prepare and store a large amount of meals. When placed above any suitable heat source (campfire, open flames, lava, a stove etc.), it will start bubbling, indicating it's ready to cook."
		""
		"The Skillet is a weapon and a portable food-cooking station, which can be operated by hand or as a block. Skillets can process any campfire cooking recipe, taking roughly 20% of the original time to cook each item."
		""
		"The Cutting Board is a workstation where players can break down one item into many outputs, by using a valid tool on it."
	]
	quest.22D54134581E5904.quest_desc: ["Everyone knows that snad is better than sand and dirt. Try growing sugarcane on a block of snad."]
	quest.22ED4DB8D9CF0A86.quest_desc: ["Upgrades for Ex Machinis machines. Hold shift while hovering over the upgrade to see its effects."]
	quest.232205BA1A02FFF0.quest_desc: ["The Dark Matter is an component added by ProjectE. It is used to craft Dark Matter tools and armors and is used as a component to create Red Matter."]
	quest.234B200716CEE3F1.quest_desc: ["A Wind Turbine's giant blades harness the force of the wind to generate power. Each Wind Turbine requires a small 1x5x1 area (horizontally one block). The machine will generate the same power day and night, in sun or rain, but the turbine must have a clear view of the sky (over the rotor housing at the top of the tower). The power output increases linearly with its elevation."]
	quest.23553993065249FB.quest_desc: ["A special item that allows you to choose your luck value when opening Chance Cubes."]
	quest.23839A415A10A611.quest_desc: [
		"The Reinforced variant lets you build Reactors bigger and better than ever, to generate and store extreme amounts of energy!"
		""
		"See the book for details and how to set up."
	]
	quest.23839A415A10A611.title: "Reinforced Reactor Components"
	quest.239C026A9B572140.quest_desc: ["A refined ender-based material used in crafting advanced components and late-game machinery."]
	quest.23F0F9483CB3167B.quest_desc: [
		"The Lamp of Sanctuary, while being a great decorational piece, also has another very useful function: When supplied with a redstone signal, it will cause any monsters in an area of up to about 48 blocks around it to stop appearing altogether, no matter the light level. For this, the strength of the redstone signal determines the range. Every time a monster is ceased, a small amount of is used."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.2475C81B8ABC19BE.quest_desc: ["Build an applied energistics system in another dimension where you have a secure base."]
	quest.24C4A019D07A1F8B.quest_desc: ["Defeat the dragon! Remember, the dragon can be resummoned with 4 end crystals."]
	quest.24C4A019D07A1F8B.quest_subtitle: "Minecraft"
	quest.24C6C85F207E7409.quest_desc: ["The Purification Chamber uses oxygen to refine Ores and shards into clumps. Each ore makes 3 clumps, whereas each shard only gives one clump."]
	quest.24C964CEB5B34A22.quest_desc: ["Productive Metalworks模组为我的世界带来了强大的沉浸式冶炼与铸造系统，玩家能够以更真实高效的方式处理矿石，铸造矿锭。在本模组中，你可以建造名为镕铸炉的多方块结构，在这座大型工业熔炉中一次性处理大量矿石。"]
	quest.24C964CEB5B34A22.quest_subtitle: "Productive Metalworks"
	quest.24D65F6FA7D60C0D.quest_desc: ["The Master Infusion Crystal has the added benefit of being able to combine entire blocks of essence, which can be helpful when combining large amounts of essence. Infinite durability!"]
	quest.250D50E877136CE2.quest_desc: ["Used to store large amounts of energy."]
	quest.250D50E877136CE2.title: "Energizer Components"
	quest.2516E592916EFBEB.quest_desc: ["Upgraded essences are crafted using the previous tier of essence and an infusion crystal. Used to create Tier 5 seeds. (Crystals are required in expert mode)"]
	quest.251E78ED5A7DF9BF.quest_desc: ["Energy cubes can be used to hold large amounts of RF. The higher the tier, the more RF can be stored. Tier 4!"]
	quest.2530A93E24EE02E2.quest_desc: ["Creative flight at no additional cost!"]
	quest.253B925F5877067D.quest_desc: ["用筛子筛沙砾可以得到矿物碎块。"]
	quest.25771C0683859846.quest_desc: ["Fully automate a wither farm to mass produce nether stars."]
	quest.2591C17114EF1CFC.quest_desc: ["An excellent way of duplicating ultimate singularities"]
	quest.2595D390AED8C101.quest_desc: ["钻石箱子由金箱子升级而来。"]
	quest.25B907E3FDFC236C.quest_desc: [
		"The Tinkering Table is used to add/remove Augments to your essence gear. The types of tool/armor that an Augment can be applied to are listed in the tooltip of the Augment."
		""
		"Each augment has a tier. This tier is the minimum tier of gear that the Augment can be applied to. You can apply lower tier Augments to higher tier gear."
		""
		"Each piece of gear can only have a certain amount of Augment slots. Most items only have a single Augment slot, but Awakened Supremium gear pieces have 2!"
	]
	quest.25D8343DDA1A1E7E.quest_desc: [
		"A worktable for transmuting items to pure EMC and back to items of the alchemist's choosing. Transforming an item to pure EMC in this way imprints the identity of the item onto the soul of the alchemist."
		""
		"Anything known to the alchemist in this way can be pulled from any Transmutation Table or Transmutation Tablet by them as long as they have sufficient EMC. The Transmutation Table or Transmutation Tablet reveals to the alchemist the amount of EMC bound to them."
	]
	quest.25DC4BBF99C776D8.quest_desc: ["Used to turn solids into liquids."]
	quest.25DC4BBF99C776D8.title: "Fluidizer Components"
	quest.2613272C3850463D.quest_desc: ["Uses solar power (sun) to generate RF. Tier 4!"]
	quest.262DAA98C18CE427.quest_desc: [
		"Cells can be made with a storage component and a housing or with the housing recipe around a storage component."
		""
		"Item storage cells can hold up to 63 distinct types of items, and are available in all the standard capacities."
		""
		"Fluid storage cells can hold up to 5 distinct types of fluids, and are available in all the standard capacities."
	]
	quest.262DAA98C18CE427.title: "Cell Housing"
	quest.26466151D40A9B4A.quest_desc: [
		"Players can't eat if they are in planets/moons without oxygen. To solve this problem, you need to use the vacumator to put food into a can."
		""
		"The Vacuumator allow you to put food inside Cans that you can eat in space."
		""
		"For this machine to work you need to put a can in the first slot, food in the second, and an empty glass bottle in the third. The machine will give you a can with food inside and a water bottle."
		""
		"You get hungrier in space - so bring lots of food!"
	]
	quest.26587BB45FC82006.quest_desc: ["Uses solar power (sun) to generate RF. Tier 5!"]
	quest.267A446CB02207F1.quest_desc: ["Max speed for pipes in the Pipez mod!"]
	quest.267A446CB02207F1.quest_subtitle: "Pipez"
	quest.269CB18DF9B7D5E3.quest_desc: ["A generator from blaze rods"]
	quest.271164995133F430.quest_desc: ["Made of 10,000 coal"]
	quest.2736FF4556236824.quest_desc: [
		"Using the power of Red Matter to combine the functions of the Red Matter Shears, Red Matter Axe, Red Matter Sword, and Red Matter Hoe into a single tool."
		""
		"The sword function provides the most powerful melee strike of any weapon yet discovered by alchemists."
		""
		"The axe function when charged turn a whole tree into stripped logs in one action (right click) and activate again to mine the whole tree (limited for very large trees). It also makes quick work of chopping trees."
		""
		"The hoe function will till a large area when fully charged in a single pass (right click)."
		""
		"The shears will harvest a large number of leaves or wool from many adjacent sheep."
	]
	quest.27453FAA4CD8BB2C.quest_desc: ["Made up of 387420489 cobblestone!"]
	quest.279D5C185DE6FBF4.quest_desc: ["将矿物碎块合成矿石（2x2）。"]
	quest.27A3D6364800040A.quest_desc: ["Outdoor cooking - with style!"]
	quest.27A8BB58004C1DB9.quest_desc: ["Any item placed into its inventory will be converted into EMC. It transfers energy from Energy Collectors to Energy Condensers. When transferring, it gives a 3 EMC per second bonus. It is also used to charge the Klein Star series with EMC. "]
	quest.27C9EAA07B64CDD3.quest_desc: [
		"The import bus pulls items and fluids (and whatever else, given addons) from the inventory it's touching and pushes them into network storage."
		""
		"For purposes of lag reduction, if the import bus has not imported something recently, it goes into a sort of \"sleep mode\" where it operates slowly, and wakes up and accelerates to full speed (4 operations per second) when it successfully imports something."
		""
		"They are cable subparts."
	]
	quest.27D559AF2FF8AB16.quest_desc: ["Open one stack of chance cubes (any before this does not count)."]
	quest.284AD374B7EC81DF.quest_desc: ["Even with the dark matter armor, you can still take a noticeable amount of damage when things start getting hairy. You decide to try throwing some red matter at the problem like any good alchemist, and find that this new Red Matter Armor blocks so much incoming damage you can't even feel anything apart from the actual kinetic energy pushing you around. But... Maybe you can go even one step further?"]
	quest.288D1A8284EA6444.quest_desc: ["在鸡上使用可以制造一个金鸡蛋。在5x5的泥土中央使用以创造一片祈福之土（光照充足时生成友好生物）。"]
	quest.28AADA8236CEE862.quest_desc: [
		"用来制作需要蓝图的物品。"
		""
		"工程师装配台制作出来的物品通常用于其他的合成配方。一个典型的例子是电灯笼，其能够阻止敌对生物在一定范围内生成。"
	]
	quest.28B2DF42316767BD.quest_desc: ["Sinks can hold water!"]
	quest.28E3C30852CAB186.quest_desc: ["装在奇异储罐上，右击它就可以享受经验浴了！"]
	quest.293B776662114118.quest_desc: ["Right click to turn wood into stripped logs and right click again to harvest instantly."]
	quest.29454E312AFB3287.quest_desc: ["Craft, assemble, start, and successfully maintain a Draconic Reactor (no boom allowed)."]
	quest.2968D69970CDA8DE.quest_desc: ["Hold shift key when hovering over the items to see stats."]
	quest.2968D69970CDA8DE.title: "Mk3"
	quest.29A24743F60E711A.quest_desc: ["Teleports players to a matter reciever."]
	quest.29E7B708749B9B42.quest_desc: ["Made of 10,000 copper ingots"]
	quest.2A3CAFB5D3427FB3.quest_desc: ["Made in an altar. Consumes ambrosium as fuel."]
	quest.2A6EFE02F0113946.quest_desc: [
		"要给你的竹蜻蜓帽充能的话，可以在JEI查找Charging Gadgets模组中的\"充能站\"。"
		""
		"Propeller Hats模组添加了多种等级的竹蜻蜓帽，供你四处飞行。竹蜻蜓帽由FE驱动，所以你需要某种充电器来为其充电。"
	]
	quest.2ABCE226A3B4F4EE.quest_desc: ["All energy piped into here will be voided."]
	quest.2AD25DE5F43D3B4A.quest_desc: ["Plant on grass to grow a cow. Make sure to give it plenty of breathing room to grow."]
	quest.2AEE4D88A489DA16.quest_desc: ["A teleportation item that allows players to set and instantly travel to saved locations"]
	quest.2B72356DFAAC12A5.quest_desc: ["一把能造成5点伤害的剑。"]
	quest.2BBE7E9D9A8772BE.quest_desc: ["This first build converts items into EMC one at a time. When enough EMC amasses, the target item is created and placed in the chest. It seems to hungrily pull EMC from Energy Collectors and Anti Matter Relays around itself to use in the creation of items."]
	quest.2BF9F779FD75AA4C.quest_desc: ["Craft into various items from the mobs' home dimension."]
	quest.2BF9F779FD75AA4C.title: "Generalized Predictions"
	quest.2C08FD536602B1BD.quest_desc: ["Crafting component for Powah items."]
	quest.2C1A380EBB6AF17C.quest_desc: ["Made of 10,000 glowstone dust"]
	quest.2C50B9ACE82D517F.quest_desc: [
		"要获得更多永久生命值，可以尝试吃各种不同的食物！用这本书跟踪进度。在达成以下里程碑（食用不同种类的食物）后，每次将额外获得一颗心：10种、15种、20种、25种、30种。"
		""
		"使用此方法最多可获得5颗额外的心，其他物品可以突破此上限获得更多生命值。"
	]
	quest.2C50B9ACE82D517F.quest_subtitle: "Spice of Life"
	quest.2C52AF4EB1C85864.quest_desc: ["Uses solar power (sun) to generate RF. Tier 2!"]
	quest.2C7CB05FD8889BD4.quest_desc: ["Turns lava and lava+redstone into RF."]
	quest.2C8B647BDD0F481A.quest_desc: [
		"&2默认情况下，整合包处于普通模式。&r"
		""
		"你可以把普通模式当成Titan模式，专家模式当成Kappa模式。"
		""
		"并没有简单模式，抱歉咯！"
		""
		"\"&b/packmode normal&r\" = 普通模式 = 比通常的模组整合更困难的合成配方。"
		""
		"\"&b/packmode expert&r\" = 专家模式 = 比普通模式更加困难的合成配方，做好受苦的准备！"
		""
		"\"&b/packmode current&r\" = 查看整合包当前所处的模式。"
		""
		"运行以上指令需要开启作弊或拥有服务器的OP权限。在服务器运行指令时，会改变所有人的模式。"
		""
		"你也可以先在kubejs/config/common.json文件中修改难度，再开始游戏。在json文件中，你的packmode必须为&b\"normal\"&r或&b\"expert\"&r——请确保所有字母均为小写并带有引号。"
		""
		"&4在非普通模式游玩时，每次整合包更新后，都需要重新运行指令或修改config文件来调整难度！&r"
		""
		"请注意，任务书仅适配普通模式，在其他模式下游玩时，要做好在各个章节任务间反复横跳的准备！"
		""
		"你也可以执行指令\"&b/packmode help&r\"来查看关于整合包模式的更多细节。"
	]
	quest.2C8B647BDD0F481A.quest_subtitle: "两害相权！"
	quest.2CD7E699CEEE73F8.quest_desc: [
		"Store RF, like a battery!"
		""
		"It is a shapeless multiblock; putting a Advanced Capacitor Bank next to another Advanced Capacitor Bank will combine their energy storage."
	]
	quest.2CE245F9F36F4E39.quest_desc: ["Cloggrum is one of the most common ores in the Undergarden."]
	quest.2CEDF16DFC5B7FDC.quest_desc: [
		"每个背包都能安装一定数量的插件，或者说升级。合成相应的升级，并将其放入背包左侧的槽位即可生效。"
		""
		"有许多升级供你选择，大部分升级还能升级成高级版，将效率更进一步。"
	]
	quest.2D205E67DE382A31.quest_desc: ["能够销毁多余物品的升级，用来防止物品溢出引起的系统卡顿。"]
	quest.2D2B0DB13122E2EA.quest_desc: [
		"将树苗、树叶、木屑（用锤破坏原木）或其他有机物放进木桶，就可以制造出泥土。"
		""
		"你也可以用水和巫水制作刷土机——就像用熔岩和水制作刷石机一样！"
	]
	quest.2D2E4CE0DE0E015F.quest_desc: ["Power from biofuel (plant matter in the crusher)."]
	quest.2D928501975CB165.quest_desc: ["Storage Components are the core of all AE2 cells, determining the capacity of the cells. Each tier increases the capacity by 4x and costs 3 of the previous tier."]
	quest.2DA429EE9D3EEA9B.quest_desc: ["金箱子由铁箱子升级而来。"]
	quest.2DB858A32BBA002A.quest_desc: ["Storage Components are the core of all AE2 cells, determining the capacity of the cells. Each tier increases the capacity by 4x and costs 3 of the previous tier."]
	quest.2DE3DFDBE3595E41.quest_desc: ["Essence Armor pieces are higher tier armor that can be upgraded using Augments."]
	quest.2DF07E22F5A8CE7C.quest_desc: ["The Copy Paste Gadget allows you to select a large radius to copy and paste in a different location."]
	quest.2DFA2205857FBA8E.quest_desc: ["Made of 10,000 redstone dust"]
	quest.2E28C0C1F81CD03B.quest_desc: [
		"As any magical botanist knows, causing negative aura imbalance effects can be quite dangerous, especially when using a device that consumes aura passively. For cases like this, the Aura Imbalance Ward provides protection against any dangers: placing it next to a device that uses aura causes the device to cease operation while the aura levels around it are too low. This comes at no cost in return."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.2E2E82D5376E9D91.quest_desc: ["These crafting tables are used for more complex crafting recipes. Automated versions are also avaliable. See JEI for more details."]
	quest.2E6127F7A54D6A58.quest_desc: [
		"Make the Twilight Forest portal by tossing a Twilight Diamond into a 2x2 pool of water surrounded by flowers. Jump in to enter the forest."
		""
		"Twilight Forest is a dimension exploration mod focused on adventure that will take you on a journey to meet strange creatures, exploring dungeons, and much more."
	]
	quest.2E6127F7A54D6A58.quest_subtitle: "Twilight Forest"
	quest.2E6127F7A54D6A58.title: "Into the Twilight Forest"
	quest.2E7DBB11688E2421.quest_desc: ["Patterns are made in a ME Pattern Encoding Terminal out of blank patterns, and inserted in ME Pattern Providers or Molecular Assemblers."]
	quest.2EB673C98F2891DA.quest_desc: ["Using a simple cooking system and a few familiar ingredients, Farmer's Delight lets you be able to prepare a wide variety of hearty meals: from sandwiches to salads and stews, from beautiful desserts to mouth-watering feasts, no ingredient will be left behind in your kitchen!"]
	quest.2EC749B4571A7EB9.quest_desc: ["The Basic Magnet picks up Items and Experience within a 5 block range of the player!"]
	quest.2ECDC7B514932E1C.quest_desc: ["A high-tier crafting component infused with ender energy."]
	quest.2EDFF6BAB18DCBC8.quest_desc: ["Upgraded essences are crafted using the previous tier of essence and an infusion crystal. Used to create Tier 2 seeds. (Crystals are required in expert mode)"]
	quest.2F367F6748A0281C.quest_desc: ["A rare, high-tier alloy made from vanilla endgame materials."]
	quest.2F557E8BDF14E2EF.quest_desc: ["The Stirling Generator is used to generate power by burning Furnace fuels. Its power generation rate and fuel efficiency depend on the installed capacitor."]
	quest.2F557E8BDF14E2EF.quest_subtitle: "Ender IO"
	quest.2F5803138627E169.quest_desc: ["Enables you to automate complex crafting recipes. Putting an inventory on top will allow it to automatically pull items into the crafting table."]
	quest.2F5B723497046BFC.quest_desc: ["Get rid of those pesky phantoms! Can be placed in the charm slot."]
	quest.2F5DF89B8B8B3967.quest_desc: ["Klein Star Zwei holds up to 200,000 EMC and is also used in the crafting of Klein Star Drei. "]
	quest.2F60BEB4CAB4424A.quest_desc: ["该终端可以用来查看、放入、取出简易存储网络内的物品。"]
	quest.2F631C8EE15BA50F.quest_desc: ["自动打开怪物掉落的战利品箱！（提示：用漏斗或管道来自动化！）"]
	quest.2F631C8EE15BA50F.quest_subtitle: "FTB Quests"
	quest.2F7D243BFA0DE65C.quest_desc: [
		"桶也可以用来制造黏土、粘液块、下界岩、末地石、黑曜石等方块。查阅JEI获取更多信息。"
		""
		"将尘土放入装满水的桶中就可以制作出黏土方块。"
	]
	quest.2F8633A3B969A2E5.quest_desc: ["Used for fusion crafting. One core is needed, and then one injector per item required for crafting. Injectors must be correct tier for crafting, see JEI. Power is required for fusion crafting. Injectors are upgradable to next tier."]
	quest.2FEBA698BF4F7AF2.quest_desc: [
		"Ender IO machines that have an upgrade slot require capacitors to function."
		""
		"Depending on their Base Modifier, Capacitors can increase the Speed, Range or Energy Storage of machines."
		""
		"Level: 1"
	]
	quest.2FF30E29BD7550D5.quest_desc: ["Makes your rocket look like a tiny rocket!"]
	quest.2FF4F03F52C1D8F3.quest_desc: ["This upgrade changes the fuel needed by the rocket to hydrogen."]
	quest.30016E1C526393CB.quest_desc: ["Mobius Fuel is a fuel added by ProjectE. It burns sixteen times as long as regular coal and is able to smelt 128 items."]
	quest.305DDEB9CE993D3A.quest_desc: [
		"要给你的竹蜻蜓帽充能的话，可以在JEI查找Charging Gadgets模组中的\"充能站\"。"
		""
		"Propeller Hats模组添加了多种等级的竹蜻蜓帽，供你四处飞行。竹蜻蜓帽由FE驱动，所以你需要某种充电器来为其充电。"
	]
	quest.306E8065443E1FC6.quest_desc: ["在泥土上使用以创造诅咒之土（5x5区域）——诅咒之土上将生成敌对生物。"]
	quest.30CC71CAC95122E2.quest_desc: ["游戏前期，合金窑可以在没有电力的情况下制作合金，在JEI中可以查看该多方块结构的搭建方式。"]
	quest.30CC71CAC95122E2.quest_subtitle: "Immersive Engineering"
	quest.30CC71CAC95122E2.title: "合金窑"
	quest.30EC24CE1E708631.quest_desc: ["Tired of endless crafting? Take a break on your brand new sofa!"]
	quest.30EDDDAA38ED12D1.quest_desc: ["Slay a sheep and cook its meat to obtain mutton."]
	quest.30EDDDAA38ED12D1.quest_subtitle: "Minecraft"
	quest.30FBF029F03571A5.quest_desc: [
		"A practicing alchemist is always busy conducting new experiments. Having found the wooden chests provided by the powers that be unsuitable, you develop a new Alchemical Chest, capable of storing 104 stacks of items, compared to the double wooden chest's 72 stacks."
		""
		"Unencumbered by the limitations of this plane of existence the Alchemical Chest can still be accessed even when a solid block covers it. The Covalence Dust sprinkled on the lid also gives the chest weak magical power, allowing certain magical items to produce an effect when placed in the Chest."
		""
		"Black Hole Band - Sucks nearby items into the chest"
		"Gem of Eternal Density - Compresses materials in the chest into materials of higher EMC value"
		"Talisman of Repair - Repairs items inside the chest"
	]
	quest.30FE8FCBCDCAA608.quest_desc: ["Use the advanced enchanting infuser to additionally modify enchantments on already enchanted items. Also supports repairing an item using levels instead of materials. Costs are considerably lower compared to the basic infuser."]
	quest.312E0269110144C5.quest_desc: ["A full set of infinity armor will grant you creative flight and invincibility - even from a /kill command."]
	quest.313767A445CA2C9B.quest_desc: ["You can use Watering Cans to increase the speed of crop growth manually. Watering Cans are filled by right-clicking on a Water block. To use the Watering Can, just hold right click on some plants."]
	quest.313767A445CA2C9B.title: "Max Tier Watering Cans"
	quest.3199091CA87F1CD1.quest_desc: ["Extreme Reactors is a continuation of the classic mod Big Reactors. Reactors and Turbines are multi-block structures that have the potential to generate large amounts of power. This book will guide you through the process."]
	quest.3199091CA87F1CD1.quest_subtitle: "Extreme Reactors"
	quest.31A42D4E46C5856B.quest_desc: [
		"To use framed blocks:"
		""
		"- Right click the block with almost any solid block to make it look alike."
		"- Right click the block with a fluid container to make it look like the fluid in the container."
		"- Right click the block with Glowstone Dust to make it produce light."
		"- Right click the block with a Framed Hammer to remove the camo."
		"- Right click the block with an empty fluid container to remove a fluid camo."
	]
	quest.31D2D1709EB19D54.quest_desc: ["Place in front of animals to generate pink slime."]
	quest.31FC1E10FF6B79D5.quest_desc: ["将距离延长到64格，还能通过信标进一步延长距离（指针指向物品按住Shift查看更多信息）。"]
	quest.326626C6F888B720.quest_desc: ["To use this mod, one needs to make 2 Recipe Pattern Holders and encode them with an Encoder. "]
	quest.32664FCADE420D48.quest_desc: [
		"Addons make industrial foregoing machines better! There are addons for efficiency, range, speed, and more!"
		""
		"Higher tiers exist, see JEI."
	]
	quest.32664FCADE420D48.title: "Addons"
	quest.3278DE2E493332DC.quest_desc: ["生成无限水！需要放入流体抽屉。"]
	quest.327E60DEDF8D9876.quest_desc: ["The energized smelter is your basic electric furnace that uses energy instead of fuel to smelt items."]
	quest.3287EB20CFF4AF31.quest_desc: ["Create, maintain, and generate power from a max size turbine from Mekanism."]
	quest.329254403D3AE4CC.quest_desc: [
		"The Simple Achievements are not avaliable until all other quest chapters are complete."
		""
		"These quests are designed to be completed using no EMC and no creative items."
		""
		"Have a suggestion on what to add to the Simple Achievements? Send a message on Discord!"
	]
	quest.329254403D3AE4CC.title: "简单成就"
	quest.329F702B5D9928FB.quest_desc: ["A creative-tier air source that provides infinite compressed air to connected pneumatic machines without requiring power or fuel."]
	quest.32FA63E4958B5E3C.quest_desc: ["Crafted using the energizing orb. Used in crafting recipes for blazing tier Powah items."]
	quest.332842533827F298.quest_desc: [
		"Mine ancient debris in the nether and smelt to obtain."
		""
		"Combine four netherite scrap with four gold ingots to make a netherite ingot!"
	]
	quest.333DA241BCF97E3B.quest_desc: ["Made of 10,000 steel ingots"]
	quest.334C069543F12A2D.quest_desc: [
		"A lot of activities require a person to be around, most of them for placing blocks into the world. This, really, is a waste of personell in a time where aura can work in its place. The Imperceptible Builder will place any blocks you supply it with for a small amount of aura in return. The builder gathers the blocks for placement from any item container placed on top of it."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.3358A31C7B81C9CB.quest_desc: [
		"See the Minecraft wiki if you don't know how to build a nether portal :)"
		""
		"&4Note: A flint and steel is required to light the nether portal, as Fire Spread is disabled by default.&r"
	]
	quest.3358A31C7B81C9CB.quest_subtitle: "Minecraft"
	quest.3358A31C7B81C9CB.title: "Into the Nether"
	quest.3369867891992907.quest_desc: [
		"The Charger provides a way to charge supported tools, and Certus Quartz Crystal."
		""
		"Power can be provided via the top or bottom, via either AE2's cables, or other mod power cables. It can accept either AE2's power (AE) or Forge Energy (FE). Items can be inserted or removed from any side. Only the results can be removed, so no need for filters to prevent removing certus crystals instead of charged certus. Can be rotated with a Certus Quartz Wrench in order to facilitate automation."
		""
		"Can be used to create Charged Certus Quartz Crystal from Certus Quartz Crystal, and Meteorite Compass from Compass."
		""
		"To power it manually, place a Wooden Crank on the top or bottom and right-click it until the item is charged."
		""
		"It also acts as the workstation for the Fluix Researcher."
	]
	quest.33D83D703DB763EF.quest_desc: ["由黏土球和骨粉制作而来，用以制作未烧制的瓷器，如坩埚等。"]
	quest.33F3134668A08D26.quest_desc: [
		"Burns any Fuel (Coal/Wood/etc)."
		""
		"1 Coal = 20,000 RF (Similar to most other mods fuel levels)."
		""
		"Internal storage capacity of 1,000,000 RF"
		""
		"Burns fuel and charges a single item rather quickly."
		""
		"Meant as a stop gap measure to charge items you want to use before you get a fully fledged energy system going."
	]
	quest.33F3134668A08D26.quest_subtitle: "Charging Gadgets"
	quest.33FBEE929807ECFB.quest_desc: [
		"由铁筛网升级而来。"
		""
		"随着筛网等级的改变，筛取物品的掉落也会改变，详情查看JEI。"
	]
	quest.34172B8D67D6281E.quest_desc: ["Crafting ingredient to create Warden tools and armor."]
	quest.34612C1E6AEDC97F.quest_desc: ["游戏前期双倍矿方式——非常慢，但是未来会有更好的选择！需要能量（RF）。"]
	quest.34612C1E6AEDC97F.quest_subtitle: "Useful Machinery"
	quest.3465BA65A8FF769E.quest_desc: ["The inscriber is used to inscribe circuits and processors using presses, and to crush various items into dust. It can accept either AE2's power (AE) or Fabric/Forge Energy (E/FE). It can be sided, such that inserting items from different sides inserts them into different slots in its inventory. To facilitate this, it can be rotated with a Certus Quartz Wrench. It can also be set to push the results of crafts to adjacent inventories."]
	quest.3473210E7AAB80EE.quest_desc: [
		"一座改良高炉最多可以安装两个高炉预热器——左右两侧各一个。需要供电才能运行。"
		""
		"一个高炉预热器可以使改良高炉的速度翻倍，两个可以将速度提升至三倍。"
	]
	quest.3473210E7AAB80EE.title: "高炉预热器"
	quest.3475FD5AB260705E.quest_desc: ["类似物品抽屉，但存储的是流体！"]
	quest.34892B714A83B9BD.quest_desc: [
		"The Emerald Apple grants the following potion effects:"
		""
		"    Strength I (4:00)"
		"    Regeneration III (0:20)"
		"    Absorption IV (4:00)"
		"    Fire Resistance I (4:00)"
		"    Resistance II (4:00)"
	]
	quest.34892B714A83B9BD.quest_subtitle: "Pickle Tweaks"
	quest.34A2FFE184432DB6.quest_desc: ["Made up of 81 cobblestone!"]
	quest.34BD662310054359.quest_desc: ["Energy cubes can be used to hold large amounts of RF. The higher the tier, the more RF can be stored. Tier 3!"]
	quest.34E87FC422893245.quest_desc: ["This block generator has a speed of 64"]
	quest.3503BC17056BE43D.quest_desc: ["Grants immunity to fire and lava and replenishes hunger."]
	quest.350D228F048488A4.quest_desc: ["Surrounding yourself in dark matter seems like such a good idea! It absorbs a large amount of damage taken. You are nearly invincible with the set of armor. At times, you think that you can see movement within the sheen of armor."]
	quest.351C81062D0749EC.quest_desc: ["Surrounding yourself in dark matter seems like such a good idea! It absorbs a large amount of damage taken. You are nearly invincible with the set of armor. At times, you think that you can see movement within the sheen of armor."]
	quest.3535CD981AB4679A.quest_desc: ["火药可以用来合成爆炸相关的物品，也可以作为酿药的材料。由苦力怕掉落。"]
	quest.354B464B693D4D84.quest_desc: ["A basic resource used to craft advanced machinery, components, and crafting tables."]
	quest.354B464B693D4D84.quest_subtitle: "Extended Crafting"
	quest.356967A5117434E7.quest_desc: ["Restores health, provides underwater breathing, and permanent night vision (shift+X)."]
	quest.3574297380D51075.quest_desc: ["A full set of infinity armor will grant you creative flight and invincibility - even from a /kill command."]
	quest.358CAB03A0CA3B8E.quest_desc: ["It will generate a passive maximum of 12 EMC per second up to a maximum of 30,000 EMC at a light level of 15. When placed adjacent to an Energy Condenser, Energy Condenser MK2, Energy Condenser MK3, Anti-Matter Relay MK2 or Anti-Matter Relay MK1, it will transfer the EMC into that machine. "]
	quest.35A1FA947B38610C.quest_desc: ["手持袋子右击末影箱子即可建立链接，然后你就能在物品栏里访问末影箱子了！"]
	quest.35F8C7EA2A6A230A.quest_desc: ["Put on slime boots and use your slime sling for fast travel! Be careful to aim correctly..."]
	quest.3603913FC72967C4.quest_desc: ["Found in Bastions; can be duplicated with a crafting recipe."]
	quest.36751E0CBED417FA.quest_desc: ["Storage Components are the core of all AE2 cells, determining the capacity of the cells. Each tier increases the capacity by 4x and costs 3 of the previous tier."]
	quest.36B761E82E6EFE91.quest_desc: ["An upgraded furnace with a base cook time of 120"]
	quest.36D115CED80477E1.quest_desc: ["Place this in a sealed room with nothing on top of the machine, and then place a filled oxygen tank in the middle slot."]
	quest.36F5C86A7D54D95E.quest_desc: ["Storage Components are the core of all AE2 cells, determining the capacity of the cells. Each tier increases the capacity by 4x and costs 3 of the previous tier."]
	quest.3700FAC908C2A72E.quest_desc: ["A full set of infinity armor will grant you creative flight and invincibility - even from a /kill command."]
	quest.372B5CB656A0373E.quest_desc: [
		"如果你会飞的话，建造大规模刷怪场可能就会简单许多……"
		""
		"要给你的竹蜻蜓帽充能的话，可以在JEI查找Charging Gadgets模组中的\"充能站\"。"
		""
		"Propeller Hats模组添加了多种等级的竹蜻蜓帽，供你四处飞行。竹蜻蜓帽由FE驱动，所以你需要某种充电器来为其充电。"
	]
	quest.372B5CB656A0373E.quest_subtitle: "Propeller Hats"
	quest.375349762EEA75A9.quest_desc: ["A simple wooden planter that automatically grows crops and saplings without requiring power at a much slower rate. Can't be automated (except to output into a container directly below it)."]
	quest.375349762EEA75A9.quest_subtitle: "Agritech Evolved"
	quest.3756A02BEECBD1E3.quest_desc: ["Components are used to craft catalysts. They get harder to craft as they move higher in tiers."]
	quest.3760B6D798A48C9B.quest_desc: [
		"A long-time fan favorite, Actually Additions is returning to Minecraft 1.20.4+ with brand-new models and textures and lots of overhauls!"
		""
		"Use the Atomic Reconstructor and the Empowerer to turn minerals into powerful crystals that allow the creation of useful machines for processing and sorting items, lasers for wirelessly transporting energy, items and fluids, renewable oil to generate power, and much more."
	]
	quest.3760B6D798A48C9B.quest_subtitle: "Actually Additions"
	quest.3760B6D798A48C9B.title: "Actually Additions Manual"
	quest.376C6AD36CE3F09E.quest_desc: ["The starting point for crafting Angel Rings! Who doesn't love Creative flight?"]
	quest.376C6AD36CE3F09E.quest_subtitle: "Angel Ring"
	quest.37B82D083578AAE3.quest_desc: [
		"By consuming power and liquid experience, the Soul Binder can convert the type of monsters a Broken Spawner will spawn by binding it with a filled Soul Vial."
		""
		"To add Experience to the machine, one can use a Fluid Conduit connected to a tank or other source of Liquid XP; alternatively, one can use the Experience Rod to place Experience inside of the machine directly from the player"
	]
	quest.380EF464962F81B3.quest_desc: ["Generate 1 billion RF/tick."]
	quest.3833EC6F7FBBA74F.quest_desc: ["如果控制器的六个面不够你用的话，链接这个扩展器可以再给你六个同样能够访问整个抽屉网络的面。"]
	quest.38451728CB184D6A.quest_desc: ["A powerful device that controls time and weather"]
	quest.38451728CB184D6A.quest_subtitle: "Draconic Evolution"
	quest.384531776969BAA4.quest_desc: ["液体压缩机的升级版。"]
	quest.38D7180D07D8A349.quest_desc: [
		"The Slice'N'Splice \"slices\" and \"splices\" heads and other things, adding components into it to create new components. It has six input slots, plus two tool slots, and one output slot. The stack size of each input slot in the Slice'N'Splice is exactly one."
		""
		"The Slice'N'Splice requires two tools in order to function- an Axe and Shears. The creation process will not start without these. Each operation will take off one durability from each tool."
	]
	quest.38E8EA5AB3A98610.quest_desc: ["[ \"Must complete the quest \", { \"text\": \"Teleporter\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6EF67A87979A9378\" } }, \" to unlock.\" ]"]
	quest.38E8EA5AB3A98610.quest_subtitle: "15 Coins"
	quest.38E8EA5AB3A98610.title: "Epic Reward Bag"
	quest.3905C1E98C8931B0.quest_desc: [
		"Of course, based on the world that you are currently in, the type of aura collected will slightly vary. For instance, in the normal world, aura can be gathered in the form of sunlight, while in the Nether realm, aura can be gathered in the form of ghosts, and in the End realm, aura is present in the form of an overabundance of darkness."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.39140A5AC01843D2.quest_desc: [
		"\"How do I make more islands if I am playing multiplayer?\""
		"- Run the command \"&b/skyblock gui&r\"."
		""
		"\"Are there different packmodes?\""
		"- Yes, run the command \"&b/packmode help&r\"."
		""
		"\"Why aren't passive mobs spawning?\""
		"- If for some reason animals are not spawning, you can craft animal seeds, search \"Haven Animal Seeds\" in JEI."
		""
		"\"Is there vein miner?\""
		"- The mod FTB Ultimine is included in this pack. The default keybind is the grave key: `."
		""
		"\"Why isn't the Twilight Forest Portal opening?\""
		"- Look up \"Twilight Diamond\" in JEI. This is needed to open the portal."
		""
		"\"Do I need to do the quest pages in order?\""
		"- No."
		""
		"\"How do I get more than five hearts?\""
		"- Eat a wide variety of food to gain permenant hearts!"
		""
		"\"How do I get [insert item here]?\""
		"- Use JEI to find recipes. Also, vanilla mechanics still apply for many vanilla items (i.e. finding upgrade templates in bastions)."
		""
		"\"Is there an Ozone Skyblock Reborn 1?\""
		"- Yes, look up \"Ozone Skyblock Reborn\" on Curseforge."
		""
		"\"Could all of these questions have been answered if I read the quest descriptions?\""
		"- Yes."
	]
	quest.39140A5AC01843D2.quest_subtitle: "Can't find the answer here? Head to Discord and ask!"
	quest.39327666C21DA6F6.quest_desc: ["By working in large quantities of the powerful red and dark matters, you manage to dramatically speed up the construct. It now pulls items apart into EMC 64 at a time. It also now has a separate chamber to place transmuted items."]
	quest.39596CAA42FE6D8A.quest_desc: ["Even with the dark matter armor, you can still take a noticeable amount of damage when things start getting hairy. You decide to try throwing some red matter at the problem like any good alchemist, and find that this new Red Matter Armor blocks so much incoming damage you can't even feel anything apart from the actual kinetic energy pushing you around. But... Maybe you can go even one step further?"]
	quest.397356F1B2238867.quest_desc: ["Your basic terminal, allowing you to view and access the contents of your network's storage and request things from your autocrafting setup."]
	quest.3999198FADFC6A44.quest_desc: [
		"由金筛网升级而来。"
		""
		"随着筛网等级的改变，筛取物品的掉落也会改变，详情查看JEI。"
	]
	quest.39BB1EE4D2B24353.quest_desc: ["Injectors must be correct tier for crafting, see JEI. Power is required for fusion crafting. Injectors are upgradable to next tier."]
	quest.39BC864BAA5BEF13.quest_desc: ["PackagedAuto is an addon to Applied Energistics 2, and it aims to use \"packages\" of items to allow autocrafting with more than 9 items, and fluid crafting is also supported."]
	quest.39BC864BAA5BEF13.quest_subtitle: "Packaged Auto"
	quest.39D148ACFB96F5F9.quest_desc: ["拥有同样的流体存储总量，但能容纳四种不同流体！"]
	quest.39E081184335B6E1.quest_desc: ["The Awakening Altarnator is a single-block automatable version of the Awakening Altar."]
	quest.39E081184335B6E1.quest_subtitle: "Mystical Automation"
	quest.39EF5A9782C3678C.quest_desc: ["The waste product from using uranium in a reactor."]
	quest.3A1D456E94BB9A46.quest_desc: ["Elemental seeds create elemental essence - needed for Awakened Supremium."]
	quest.3A43D6B2F5FBA5E6.quest_desc: ["Fuel can be used in rockets without an upgraded motor."]
	quest.3A6A4C98058E48FC.quest_desc: ["Power from the sun."]
	quest.3A7ACD6C36478B09.quest_desc: ["Max Blocks: 9"]
	quest.3AD0AA05BFD863C2.quest_desc: [
		"功能性存储是存储抽屉的平替，但外观更新，功能更多。"
		""
		"经典的1x1抽屉能够容纳大量同种物品，抽屉拥有各种木头的变体版本，还可以升级。"
	]
	quest.3AD0AA05BFD863C2.quest_subtitle: "Functional Storage"
	quest.3B17326FFA1DC8F6.quest_desc: [
		"Control Circuits are key components in crafting Mekanism machines/tools. They are present in many recipes, and different recipes may require different tiers of Control Circuits. For example, an Energized Smelter would require Basic Control Circuits, but a Chemical Dissolution Chamber would require Ultimate Control Circuits."
		""
		"Tier 1."
	]
	quest.3B39980FD69BE7EE.quest_desc: ["在泥土上使用以创造祈福之土（5x5区域）——祈福之土上将生成友好生物。"]
	quest.3B6BA03724FFA136.quest_desc: ["三阶升级，鼠标指针悬停在物品上以查看详细信息，能够合成下界合金升级。"]
	quest.3BD7934F9EDAA4A9.quest_desc: [
		"Of course, based on the world that you are currently in, the type of aura collected will slightly vary. For instance, in the normal world, aura can be gathered in the form of sunlight, while in the Nether realm, aura can be gathered in the form of ghosts, and in the End realm, aura is present in the form of an overabundance of darkness."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.3BF6C883E6197374.quest_desc: [
		"While the primary intended method of providing energy to your network is an Energy Acceptor, the vibration chamber can directly generate small to middling amounts of AE."
		""
		"By default (no upgrades) it makes 40 AE/t."
		""
		"When the network's energy storage is full, the vibration chamber throttles down to conserve fuel, but cannot fully shut off."
	]
	quest.3BF7D0F1043813F1.quest_desc: ["Crafted using the energizing orb. Used in crafting recipes for nitro tier Powah items."]
	quest.3C213A6C4914FDFA.quest_desc: ["Made up of 59049 cobblestone!"]
	quest.3D1786596C9FCC88.quest_desc: ["升级是一种能够对管道进行增强的物品，可以提升管道的传输速度、效率，或是加入新的功能，例如过滤和堆叠。"]
	quest.3D70E1BB2986C4DB.quest_desc: [
		"The fundamental unit of this mod is the Data Model - an item which holds information about an entity that you can utilize to generate their drops. To get a Data Model, you must first craft a Data Model Framework, and use it on the target entity to build the model. Once you have your model, you will have to train it."
		""
		"Training a Data Model can be done in one of two ways, with a Deep Learner or with a Simulation Chamber. The deep learner allows you to store a few data models within, and kills you receive will begin to train the model. All models start out in the Faulty state, and must be trained up to Basic in the deep learner."
	]
	quest.3DAA865F15382848.quest_desc: ["Created using the latex processing unit. Smelt to make plastic."]
	quest.3DCC9A603A17DAB3.quest_desc: ["An upgraded furnace with a base cook time of 40"]
	quest.3E0C3A64AC5CD7AC.quest_desc: [
		"To use framed blocks:"
		""
		"- Right click the block with almost any solid block to make it look alike."
		"- Right click the block with a fluid container to make it look like the fluid in the container."
		"- Right click the block with Glowstone Dust to make it produce light."
		"- Right click the block with a Framed Hammer to remove the camo."
		"- Right click the block with an empty fluid container to remove a fluid camo."
	]
	quest.3E14B10C0D95CDF9.quest_desc: [
		"If you really need animal seeds before you can craft the base, then you can purchase it here. It doesn't come cheap! "
		""
		"Repeatable every 30 minutes."
	]
	quest.3E14B10C0D95CDF9.quest_subtitle: "Get a bad spawn biome?"
	quest.3E14B10C0D95CDF9.title: "Need Animals?"
	quest.3E4218A3CBD9CB28.quest_desc: ["Crafted from resources you will find in the Otherside."]
	quest.3E46241002680BCC.quest_desc: [
		"Interfaces act like a small chest and fluid tank that fills itself from and empties to network storage depending on what you set it to keep a stock of in its slots. It tries to complete this in a single gametick, so it can fill itself with or empty itself from up to 9 stacks per gametick, making it a fast method of import or export if you have fast item pipes."
		""
		"Another useful trait is that while most fluid tanks can only store 1 type of fluid, interfaces can store up to 9, as well as items. They're essentially just chests/multi-fluid tanks with some extra functionality, and you can prevent that extra functionality by keeping them disconnected from any networks. Thus, they are useful in some niche cases where you want to store a small amount of a bunch of different stuff."
	]
	quest.3E745AF0ACA85BA6.quest_desc: ["Injectors must be correct tier for crafting, see JEI. Power is required for fusion crafting. Injectors are upgradable to next tier."]
	quest.3E7EFAE0131CDB93.quest_desc: ["骨头的主要获取途径为骷髅及类似生物，能够用来合成骨粉或驯服野生的狼。"]
	quest.3EB30F879AB9402A.quest_desc: ["Use as a fertilizer in advanced planters!"]
	quest.3EC6F6C5228BAD28.quest_desc: ["Combines the functions of a pickaxe, shovel, and sword with immense mining speed and attack power"]
	quest.3ED9992DD5070D51.quest_desc: ["Using a simple cooking system and a few familiar ingredients, Farmer's Delight lets you be able to prepare a wide variety of hearty meals: from sandwiches to salads and stews, from beautiful desserts to mouth-watering feasts, no ingredient will be left behind in your kitchen!"]
	quest.3ED9992DD5070D51.quest_subtitle: "农夫乐事"
	quest.3EDA781E026296F3.quest_desc: ["This machine uses energy to extract dusts out of certain blocks and ores, making it essential to producing different kinds of tools. Not to be mistaken with the Crusher, this machine is the pulverizer equivalent in other mods."]
	quest.3F171C175D462267.quest_desc: [
		"筛子：自动筛矿！和普通筛子共用筛网。筛网可以附魔时运和效率。需要更多铁吗？试试筛粉碎深板岩。需要能量（RF）。"
		""
		"锤：能够将圆石变沙砾，沙砾变沙子，沙子变尘土等等！需要放入锤子（可以附魔效率）。需要能量（RF）。"
	]
	quest.3F171C175D462267.title: "机械升级"
	quest.3F1E49F84A0BA465.quest_desc: ["Crafting Ingredient. Armor made from this material pacifies phantoms."]
	quest.3F3DC4BF5C52FE28.quest_desc: ["Build a max sized big reactor with reinforced materials."]
	quest.3F74784097718DB8.quest_desc: [
		"A peaceful alternative for resource gathering."
		""
		"- A superflat world with a large layer of Stone, then Deepslate, then Netherrack and then End Stone with ores in each layer. but with no caves or caverns."
		"- Completely free of hostile mobs."
		"- Always daytime."
	]
	quest.3F8BD6F64BECC35C.quest_desc: ["Pump in latex to start making rubber."]
	quest.3F8D587A704CE81C.quest_desc: ["Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."]
	quest.3F8D587A704CE81C.title: "Magical Medallions"
	quest.3F9634C76705A187.quest_desc: ["Faster movement, slow falling, and immunity to fall damage. Fly without spending EMC like [Ring of Arcana] (double space). Short flight boosts (hold space). Step assist to scale elevation without jumping (X)."]
	quest.3FBC14ADA3E118E2.quest_desc: [
		"Place the Ender Crafter in-world and right-click to view the GUI. Inside there's a 3x3 crafting grid, similar to a Crafting Table. Place your recipe ingredients into the grid and the Ender Crafter should begin to craft."
		""
		"To increase crafting speed, place Ender Alternators around the Ender Crafter. Any Alternators placed within a 4 block radius will increase the crafting speed. You can tell they are working if they are emitting particle effects."
	]
	quest.3FBC14ADA3E118E2.quest_subtitle: "Extended Crafting"
	quest.3FE0809FC18DD36F.quest_desc: ["一把能造成8点伤害的剑。"]
	quest.3FFD5071CAB35FE9.quest_desc: ["经典空岛用品，和普通的桶差不多，但是只能在个别合成配方中使用，用来盛熔岩会缩短其寿命。"]
	quest.402ABC0A6EA35DD4.quest_desc: ["You use connectors to connect machines to your network. Through that connector various channels (even with different types) can do their thing. Normal connectors only allow access through the side from which you are placing the connector. i.e. for a vanilla furnace that would mean that with a normal connector you can only get the melted result by placing a connector at the bottom of the furnace. "]
	quest.402C2DF5EB7E3496.quest_desc: [
		"It uses no durability and kills every mob or player with one hit, even if the player is in Creative mode."
		""
		"Yes, this even works on the Chaos Guardian."
	]
	quest.402D82ABE31FC142.quest_desc: ["用于将电路板与蚀刻酸结合，制造未组装的印刷电路板（PCB）。"]
	quest.409BF70E8D188CD9.quest_desc: ["Control circuits are used to craft several Mekanism items and machines. Tier 5."]
	quest.409BF70E8D188CD9.quest_subtitle: "Mekanism Extras"
	quest.40ABBEE4C6F06C62.quest_desc: ["Stores power; can be a multiblock as well. Works across long distances and through dimensions"]
	quest.40B6870514C5217B.quest_desc: ["Plant on grass to grow a chicken. Make sure to give it plenty of breathing room to grow."]
	quest.40BA19D0B80C6F0A.quest_desc: ["Surrounding yourself in dark matter seems like such a good idea! It absorbs a large amount of damage taken. You are nearly invincible with the set of armor. At times, you think that you can see movement within the sheen of armor."]
	quest.40F3CC129DFC5BCE.quest_desc: ["Hold shift key when hovering over the item to see stats."]
	quest.41174CEBEE63B6EA.quest_desc: ["Hold shift key when hovering over the items to see stats."]
	quest.41174CEBEE63B6EA.title: "Mk1"
	quest.415AB951288AB22C.quest_desc: [
		"Compresses items into singularities. See JEI for required item amounts for each singularity."
		""
		"Each Quantum Compressor recipe usually requires a Catalyst item and some quantity of ingredients. Place the Catalyst in the far left slot and the ingredients into the slot next to it. You can hover over the blue bar to see the current ingredient as well as how many of that item are in the Compressor. If the combination of Catalyst and ingredient has an output, it will show the progress to creating the resulting item."
		""
		"The Quantum Compressor requires power to function. It will only use power when creating the resulting item."
	]
	quest.415AB951288AB22C.quest_subtitle: "Extended Crafting"
	quest.416CD34D9E0E1A74.quest_desc: ["Makes your rocket look like a small rocket!"]
	quest.4178CE375A63CDC6.quest_desc: [
		"When working with aura, by nature, it will be hard to grasp just how much there is in any given area or storage device. The Environmental Eye has the powers to display this information to botanists though: Once created, merely holding it anywhere in one's hotbar will display several pieces of information."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.41B0C5A74D0A5AE1.quest_desc: ["Needed to craft machine upgrades for Mystical Agricultre machines."]
	quest.41C7CA8C8FC35D0B.quest_desc: ["Crafting ingredient for hammers - 5x5x3"]
	quest.425F101DD814DA77.quest_desc: ["Catalysts are used in complex crafting recipes. They get harder to craft as they move higher in tiers."]
	quest.427B08FAFF602FE5.quest_desc: ["Hold shift key when hovering over the item to see stats."]
	quest.4289B236F67F89B1.quest_desc: [
		"The Crafting Terminal is similar to a regular terminal, with all the same settings and sections, but with an added crafting grid that will be automatically refilled from network storage. Be careful when shift-clicking the output!"
		""
		"You should upgrade your terminal into a crafting terminal ASAP."
	]
	quest.42E85B58C9E586C9.quest_desc: ["Right click to instantly harvest leaves, wool, and mushrooms (from mooshrooms). The charge level (V, shift+V) controls the area sheared based on charge."]
	quest.43044B3D63CA83FA.quest_desc: [
		"To use framed blocks:"
		""
		"- Right click the block with almost any solid block to make it look alike."
		"- Right click the block with a fluid container to make it look like the fluid in the container."
		"- Right click the block with Glowstone Dust to make it produce light."
		"- Right click the block with a Framed Hammer to remove the camo."
		"- Right click the block with an empty fluid container to remove a fluid camo."
	]
	quest.431297CE56DC8A83.quest_desc: ["放置在浇注口下方，右击浇注口即可将镕铸炉中的熔融材料排出，浇铸成块。"]
	quest.43689166DFBFABE8.quest_desc: ["放置在浇注口下方，放入铸模，右击浇注口来让液体填满铸模。"]
	quest.43698862AB55F952.quest_desc: [
		"To obtain Ether:"
		""
		"Craft a Stasis Chamber. The main purpose of the Stasis Chamber is to indefinitely contain a Wither. Using a Laser Drill with a Fluid Laser Base and a Purple Laser Lens produces Ether Gas when placed directly above a Wither. This fluid is required to craft Industrial Foregoing's most expensive items, including its highest tier machine frame."
		""
		"A Wither that is spawned inside an active Stasis Chamber's working area will be frozen immediately. It will not lose its invulnerability shield, but the Laser Drill ignores the shield. The Wither will not cause an explosion, and cannot take any actions. Despite this, the player may want to encase the working area in Wither-proof blocks anyway, to prevent any accidents should the Stasis Chamber ever run out of power."
		""
		"The Stasis Chamber's default working area is a 3x3x3 cube directly above the machine. Its size can be increased using Range Addons. Players will be affected by Slowness while inside the machine's working area."
	]
	quest.43698862AB55F952.title: "Ether Gas"
	quest.439C528354838250.quest_desc: ["To use this mod, one needs to make 2 Recipe Pattern Holders and encode them with an Encoder. "]
	quest.440D476CAB19C05E.quest_desc: ["This upgrade changes the fuel needed by the rocket to uranium."]
	quest.4435C785551464AD.quest_desc: [
		"The Chaos Guardian can be found on Chaos Islands in the End, which will spawn in every 2500 blocks."
		""
		"The following is taken from the Draconic Evolution project page: "
		""
		"Spoiler Warning!"
		""
		"&nEquipment&r&l"
		""
		"I recommend a Draconic Chest Piece with draconic flight, shields (obviously), undying, and at least 2 speed modules. "
		""
		"The new blink function on the Advanced Dislocator is also very useful especially if you assign a keybinding for it.  "
		""
		""
		""
		"&nGuardian healing crystals&r&l"
		""
		"The Guardian crystals can no longer be destroyed by normal damage as they have shields powered directly by the chaos crystal at the heart of the island. This link can be temporarily disrupted by hitting the crystal with chaotic damage. Ether get the guardian to fire at a crystal or use a chaotic tier weapon if you have one."
		""
		"The link will only be disrupted for a few seconds so hit the crystal with as much damage as you can to destroy it then get out of there because the guardian won't be happy! "
		""
		""
		""
		"The guardian now has a number of basic and advanced attacks. "
		""
		""
		""
		"&nBasic Attacks&r&l"
		""
		"The will occasionally charge the player and try to deal direct melee damage but more often he will bombard the player with fireballs."
		""
		"The guardian also has a basic defensive move where if a player is too close for too long he will fly off at high speed while enveloping himself in a loud of fireballs."
		""
		""
		""
		"It's worth noting the guardian's fireballs are incredibly powerful and it will only take a few to break through a draconic shield. "
		""
		"Your best defense against these attacks is to evade/outmaneuver the guardian using your draconic elytra. (Draconic flight module) "
		""
		""
		""
		"&nCharged (Advanced) Attacks&r&l"
		""
		"The guardian also has several \"advanced attacks\" For these the guardian will first go and hover at the center of the island where he can draw energy directly from the island's chaos crystal. This makes him temporarily immune to damage. Then after a short charge-up period, he will activate one of several attacks."
		""
		""
		""
		"&nLaser:&r This one is pretty simple, The guardian will fire a beam of concentrated chaos energy at you which will melt your shield and kill you almost instantly (If you don't have a charged undying module)."
		""
		"Your best defense against this attack is to take cover and put one of the crystal pillars between you and the guardian. The beam can destroy end stone but not obsidian."
		""
		"If you are careful this is also a good chance to take out a crystal by guiding the laser to the top of the pillar."
		""
		"You will quickly learn when the guardian is about to use the laser attack as after the initial charge you will hear a secondary charging sound as the laser effect builds up energy."
		""
		"If you have a friend helping you and you have already destroyed the crystals this is a good time for the person not being targeted to deal some damage to the guardian. "
		""
		""
		""
		"&nGravity Well:&r For the following advanced attacks, the guardian fill use the power of the chaos crystal to generate a powerful gravity well that prevents you from flying or leaving the island's bounds. "
		""
		"This is where the advanced dislocator's blink function can come in handy as it allows you to get around quickly and dodge attacks."
		""
		""
		""
		"&nBombardment:&r This is a pretty simple attack guardian will lock onto your position and fire a volley of fireballs at you. If you don't get out of the way fast enough you will most likely die."
		""
		""
		""
		"&nMulti-stage attack:&r This attack has 4 stages. In the first (and most annoying) stage, the guardian will spawn several guardian withers to soften you up. These are stronger than normal withers and are laser-focused on attacking players."
		""
		"Once you kill the initial wave of withers the guardian will initiate 3 stages of areal bombardment."
		""
		"First, he will bombard the perimeter of the island in a circular pattern (So take cover at the center of the island)"
		""
		"Next, he will bombard the center of the island. So go the perimeter and watch out for stray fireballs. "
		""
		"Then finally he will bombard the entire island with random fireballs. The best way to survive this stage is to be at the perimeter of the island and try to dodge any fireballs heading your way."
		""
		"You're probably going to want to have some charged undying modules for this stage."
	]
	quest.4435C785551464AD.quest_subtitle: "How do I fight this thing??"
	quest.444CC3223736987B.quest_desc: ["Control circuits are used to craft several Mekanism items and machines. Tier 3."]
	quest.4452E64D7145CFE3.quest_desc: ["Mystical Agriculture is a mod based around the concept of growing your resources with crops. Use crops to grow essences used to make materials, mob drops, tools, armor and possibly even more!"]
	quest.4452E64D7145CFE3.quest_subtitle: "Mystical Agriculture"
	quest.4452E64D7145CFE3.title: "Mystical Agriculture Guide"
	quest.445C1394C2925EE2.quest_desc: [
		"Here you can trade your hard-earned coins for reward bags. Rewards can range from useless to amazing. Good luck!"
		""
		"&2Note: Certain quest lines will need to be completed before unlocking the higher tiers of reward bags.&r"
	]
	quest.445C1394C2925EE2.quest_subtitle: "Spend your coins!"
	quest.44750CE6BE9DB523.quest_desc: ["Using a simple cooking system and a few familiar ingredients, Farmer's Delight lets you be able to prepare a wide variety of hearty meals: from sandwiches to salads and stews, from beautiful desserts to mouth-watering feasts, no ingredient will be left behind in your kitchen!"]
	quest.447C4BB189DF8AB9.quest_desc: [" Pulls you to the earth with great speed and repels mobs (shift)."]
	quest.448DF487E20E3AF5.quest_desc: ["A utility tool used to configure and link Laser Nodes together in your item, fluid, energy, or redstone networks."]
	quest.44A2441F00719ADD.quest_desc: [
		"Fluix Crystals possess the unique ability to absorb and convert energy from one form to another, and are the foundation of all Matter Energy technology."
		""
		"One of the primary ingredients for AE2 blocks, devices, and items. Made by throwing nether quartz, redstone, and Charged Certus Quartz Crystal in water."
		""
		"It can be automated using a ME Formation Plane and ME Annihilation Plane."
	]
	quest.44B1489E34B8C8BB.quest_desc: ["This higher-tier coil is required for more advanced machines and energy devices."]
	quest.44CC1D3469523E4A.quest_desc: ["Storage Components are the core of all AE2 cells, determining the capacity of the cells. Each tier increases the capacity by 4x and costs 3 of the previous tier."]
	quest.44D504D72D362C72.quest_desc: ["Holds double the cells than the standard drive."]
	quest.44D504D72D362C72.quest_subtitle: "ExtendedAE"
	quest.44EFADD7178AAE20.quest_desc: ["This crafting component is a low-tier coil used in early-game machine and tool recipes."]
	quest.451E4F4A7AC324BF.quest_desc: ["Hold shift key when hovering over the item to see stats."]
	quest.454B473F16B73356.quest_desc: ["每次升级都会增加存储空间以及升级槽位。"]
	quest.4579E77C572486C8.quest_desc: ["An upgraded furnace with a base cook time of 80"]
	quest.457F0F8D2AF686E8.quest_desc: ["A creative-tier upgrade that provides unlimited anything to compatible machines without consuming any resources."]
	quest.45887881B110D056.quest_desc: [
		"压缩筛子可以筛压缩方块——九合一！"
		""
		"在筛子底部放置方向朝上的自动点击器可以自动筛矿！同样还有更好的自动化筛矿方式。"
		""
		"将压缩筛子摆放在一起可以同时筛矿（尝试摆成3x3的正方形）。与普通筛子不同的是，你需要一个一个地放入方块才能开始筛矿。"
	]
	quest.45A5707D025CD692.quest_desc: [
		"The Diamond Apple grants the following potion effects:"
		""
		"    Regeneration II (0:20)"
		"    Absorption III (4:00)"
		"    Fire Resistance I (4:00)"
		"    Resistance I (4:00)"
	]
	quest.45ACDBE42962793A.quest_desc: ["Catalysts are used in complex crafting recipes. They get harder to craft as they move higher in tiers."]
	quest.45D448B5B0D04FDB.quest_desc: ["Receives wireless redstone signals."]
	quest.45E28C06FE4C7789.quest_desc: ["两个槽的压缩抽屉。"]
	quest.45E3F8498766ED51.quest_desc: ["Even faster conduits!"]
	quest.45E3F8498766ED51.title: "Conduits - Tier 3"
	quest.45EDE15AF534BBF5.quest_desc: ["前期用蚀刻器和蚀刻酸制作，随后可通过装配台制作。"]
	quest.462375E9E65C799F.quest_desc: [
		"This flower can be obtained after defeating the Ender Dragon."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.465262DA42AAFC33.quest_desc: ["能够粉碎成沙子，在筛子中使用可以获取资源！"]
	quest.46914D5CDA4CAFA7.quest_desc: ["Obtained by defeating the Ender Dragon. Unlocks the start of Draconic Evolution!"]
	quest.46914D5CDA4CAFA7.quest_subtitle: "Draconic Evolution"
	quest.46A87E7A5F454339.quest_desc: ["This mod allows you to cover up pretty much any cable/pipe from any mod!"]
	quest.46A87E7A5F454339.quest_subtitle: "Cable Facades"
	quest.46D8585E55448576.quest_desc: [
		"Ender IO machines that have an upgrade slot require capacitors to function."
		""
		"Depending on their Base Modifier, Capacitors can increase the Speed, Range or Energy Storage of machines."
		""
		"Level: 4"
	]
	quest.470BE71BADF07F29.quest_desc: ["36-slot Pattern Provider – craft or export huge recipe sets in one block."]
	quest.470BE71BADF07F29.quest_subtitle: "ExtendedAE"
	quest.471E6103F15F0DC3.quest_desc: ["This mystical weapon channels sound-based energy to attack enemies or interact with the environment."]
	quest.47502ABDFAE8843D.quest_desc: [
		"The Osmium Compressor is used to create Refined Obsidian Ingots from Refined Obsidian Dust and Glowstone Ingots from Glowstone Dust."
		""
		"It fuses liquid Osmium (melted down Osmium Ingots placed in the machine's bottom slot) with the originating materials to create their corresponding ingots."
	]
	quest.4755B97229118EB4.quest_desc: [
		"The Awakening Altar is the core component of the multi-block Awakening crafting structure. Along with Awakening Pedestals and Essence Vessels, the altar is mainly used to craft Awakened Supremium. See JEI for uses."
		""
		"To use the Awakening Altar, you must first place it down in the world. Make sure the surrounding area is clear of obstructions. Then, you must place Awakening Pedestals and Essence Vessels around the altar. The altar will show ghost pedestals/vessels in the world, indicating where you must place them."
		""
		"Once your altar is set up, you can place items on the altar and pedestals by right-clicking on them with an item in hand. The same for the vessels, though they can hold up to 40 of an item."
		""
		"To activate the altar you can provide the altar with a Redstone signal (ex. button, lever)."
	]
	quest.47D0492A318B2353.quest_desc: [
		"The Pattern Encoding Terminal is similar to a regular terminal, with all the same settings and sections, but with an added pattern encoding interface. It looks similar to a crafting terminal's UI but this crafting grid doesn't actually perform crafts."
		""
		"You should have one of these in addition to a crafting terminal."
	]
	quest.47DAE272EE988E65.quest_desc: ["Knightmetal Ingot is an item obtained from smelting Armor Shard Clusters."]
	quest.480E83DD55448590.quest_desc: ["Energy storage item that holds and transfers RF"]
	quest.483DA3FB8D65ED2F.quest_desc: ["[ \"Must complete the quest \", { \"text\": \"Netherite Stick\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"75AD65B7786D4698\" } }, \" to unlock.\" ]"]
	quest.483DA3FB8D65ED2F.quest_subtitle: "15 Coins"
	quest.483DA3FB8D65ED2F.title: "Random Reward Bag"
	quest.48675A769F0D3F9D.quest_desc: ["将这些部件组装起来即可构成一台动能发电机，将风能转化为旋转能。（译者注：原文如此）"]
	quest.48675A769F0D3F9D.title: "动能发电"
	quest.488E3B98314C6242.quest_desc: ["Harvests crops in a configurable radius (from 3x3 to 9x9) around the pylon and outputs to an inventory above. Place the pylon inside the water block of the farm. The pylon requires a hoe in the pylon inventory, and will consume 1 durability per crop harvest. Unbreakable hoes, such as Mystical Agriculture's Supremium Hoe, can be used."]
	quest.488E3B98314C6242.quest_subtitle: "Pylons"
	quest.488EB6F4DF70142A.quest_desc: ["Special apples that give different buffs! Hold shift while hovering over the apple to see its effects."]
	quest.4891B2585594139C.quest_desc: ["A block that moves, places, breaks, or interacts with items and blocks using customizable modules and upgrades."]
	quest.48B64BA472D951B7.quest_desc: [
		"Right click to instantly turn dirt into path or harvest a layer at a time dirt and sand. Right click on gravel, clay, or snow to instantly harvest the vein. Based on the charge level (V, shift+V)."
		""
		"- disabled/1 block to path"
		"- 3x3"
		"- 5x5"
		""
		"Harvests the normal shovel blocks extremely quickly."
	]
	quest.48CD3B49D43B3D19.quest_desc: ["Turns anything you can use to smelt in a vanilla furnace (ie coal, wood) into RF."]
	quest.493759F763F02B39.quest_desc: ["拥有同样的流体存储总量，但能容纳两种不同流体！"]
	quest.493B8A2BD7F69B45.quest_desc: ["Hold shift key when hovering over the items to see stats."]
	quest.493B8A2BD7F69B45.title: "Mk2"
	quest.494884093C4BDEB3.quest_desc: ["Elemental seeds create elemental essence - needed for Awakened Supremium."]
	quest.49593BB9B587C493.quest_desc: ["Offers even greater strength, speed, and energy capacity"]
	quest.49645198C15868C6.quest_desc: ["Uses solar power (sun) to generate RF. Tier 6!"]
	quest.496F3837D34D9C5A.quest_desc: ["Control circuits are used to craft several Mekanism items and machines. Tier 7."]
	quest.49794080F37AA6D6.quest_desc: ["Click on a zombie or husk with this."]
	quest.49B1FF0346B228E2.quest_desc: ["Entangled gives you the materials needed to bind two blocks together, allowing you to interact with either one as if they were the same block! This will allow you to transfer items, energy, fluids or whatever you want instantly, you can have more than six sides to work with or you could just hide your messy cables, the possibilities are endless!"]
	quest.49C3172907E94051.quest_desc: ["Place a block in midair! Breaks with no tools and goes right back in your inventory."]
	quest.49C3172907E94051.quest_subtitle: "Utilitarian"
	quest.49C8A5689B4F13C8.quest_desc: ["Collect one of every armor trim in the game (see JEI for a list)."]
	quest.4A896062318A7D4A.quest_desc: ["Spooky Scary Skeletons Send Shivers Down My Spine!"]
	quest.4A94EFEE171A8EAC.quest_desc: [
		"The molecular assembler takes items input into it and carries out the operation defined by an adjacent ME Pattern Provider, or the inserted Crafting Pattern, Smithing Table Pattern, or Stonecutting Pattern, then pushes the result to adjacent inventories."
		""
		"However, their main use is next to a ME Pattern Provider. Pattern providers have special behavior in this case, and will send information about the relevant pattern along with the ingredients to adjacent assemblers. Since assemblers auto-eject the results of crafts to adjacent inventories (and thus into the return slots of the pattern provider), an assembler on a pattern provider is all that is needed to automate crafting patterns."
	]
	quest.4A97D4D54CD232BF.quest_desc: ["Transmits energy through the cable, upgradable."]
	quest.4ADC75DE70AEE87C.quest_desc: ["Slay a shulker in an End City to obtain."]
	quest.4ADFC70E3DA60950.quest_desc: [
		"A device to extract Alchemical Salt from items."
		""
		"Place the oven on top of the braizer. Fill the braizer with blaze rods to heat the oven!"
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.4AEC1E7CE3F054B7.quest_desc: [
		"用锤子破坏方块可以粉碎它。圆石 -> 沙砾，沙砾 -> 沙子，沙子 -> 尘土，下界岩 -> 粉碎下界岩，末地石 -> 粉碎末地石，深板岩圆石 -> 粉碎深板岩，黑石 -> 粉碎黑石，粉碎下界岩 -> 红沙。不久之后，你就能用多种机器来自动化这一过程，但现在，仰仗着你的连锁破坏和建筑棒兄弟吧。"
		""
		"试试锤击原木来获取木屑——一种极好的堆肥！"
	]
	quest.4B49091675AA1DFA.quest_desc: ["Any item placed into its inventory will be converted into EMC and will transfer energy from Energy Collectors to Energy Condensers. When transferring, it gives a 10 EMC per second bonus. It will charge any of the Klein Star series with EMC. "]
	quest.4B5D653985BDC839.quest_desc: [
		"Together with the ritual, knowledge of Tokens can be gained: Wooden figurines, depicting key emotions - created from trees infused with their respective symbols. These figurines contain a combination of the vast power of aura itself and the power of the emotions they represent. Going forward, these Tokens will be a key construction ingredient."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.4B62DEDA4F901770.quest_desc: ["用更快的速度、可调节的面、烟熏炉和高炉组件等，最大化熔炼效率。"]
	quest.4B893A1BDA3CEC33.quest_desc: ["A powerful sword in it's own right by charging it and using activating it (C) the Dark Matter Sword will consume EMC in exchange for a devastating sweep attack. The area of the attack is controlled by charge level (V, shift+V)."]
	quest.4BCB152BBCEB3B90.quest_desc: [
		"The Environmental Eye is very useful in theory; however, a lot of magical botanists struggle with its limited range of gauging aura in the environment around them. A simple solution to this problem is the Environmental Ocular. While working similarly to the Environmental Eye, the main difference is its much bigger gauge for aura in the area: It is twice as large."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.4BD1385340E3C938.quest_desc: [
		"矿石可以挖掘成粗矿，也可以直接熔炼成锭。"
		""
		"除了通常的合成配方外，铁锭还可以用来制作压缩铁锭。将铁锭扔到地面上，并在附近引发爆炸（例如TNT或迷你TNT），你将失去约20%的铁锭，其余部分将会转化成压缩铁锭！后期可以解锁更加高效的获取方式。"
	]
	quest.4BDA60A93E629E04.quest_desc: [
		"Higher tier versions of the tier 1 block gen. Faster yields! "
		""
		"This block generator has a speed of 2"
	]
	quest.4C034DCEC02656A2.quest_desc: ["A Fiery Ingot is an item crafted from one Iron Ingot and one vial of either Fiery Blood or Fiery Tears. Fiery Ingots contain a magical property that causes items crafted using the ingots to acquire fiery properties."]
	quest.4C0BCC84EA19B14A.quest_desc: ["Click on a mob to capture it. Gotta catch them all!"]
	quest.4C1AA8D6EF212081.quest_desc: ["Smelt dry rubber to make plastic."]
	quest.4C6B18C8D270A43E.quest_desc: [
		"XNet is an item, fluid, energy, and information transportation mod that is all about efficiency. The cable system is designed in such way that you should be able to make huge cable systems without any overhead. Cables (for example) are not tile entities and have very simply models. This makes transporting items accross a cable of 12000 blocks long just as efficient as doing it on a 5 block long cable."
		""
		"At the core of this mod is a network. A network is basically a single section of connected cables connected (via connectors) to various blocks (chests, machines, ...) and one controller. The controller is the block that does the actual work for that network."
	]
	quest.4C6B18C8D270A43E.quest_subtitle: "XNet"
	quest.4C6E023AB7291EE5.quest_desc: ["Bound across the skies of the Aether and \"borrow\" some clouds to take back with you."]
	quest.4C6E023AB7291EE5.title: "Aerclouds"
	quest.4C73BD54224F7CC5.quest_desc: ["消耗固体燃料产生气压。"]
	quest.4C9ADC82F706B417.quest_desc: [
		"Alchemically pure gold. Acts as a catalysator, enabling various alchemical processes."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.4CAFFE19D6158181.quest_desc: ["在手册中查阅压力室的搭建方法和相关配方。任务要求的物品就足够搭建一个3x3x3的压力室了——非常适合开局使用！"]
	quest.4CAFFE19D6158181.title: "压力室"
	quest.4CB6ADD18138ACC6.quest_desc: [
		"The export bus pulls items and fluids (and whatever else, given addons) from network storage and pushes them into the inventory it's touching."
		""
		"For purposes of lag reduction, if the export bus has not exported something recently, it goes into a sort of \"sleep mode\" where it operates slowly, and wakes up and accelerates to full speed (4 operations per second) when it successfully exports something."
		""
		"They are cable subparts."
	]
	quest.4CE5621AB71CE988.quest_desc: [
		"- Place your Factory Manager in the world, and connect it to your inventories using Inventory Cables"
		"- Place the Program Disk inside the Manager's GUI"
		"- Paste your script into the manager GUI using the buttons or by using Ctrl+V"
		"- The manager should tell you that the script was loaded"
		"- Hover over the disk to see the warnings and errors for your program"
		"- Shift-right-click the manager with the label gun in your hand to load the labels from your program"
		"- You can now use the scroll wheel while holding shift to change the active label."
		"- Right click blocks in the world to apply or remove the label."
		"- There is also a right-click menu for entering a custom label that may not be in your program yet."
		"- Once you've assigned the labels, right click the manager while NOT holding shift to save the labels to the Program Disk"
		"- Your program should now be running without any issues"
	]
	quest.4CE5621AB71CE988.title: "Factory Manager Tools"
	quest.4CE60F732C4426A3.quest_desc: [
		"Super Factory Manager is a mod for Minecraft that lets users create programs to run their factories. The mod provides a domain specific-language tailored for moving items, fluids, and other resource types. A text editor is included, along with example programs."
		""
		"To get started, you will need a factory manager, a label gun, and a disk. Refer to the project page and GitHub to learn more!"
	]
	quest.4CEC846A1DD5DB84.quest_desc: [
		"Pattern providers are the primary way in which your autocrafting system interacts with the world. They push the ingredients in their patterns to adjacent inventories, and items can be inserted into them in order to insert them into the network. Often a channel can be saved by piping the output of a machine back into a nearby pattern provider (often the one that pushed the ingredients) instead of using an ME Import Bus to pull the output of the machine into the network."
		""
		"Of note, since they push the ingredients directly from the crafting storage in a crafting CPU, they never actually contain the ingredients in their inventory, so you cannot pipe out from them. You have to have the provider push to another inventory (like a barrel) then pipe from that."
		""
		"Also of note, the provider has to push ALL of the ingredients at once, it can't push half-batches. This is useful to exploit."
		""
		"Pattern providers have a special interaction with interfaces on subnets: if the interface is unmodified (nothing in the request slots) the provider will skip the interface entirely and push directly to that subnet's storage, skipping the interface and not filling it with recipe batches, and more importantly, not inserting the next batch until there's space in the machine. This works correctly with blocking mode, the provider will monitor the slots in the machine for ingredients, instead of the slots in the interface."
	]
	quest.4CFFA19AA2AA47CD.quest_desc: ["Catalysts are used in complex crafting recipes. They get harder to craft as they move higher in tiers."]
	quest.4D15D569E53DE66E.quest_desc: ["The ender gate can wirelessly pull power from the ender cell (Works similar to Flux Networks). Both can be upgraded."]
	quest.4D1BF4F802916D45.quest_desc: ["一把能造成7点伤害的剑。"]
	quest.4D1FA2C2E6FC7A8C.quest_desc: ["Allows the use of the terminals/crafting device across dimensions."]
	quest.4D25AC81B93F326E.quest_desc: [
		"筛泥土可以获取草籽。手持草籽右击泥土可以将其转化为草方块。草籽还可以用来合成苔藓块。"
		""
		"友好生物可以在草方块上生成，但前提是与草方块保持好一定距离。在生物生成上遇到了麻烦？在JEI中搜索\"Haven Animal Seeds\"。"
	]
	quest.4D2DA470DCB74326.quest_desc: ["Place in front of a tree or log to generate latex."]
	quest.4D462F76B3844D3D.quest_desc: ["The Precision Sawmill is used for reclaiming wood from wooden items and turn logs into planks with a better yield (6 planks per log). Also makes sawdust for use in making Cardboard Boxes."]
	quest.4D4F4BAEA27DC456.quest_desc: ["Crafted using the Empowerer. See JEI."]
	quest.4D4F4BAEA27DC456.title: "Empowered Crystals"
	quest.4D530984E49A599C.quest_desc: ["A high-tier crafting component infused with RF energy."]
	quest.4DB6A9B473DD4107.quest_desc: ["Made of 10,000 gold ingots"]
	quest.4DBA4D50A7627DA4.quest_desc: [
		"Ender IO machines that have an upgrade slot require capacitors to function."
		""
		"Depending on their Base Modifier, Capacitors can increase the Speed, Range or Energy Storage of machines."
		""
		"Level: 10"
	]
	quest.4DE8575D655E8428.quest_desc: ["An expensive ingot used to get into Project E and craft other endgame items"]
	quest.4DEFB84692377A2D.quest_desc: ["Crafting Ingredient. Armor made from this material pacifies piglins."]
	quest.4DFB541B0D2A9FB9.quest_desc: [
		"As many may be aware, there are several branches of Botany, the study of plants. A lot of botanists have, in the past, focused on the magical properties of plants in the form of flowers, such as the peculiar and pure daisy. "
		""
		"However, botany is a lot more than that, especially Magical Botany, because not only are there more things to be discovered in nature than just flowers, but there are also most likely more powerful things that the world hasn't learned about yet. "
		""
		"When becoming a botanist and studying the influences of trees, flowers and the like, one will stumble upon natural mechanics that seem familiar, yet are, at their core, entirely different. Studying and understanding these is the goal of magical botany."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.4DFB541B0D2A9FB9.quest_subtitle: "Nature's Aura"
	quest.4E113EAB18FAA897.quest_desc: ["Made of 10,000 lead ingots"]
	quest.4E42850BC99F8844.quest_desc: ["Tier 1 - Can store 100 stacks."]
	quest.4E8A216308DE4F60.quest_desc: [
		"Ender IO machines that have an upgrade slot require capacitors to function."
		""
		"Depending on their Base Modifier, Capacitors can increase the Speed, Range or Energy Storage of machines."
		""
		"Level: 3"
	]
	quest.4EAD2382EBF87769.quest_desc: ["An upgraded furnace with a base cook time of 160"]
	quest.4EB47C3E07B444F6.quest_desc: ["Use Animal Seed Base to craft any of the mob seeds from Haven Animal Seeds"]
	quest.4EB47C3E07B444F6.quest_subtitle: "Haven Animal Seeds"
	quest.4F24A4C6468A063A.quest_desc: ["Obtained by reprocessing ridiculite with rossinite, which is a waste product from using verderium as fuel in a reactor."]
	quest.4F67D41CEFA7A8B0.quest_desc: ["The dense heart of a star in convenient ingot form."]
	quest.4F849729CA0DAF2E.quest_desc: ["在筛子中使用可以获取资源！还可以转化成黏土方块。"]
	quest.4F9D4A5D5C0B81D0.quest_desc: ["Grow trees and harvest them automatically! Requires an axe to be inserted and a hopper with chest to be below."]
	quest.4F9D4A5D5C0B81D0.quest_subtitle: "Bonsai Trees"
	quest.4FB596AD930D87D8.quest_desc: ["将各种容器连接到你的简易存储网络！"]
	quest.4FB596AD930D87D8.title: "线缆和连接器"
	quest.4FB61D44C6A7EB44.quest_desc: ["Storage Components are the core of all AE2 cells, determining the capacity of the cells. Each tier increases the capacity by 4x and costs 3 of the previous tier."]
	quest.4FDB39030DEDA50A.quest_desc: ["It deals 20 damage per hit and has or uses no durability but stills needs 1 arrow to be in the inventory. When the arrow hits no entity there will be 10 arrows summonend as an AoE around the first one. These arrows also deal 20 damage each. All arrows will dissappear after a few seconds and they cannot be recollected. "]
	quest.4FEFD780FA021473.quest_desc: ["A golden apple is a food item that bestows beneficial effects when consumed (Absorption and Regeneration) and is also used to cure a zombie villager under the Weakness effect into a normal villager."]
	quest.50200EBDECAF2A3B.quest_desc: ["A high-tech planter with energy consumption, module slots, fertilizer support, and enhanced automation capabilities"]
	quest.50233C3BE23A074A.quest_desc: ["The Angel Ring mod adds an Angel Ring, which allows you to fly, like in a creative mode to help with building/travelling. Inspired by Extra Utilities' Angel Ring."]
	quest.5073B7267BD701D2.quest_desc: ["用染料在末影蓄水槽上染出颜色，相同颜色排列的末影蓄水槽将互相配对。你可以链接两个及以上的末影蓄水槽，无缝存取输送流体！"]
	quest.50765C7CF71D6A59.quest_desc: ["末影珍珠可以将投掷者传送至落点处，也可以用来合成末影之眼，以抵达末地。由末影人掉落。"]
	quest.507C29EFF8CEFCDA.quest_desc: ["多方块结构组件，加热金属，使其达到熔炼与混合所需的温度。"]
	quest.50852ED19616CDB8.quest_desc: ["缓慢生成黑曜石。"]
	quest.50A188092863FFFA.quest_desc: ["Upgrade cards are crafted with either basic or advanced card bases"]
	quest.50F59454D604E225.quest_desc: ["Hold shift key when hovering over the item to see stats."]
	quest.5124714086D19424.quest_desc: ["用绿宝石交易各种种子和树苗！"]
	quest.5124714086D19424.quest_subtitle: "Farming for Blockheads"
	quest.5133A804F271D046.quest_desc: [
		"Welcome to Modular Routers! This is a highly flexible mod for moving items around the world in various ways. With a single block - the Item Router - and a selection of plug-in module items, you can:"
		""
		"- pull items from an inventory (including modded inventories like Storage Drawers)"
		"- send them to other inventories near and far"
		"- place items as blocks"
		"- break blocks"
		"- drop items into the world"
		"- absorb dropped items"
		"- fling items across the world"
		"- sort items (including some sophisticated filters, more than just item/meta/NBT matching)"
		"- void unwanted items"
		"- remotely interact with your player inventory"
		"- extend and retract lines of blocks (drawbridges!)"
	]
	quest.5133A804F271D046.quest_subtitle: "Modular Routers"
	quest.5160093099979CC8.quest_desc: ["Upgrade cards change the behavior of AE2 devices and machines, increasing their speed, improving their filter capacity, enabling redstone control, etc."]
	quest.518837817CC3B489.quest_desc: ["Made up of 9 cobblestone!"]
	quest.51938F2731D46972.quest_desc: [
		"Smelt coal to create graphite."
		""
		"Extreme Reactors utilizes multiblock machines quite heavilly. A multiblock machine is composed by many different blocks that you will place in the world next to each other. Continue through this questline and refer to the mod's book for help!"
	]
	quest.51938F44944122BF.quest_desc: ["Upgraded essences are crafted using the previous tier of essence and an infusion crystal. Used to create Tier 4 seeds. (Crystals are required in expert mode)"]
	quest.51AC0E98DDB51802.quest_desc: ["The Building Gadget allows you to build structures using a set of different Building Modes."]
	quest.51C61DE36D90B959.quest_desc: [
		"Place one pattern holder in a Packager, and the other in an Unpackager, both connected to a ME Network. "
		""
		"The Packager will accept items and make them into Recipe Packages and the Unpackager will take them and output items into an adjacent inventory. "
		""
		"Both machines tell the ME Network what it can do according to the pattern holder, and the Packager, when connected, ejects packages into the network"
	]
	quest.51E5D8D9B1D67E8C.quest_desc: [
		"Infused Iron is a material blessed with the powers of aura, allowing it to be used in several magical natural items. Note that the same infusion is possible using the materials' block form."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.51F44681C05DA51B.quest_desc: ["多方块结构组件，镕铸炉的核心方块，负责管理熔炼操作与合金熔铸。"]
	quest.522B459DA586F112.quest_desc: [
		"This seed base is used to craft different resource seeds."
		""
		"Resource Seeds are the main purpose of Mystical Agriculture. These seeds can grow more than 100 different resources, including Diamonds, Bones, Copper, Redstone and many others. When harvested they all drop their own Resource Essence, as well as having a 10% chance of dropping a Fertilized Essence."
		""
		"There are different tiers of Resource Seeds. The tiers are dependent on how rare the material grown is."
		""
		"These seeds are created using the Infusion Altar with materials, essences and a Seed Base."
		""
		"These crops cannot be grown using Bonemeal or sped up by shifting."
		""
		"They can be grown in the ground, as well as in the Garden Cloche, Planter, or Farmer with the correct soil."
	]
	quest.5267E7C6F511B44B.quest_desc: ["Casings are both decorative and functional blocks used to craft and build various machines and devices within the mod."]
	quest.526E95BD71FA713C.quest_desc: ["About 35.6 million metric tons"]
	quest.52914F9E85778478.quest_desc: ["Used to mix liquids with solids."]
	quest.52914F9E85778478.title: "Reprocessor Components"
	quest.52AB76818BD22CA3.quest_desc: ["Knives act as a modest melee weapon: swings faster than a sword for lesser damage"]
	quest.52DA34ED57CF502B.quest_desc: ["Beheads skeletons and scorches them black"]
	quest.52EE429D7056B815.quest_desc: [
		"Follow the steps outlined in the book on your journey to become a master alchemist."
		""
		"Theurgy aims to introduce a new take on Alchemy in Minecraft. Deviating from the well-trodden path of the \"4 Elements\" - Air, Water, Fire, Earth - it is inspired by classical Alchemy and works with the elements of Sulfur, Salt and Mercury and their handling through a group of processes known as Spagyrics."
		""
		"First and foremost Theurgy tries to create a balanced alchemy experience - not as overpowered as Equivalent Exchange, yet maybe somewhat more practicable than the legendary Thaumcraft."
	]
	quest.52EE429D7056B815.quest_subtitle: "Theurgy"
	quest.52F37674EAB17868.quest_desc: ["Aeternalis Fuel is a fuel added by ProjectE. By combining 4 pieces of Mobius Fuel with a Philosopher's Stone, a new fuel is created. Aeternalis Fuel burns four times as long as Mobius Fuel and is able to smelt 512 items."]
	quest.5309DA86AB2B5596.quest_desc: ["拥有同样的物品存储总量，但能容纳两种不同物品！"]
	quest.531B48D28172F5E4.quest_desc: [
		"Max Blocks: 3"
		""
		"Construction Sticks allow you to place multiple blocks at once, extending your build in the direction you're facing. You can upgrade your stick to enhance its abilities, making construction faster and more efficient."
		""
		"There are five different tiers of Construction Sticks: Wood, Copper, Iron, Diamond, and Netherite. Each tier offers improved durability and block placement abilities, and can be further upgraded with templates. To undo placement, set the keybind in the controls menu."
	]
	quest.531B48D28172F5E4.quest_subtitle: "Construction Sticks"
	quest.531FE01522695851.quest_desc: ["Bathrooms in Minecraft!"]
	quest.5332F636657E15EC.quest_desc: ["Catalysts are used in complex crafting recipes. They get harder to craft as they move higher in tiers."]
	quest.5343BFCD43ECE225.quest_desc: ["Control circuits are used to craft several Mekanism items and machines. Tier 2."]
	quest.534D29AB411AB0F5.quest_desc: [
		"To use framed blocks:"
		""
		"- Right click the block with almost any solid block to make it look alike."
		"- Right click the block with a fluid container to make it look like the fluid in the container."
		"- Right click the block with Glowstone Dust to make it produce light."
		"- Right click the block with a Framed Hammer to remove the camo."
		"- Right click the block with an empty fluid container to remove a fluid camo."
	]
	quest.537E84EDD29F486A.quest_desc: ["Steeleaf is a tool and armor material found in Labyrinth, Hollow Hill, and Dark Tower chests. This material is as powerful as Diamond in a tool or armor, but is less durable than even Iron."]
	quest.53ADBC3ADF1C83C0.quest_desc: ["Made of 10,000 invar ingots"]
	quest.53F53BD4220B295B.quest_desc: [
		"游戏早期发电方式，通过燃煤产生能量（RF），随着你的进一步发展，更多发电方式将会解锁。"
		""
		"注：在前期，可以通过引爆铁锭（TNT加红石信号）来获取压缩铁锭，平均损失率为20%。"
	]
	quest.53F53BD4220B295B.quest_subtitle: "Industrial Foregoing"
	quest.53F5A5A785503096.quest_desc: ["Energy storage item that holds and transfers RF"]
	quest.541A74DE0144E082.quest_desc: [
		"Ender IO machines that have an upgrade slot require capacitors to function."
		""
		"Depending on their Base Modifier, Capacitors can increase the Speed, Range or Energy Storage of machines."
		""
		"Level: 2"
	]
	quest.543FAEFE24110294.quest_desc: [
		"This device generates energy for your ME network without the need for fuel. Because of the crystal vibrations this device generates, only one can be used in each network. These vibrations even pass through Quartz Fiber."
		""
		"Generation Rate: 20.0 AE/t"
	]
	quest.5476B23B4B60A670.quest_desc: ["Iron Jetpacks is a modern Jetpacks mod that is both feature-rich and easy to use. Jetpacks get better as you craft higher tiers. Coils are an integral part of the jetpack crafting process. See JEI."]
	quest.5478FE88578437EC.quest_desc: ["Uses solar power (sun) to generate RF. Tier 3!"]
	quest.5485AE6A649AC6BC.quest_desc: [
		"A vat for alchemical fermentation, required for transmutation."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.548F36AD4A633E9D.quest_desc: ["Storage Components are the core of all AE2 cells, determining the capacity of the cells. Each tier increases the capacity by 4x and costs 3 of the previous tier."]
	quest.5495A4A946E19DAC.quest_desc: ["Made up of 43046721 cobblestone!"]
	quest.54AC69527FD39EF7.quest_desc: [
		"The Seed Reprocessor is a machine built for converting extra seeds into essences."
		""
		"The Seed Reprocessor requires energy to function. You can either provide energy via any Forge Energy compatible energy transfer, or use the internal solid-fuel based generator."
		""
		"The machine can be upgraded using Machine Upgrades for faster operation and increased internal energy storage."
	]
	quest.54B033D5CF77D965.quest_desc: [
		"Faster than the previous tier!"
		""
		"Place the torch on the ground and right-click to access the GUI."
	]
	quest.54BBFA6BC53CD1B7.quest_desc: ["Use as a fertilizer in advanced planters! Can also be used to create mulch."]
	quest.552CCEDED0AE6D5C.quest_desc: ["消耗流体燃料产生气压。"]
	quest.558FE9042159159D.quest_desc: [
		"Crafting units simply fill space in a CPU in order to make it a solid rectangular prism, if you don't have enough of the other components. They are also a base ingredient in the other components."
		""
		"Crafting CPUs manage crafting requests/jobs. They store the intermediate ingredients while crafting jobs with multiple steps are being carried out, and affect how big jobs can be, and to some degree how fast they are completed. See autocrafting for more details."
		""
		"Each crafting CPU handles 1 request or job, so if you want to request both a calculation processor and 256 smooth stone at once, you need 2 CPU multiblocks."
		""
		"They can be set to handle requests from players, automation (export busses and interfaces), or both."
		""
		"Right-clicking one brings up a crafting status UI where you can check the progress on the crafting job the CPU is handling."
	]
	quest.55A12669A448C956.quest_desc: ["The Digital Miner is the scale mining machine of Mekanism. However, this machine is like no other as it \"magically-teleports\" mined blocks to its inventory."]
	quest.55A68150572EC898.quest_desc: ["多方块机器，将植物油和乙醇提炼成生物柴油（其他配方详见JEI）。"]
	quest.55A68150572EC898.title: "精炼厂"
	quest.55A816E8EB2D0E2E.quest_desc: ["Made up of 531441 cobblestone!"]
	quest.55B089A848531E3E.quest_desc: ["Essence Armor pieces are higher tier armor that can be upgraded using Augments."]
	quest.563EF0C91E88B0D5.quest_desc: ["Plant on grass to grow a pig. Make sure to give it plenty of breathing room to grow."]
	quest.56718D2CB87DF305.quest_desc: [
		"压缩锤可以粉碎压缩方块！"
		""
		"用锤子破坏方块可以粉碎它。圆石 -> 沙砾，沙砾 -> 沙子，沙子 -> 尘土，下界岩 -> 粉碎下界岩，末地石 -> 粉碎末地石，深板岩圆石 -> 粉碎深板岩，黑石 -> 粉碎黑石，粉碎下界岩 -> 红沙。不久之后，你就能用多种机器来自动化这一过程，但现在，仰仗着你的连锁破坏和建筑棒兄弟吧。"
		""
		"试试锤击原木来获取木屑——一种极好的堆肥！"
	]
	quest.5675512404BF2759.quest_desc: ["三个槽的压缩抽屉。"]
	quest.56772ECF0B3C75CE.quest_desc: ["Upgraded machine frames are crafted using the Dissolution Chamber. See JEI. Requires pink slime, obtained from the mob slaughter factory."]
	quest.567E3DB67F4F025C.quest_desc: ["Foods give more nutrition after cooking them!"]
	quest.567E3DB67F4F025C.quest_subtitle: "Cooked Foods, Minecraft"
	quest.567E3DB67F4F025C.title: "Cooked Foods"
	quest.567EA6F53C2AB8D2.quest_desc: ["Crafting ingredient, slay a blaze to obtain."]
	quest.56A609B58D0FA6C0.quest_desc: [
		"Only works on Vanilla blocks, 1 durability."
		""
		"Right-click a block with a wand → it becomes an Enlivened Block entity."
		""
		"Enlivened entities can be captured/duplicated by other mods , providing a renewable source of that block. Note: Does not work if the spawner does not copy NBT."
		""
		"Use a Mob Imprisonment Tool on your new entity and duplicate in the Industrial Foregoing Mob Duplicator."
	]
	quest.56CA2BD982503BB0.quest_desc: ["Refill cake with eyes of ender. Requires an advanced crafting table to craft."]
	quest.56CA2BD982503BB0.quest_subtitle: "Ex Deorum"
	quest.56CA2BD982503BB0.title: "Into the End"
	quest.56E02661982102F0.quest_desc: ["More features, and even higher durability!"]
	quest.570BE7D3659C6BB0.quest_desc: ["Set up a Mekanism portal network that connects your main base to every dimension."]
	quest.5720FF9BB1596CA1.quest_desc: ["Batteries are used to store RF. Can be used in machines and to charge items. Hover over each battery tier to see capacity and I/O speed."]
	quest.5735F3DABF096132.quest_desc: ["将液态塑料倒在世界中，它就会硬化成塑料片。"]
	quest.573FB7A2379800A5.quest_desc: ["One of the steps needed to make the endgame less painful"]
	quest.573FB7A2379800A5.quest_subtitle: "Mystical Agriculture"
	quest.57C920272A14206C.quest_desc: ["Make your life easier by getting Awakened Draconium from seeds!"]
	quest.57C920272A14206C.quest_subtitle: "Mystical Agriculture"
	quest.5818B49C16BB6B8F.quest_desc: ["This wearable item accelerates the growth of nearby crops when powered."]
	quest.5844BCF0147A9BB5.quest_desc: ["This is an excellent place to store food and cooking utensils!"]
	quest.584678F8D7970634.quest_desc: ["多方块结构组件，用于存储镕铸炉熔炼材料所需的熔岩。"]
	quest.585A89F07F3B4F2D.quest_desc: ["Klein Star Ein holds up to 50,000 EMC and is also used in the crafting of Klein Star Zwei. "]
	quest.5873CD588D98B39D.quest_desc: ["一把能造成6点伤害的剑。"]
	quest.594A3262325FDCFF.quest_desc: ["More features, and higher durability!"]
	quest.595C4352743D4003.quest_desc: ["FramedBlocks adds blocks of various shapes that can be made to look like almost any other block in the game."]
	quest.595C4352743D4003.quest_subtitle: "Framed Blocks"
	quest.59804052F93F303D.quest_desc: ["Use a binding card on an enderman or endermite."]
	quest.5999B9EFE3305FAA.quest_desc: ["一把能造成5.75点伤害的剑。"]
	quest.59B11FC479561B73.quest_desc: [
		"To get started with the Aether, you must construct a portal with a Glowstone frame and light it with a water bucket in the middle (only an iron water bucket will work), this will activate the portal and allow you to step through and enter the dimension. From here you can begin your survival in the Aether’s hostile paradise!"
		""
		"The Aether's world contains three new mysterious dungeons, each with a fearsome boss to defeat..."
		""
		"The Bronze Dungeon is the home of the Sentries and guarded by the ominous Slider, a creature born of pure stone. Look out for hidden tunnels through islands and prepare yourself with the best gear you can craft!"
		""
		"The Silver Dungeon is the beautiful Valkyrie Temple. Challenge the knights of the Valkyrie Order and, if you prove worthy, fight the Valkyrie Queen herself. Utilize every tool and trick you can to best this ancient warrior."
		""
		"Within the rare Gold Dungeon lies the Sun Spirit, an eternal being of pure fire and energy. He is the God that rules the very Sun itself and will take some convincing to even pay attention to a being such as yourself. But it is rumored he guards some of the best treasure that exists in the Aether."
	]
	quest.59B11FC479561B73.quest_subtitle: "Aether"
	quest.59B11FC479561B73.title: "Into the Aether"
	quest.59E8BA653138CD13.quest_desc: [
		"Read for all your AE2 guiding needs!"
		""
		"When using, access the sidebar on the left to find a table of contents."
		""
		"Many pages have interactive scenes. If a scene has Plus and Minus (zoom) buttons next to it, you can rotate and move the camera. Left click and drag to rotate, right click and drag to translate."
	]
	quest.5A24E9024D864081.quest_desc: ["A better version of the Inscriber - Parallel chip making."]
	quest.5A24E9024D864081.quest_subtitle: "ExtendedAE"
	quest.5A2DB13193C6A2F3.quest_desc: [
		"Through the years that botanists have been trying to figure out the magical properties of aura bearing objects, they have discovered an unexpected, yet common, theme: Gold seems to always play a role in the interaction between humans and aura."
		""
		"To get into first contact with the substance's powers, one is required to create a Brilliant Tree that will, when harvested, shed Gold Leaf - a delicate, yet powerful material. To create such a tree, simply craft a bit of Brilliant Fiber and place it into the crown of a tree. Time will then bring brilliance."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.5A3A3E5940A21D21.quest_desc: ["This is a very expensive block"]
	quest.5A42AA637D80A6B7.quest_desc: ["Blaze and Magma Cube drop."]
	quest.5A42AA637D80A6B7.quest_subtitle: "Reliquary"
	quest.5A4CD0D779A8410E.quest_desc: ["用你的新亚马龙平板电脑买卖物品！"]
	quest.5A679F29B344C3DC.quest_desc: ["Magical Seed Base is needed to make Prosperity Seed Base and Soulium Seed Base."]
	quest.5AC98773FE9B5578.quest_desc: ["能够用来种植各种作物，包括神秘农业的作物！在JEI中查看作物所需的土壤类型。"]
	quest.5AD3D5C66E7E50EC.quest_desc: ["Crafting component and energy storage item used to build and upgrade generators, energy cells, and other power-related devices."]
	quest.5AFFEFD46BEA5855.quest_desc: ["36-slot Interface – craft or export huge recipe sets in one block."]
	quest.5AFFEFD46BEA5855.quest_subtitle: "ExtendedAE"
	quest.5B2D05D4C85086DF.quest_desc: ["The most ultimate block of all the blocks"]
	quest.5B315DE5C4328B81.quest_desc: ["苹果是一种食物，玩家可以食用，也可以用来合成金苹果。"]
	quest.5B315DE5C4328B81.quest_subtitle: "Minecraft"
	quest.5B9F4455D7D8F7AD.quest_desc: [
		"To spawn a Warden, use a Sculk Core on a Sculk Shrieker to allow it to spawn a Warden (following vanilla mechanics)."
		""
		"Make a portal from reinforced deepslate, just as you would a nether portal. To activate, click with the heart (obtained by defeating a Warden)."
		""
		"Remember, reinforced deepslate can be broken, it just takes a very long time to mine! Be careful where you place your blocks!"
		""
		"Deeper and Darker adds an entire new dimension — the Otherside — with much content to explore. Here's a list with some of the features!"
		""
		"Biomes: explore the deeplands, echoing forest, overcast columns, and blooming caverns."
		"Structure: find an ancient temple, the home of the warden! Just be cautious when breaking the ancient vases to avoid awakening an ancient lurker."
		"Blocks: over a hundred new blocks to build, including  gloomslate,  sculk stone, and a new  wood type!"
		"Items: a brand-new warden set of armor and tools, an  upgrade to elytra and the awesome  sculk transmitter!"
		"Mobs: 8 new mobs, including a miniboss!"
		"To enter the Otherside, kill the warden and use its heart. Play the mod to find more content and explore hidden mysteries!"
	]
	quest.5B9F4455D7D8F7AD.quest_subtitle: "Deeper and Darker"
	quest.5B9F4455D7D8F7AD.title: "Into the Otherside"
	quest.5BC14A9F19342D22.quest_desc: ["The Harvester is a machine that will auto-harvest crops and re-plant them. Items collected by the Harvester are placed into it's internal inventory."]
	quest.5BC8BC388BCA4BA8.quest_desc: [
		"Fight the Chaos Guardian to obtain Chaos Shards, needed for crafting chaotic tier and end-game items."
		""
		"See FAQ for details on the Chaos Guardian fight."
	]
	quest.5BD8AC498C6088A9.quest_desc: ["Collects neutron piles from the air, takes a while."]
	quest.5BD8AC498C6088A9.quest_subtitle: "Avaritia"
	quest.5BE6A18FB99F6C38.quest_desc: [
		"This is a mod that adds a lot of high-tier items such as tools and armor as well as some high-tier energy storage and a lot of other random features such as:"
		""
		"- Teleportation"
		"- mob farming (spawning and killing)"
		"- player detection"
		"- Time and weather control"
		"- Powerful tools and armor"
		"- High tier energy storage (RF)"
	]
	quest.5BE6A18FB99F6C38.quest_subtitle: "Draconic Evolution"
	quest.5C0D2D1A229891FA.quest_desc: ["The Cut Paste Gadget allows you to select a large radius to cut and paste in a different location."]
	quest.5C1FC3D44F9A3628.quest_desc: ["Digitized storage. Not as good as Applied Energistics or Refined Storage, but still better than hundreds of chests littering your island."]
	quest.5C271A5D912204B4.quest_desc: ["A block that is bigger on the inside - right click the placed Hyperbox to go inside!"]
	quest.5C271A5D912204B4.quest_subtitle: "Hyperbox"
	quest.5C271A5D912204B4.title: "Compact Machines?"
	quest.5C54CFEF6CE75A7A.quest_desc: ["Components are used to craft catalysts. They get harder to craft as they move higher in tiers."]
	quest.5C968DA6DEDB805A.quest_desc: [
		"Complete this quest by successfully landing on the moon."
		""
		"Note: the moon contains Desh."
	]
	quest.5CAB7799DC531CE6.quest_desc: ["传输压力，可升级。"]
	quest.5CEF864B6400D5F1.quest_desc: [
		"手持蚕右击树叶方块以感染树叶。"
		""
		"注：用钩子破坏树叶以获取蚕——掉率为1%。"
	]
	quest.5CFAC0E0451F6ADD.quest_desc: ["The Tesseract allows you to transport Items, Fluid and Energy. Tesseracts work at any distance and even across dimensions! Use multiple channels to have different groups of Tesseracts!"]
	quest.5CFAC0E0451F6ADD.quest_subtitle: "Tesseract"
	quest.5D1A100CF3709F01.quest_desc: ["These crafting tables are used for more complex crafting recipes. Automated versions are also avaliable. See JEI for more details."]
	quest.5D378E95DFBB5DCC.quest_desc: [
		"To place your Rocket, you need 9 Rocket Launch Pads and place them in a 3x3 on the ground. Then, you just need to right click on the launch pads with your Rocket."
		""
		"Always make sure to take extra launch pads with you! They do not travel with your rocket when it takes off..."
	]
	quest.5D5354A10309133E.quest_desc: ["Alchemical Coal is a fuel added by ProjectE. It burns four times as long as regular Coal and is able to smelt 32 items. Alchemical Coal is used in the production of Mobius Fuel."]
	quest.5D554AD1078BFB44.quest_desc: ["The crafting table on a stick from Actually Additions can be used in a charm slot!"]
	quest.5D78B43DAB5756C1.quest_desc: ["清除掉落物中的多余物品（破损的盔甲、弓等等）。"]
	quest.5DD07EE53865E25C.quest_desc: ["One is all and all is one."]
	quest.5DD07EE53865E25C.quest_subtitle: "Avaritia"
	quest.5DF4D12AFAF3972E.quest_desc: [
		"Stellaris introduces an expansive and immersive space exploration experience within the familiar Minecraft universe. Players can discover new planets, moon and galaxies!"
		""
		"The rocket station will allow you to craft rockets!"
		""
		"Note: Stellaris is still on development, so things may change and there may be bugs! Don't leave anything valuable behind when you leave space - it might be destroyed by a meteor :)"
	]
	quest.5DF4D12AFAF3972E.quest_subtitle: "Stellaris"
	quest.5E2AD42305DE2B60.quest_desc: ["In strong lighting, or if placed in the nether, it will generate a passive 40 EMC per second up to a maximum of 60,000 EMC. When placed adjacent to a Energy Condenser MK1, Energy Condenser MK2, Energy Condenser MK3, Anti-Matter Relay MK1, Anti-Matter Relay MK2, or Anti-Matter Relay MK3, it will transfer the EMC into that machine. "]
	quest.5E44820EC853BAA9.quest_desc: [
		"由钻石筛网升级而来，需要一个锻造模板，可以在下界堡垒中取得。"
		""
		"随着筛网等级的改变，筛取物品的掉落也会改变，详情查看JEI。"
	]
	quest.5E4C03123DB8AB9C.quest_desc: ["Mining a Wood Block of a tree will instantly mine the whole tree. Mining leaves will mine a sphere of about 5 blocks. It uses no durability. "]
	quest.5E6CC59391F00CAA.quest_desc: ["This offers multiple saved destinations, faster teleportation, and more configuration options"]
	quest.5F0D101AFD3BCA60.quest_desc: [
		"Allows wireless access via a Wireless Terminal. Range and power usage is determined based on the number of Wireless Booster installed."
		""
		"A network can have any number of wireless access points with any number of Wireless Booster in each one, allowing you to optimize power usage and range by altering your setup."
		""
		"Requires a channel."
		""
		"Also used to bind wireless terminals."
	]
	quest.5F0F1FFB4160C1C0.quest_desc: ["This machine extracts oil from canola seeds to be used as fuel or in energy systems."]
	quest.5F20B63527ED0622.quest_desc: ["Tier 2. The only armor pieces in Draconic Evolution for 1.21.1 are the chestplates. Modules are needed to make it function, see JEI."]
	quest.5F4DAFEDC43C0964.quest_desc: [
		"用钩子钩树叶可以获取树苗和蚕（注：蚕的掉率为1%）。存在更高级的镐子，详见JEI！"
		""
		"而筛子可以用来获取资源，你需要给筛子放入筛网。"
		""
		"在筛子底部放置方向朝上的自动点击器可以自动筛矿！同样还有更好的自动化筛矿方式。"
		""
		"注：在游戏前期，建筑棒和连锁破坏是你的好帮手。将筛子摆放在一起可以同时筛矿（尝试摆成3x3的正方形吧）。"
	]
	quest.5F4DAFEDC43C0964.quest_subtitle: "Ex Deorum"
	quest.5F4DAFEDC43C0964.title: "钩子和筛子"
	quest.5F52D927648C1375.quest_desc: ["The Advanced Magnet picks up Items and Experience within a 11 block range of the player!"]
	quest.5F5BB0B31B3A1C26.quest_desc: ["Enables you to automate complex crafting recipes. Putting an inventory on top will allow it to automatically pull items into the crafting table."]
	quest.5F7BB2B66376EC4B.quest_desc: ["It can break every block including Bedrock instantly. It has a Fortune X enchantment when crafted and uses no durability. "]
	quest.5F83ADFF1BAE5088.quest_desc: [
		"钢比铁更好，同样也是推进本包进度的必须之物。"
		""
		"在沉浸工程的高炉中处理铁锭（可获得钢锭）或铁粉（可获得钢粉）即可炼钢。"
	]
	quest.5F8670CA83394E74.quest_desc: [
		"Of course, based on the world that you are currently in, the type of aura collected will slightly vary. For instance, in the normal world, aura can be gathered in the form of sunlight, while in the Nether realm, aura can be gathered in the form of ghosts, and in the End realm, aura is present in the form of an overabundance of darkness."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.5F90527709383752.quest_desc: ["Crafting Ingredient. Armor made from this material pacifies endermen."]
	quest.5F96E888408910ED.quest_desc: ["用铁桶或瓷桶盛装熔岩——要小心！瓷桶在倒出熔岩后会直接破碎。"]
	quest.5F9A5DB4144895CD.quest_desc: ["The Advanced Item Collector has a range of up to 7 blocks! Can also filter items."]
	quest.5FDDA50A827FAF75.quest_desc: [
		"Right click to instantly till dirt on the charge level (V, shift+V)."
		""
		"- 1x1"
		"- 3x3"
		"- 5x5"
	]
	quest.5FDEB6FE1138399C.quest_desc: ["Iron Jetpacks is a modern Jetpacks mod that is both feature-rich and easy to use. Jetpacks get better as you craft higher tiers. Coils are an integral part of the jetpack crafting process. See JEI."]
	quest.5FDED117D1ADCE5A.quest_desc: ["多方块机器，用于将水果蔬菜等有机物加工成乙醇，作为燃料或合成材料使用。"]
	quest.5FDED117D1ADCE5A.title: "工业发酵机"
	quest.601B16ADC17DCC07.quest_desc: ["Crafting Ingredient. Armor made from this material pacifies phantoms, piglins, and endermen."]
	quest.6039D8A09D00E4D0.quest_desc: [
		"Gold Leaf, once harvested, can easily be crushed into Gold Powder which can be placed on the ground as an integral part of the Ritual of the Forest."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.60553E95A9C0BBF4.quest_desc: ["The Builder consumes RF to construct areas in the world with blocks fed into its inventory or relocating preexisting areas. It can also clear a large area of space or break specific blocks in an area."]
	quest.6055F3B2ACE430FC.quest_desc: ["Knives are scavenging tools: they allow you to obtain a few more resources from both fauna and flora."]
	quest.60596DD8FDCEC74A.quest_desc: ["将筛网放进筛子，就可以开始筛泥土、沙砾、沙子、尘土等方块，获取多种资源了！筛网既可以放进普通筛子，也可以放进压缩筛子。"]
	quest.60B2410C50B81C1A.quest_desc: [
		"Store RF, like a battery!"
		""
		"It is a shapeless multiblock; putting a Vibrant Capacitor Bank next to another Vibrant Capacitor Bank will combine their energy storage."
	]
	quest.60F6E5AB8FBA3AD3.quest_desc: [
		"简易的原版风存储模组。"
		""
		"特色："
		"存储和合成终端"
		"存储连接器"
		"开放式存储接口"
		"无线终端"
		"可筛选的连接器"
		"存储漏斗"
	]
	quest.60F6E5AB8FBA3AD3.quest_subtitle: "Tom's Simple Storage"
	quest.60F7B6780A2BEBFC.quest_desc: [
		"To use framed blocks:"
		""
		"- Right click the block with almost any solid block to make it look alike."
		"- Right click the block with a fluid container to make it look like the fluid in the container."
		"- Right click the block with Glowstone Dust to make it produce light."
		"- Right click the block with a Framed Hammer to remove the camo."
		"- Right click the block with an empty fluid container to remove a fluid camo."
	]
	quest.6168444BBA2517D8.quest_desc: [
		"A Minecraft mod made as an add-on to both Applied Energistics 2 and ProjectE providing more tightly-coupled integration between the two mods. Unlike conventional add-ons integrating the two together, AppliedE works by turning ProjectE's EMC into a distinct \"key type\" able to be displayed, reported and manipulated by an ME network and converted into items upon request via AE2's auto-crafting facilities."
		""
		"The module retrieves all transmutation/EMC knowledge from the player who placed down the module to provide ME networks with information on stored EMC and transmutable items. It can be placed anywhere at all on the network to function."
		""
		"&4Note: Some players may experience tps lag when using this with many EMC items.&r"
	]
	quest.6168444BBA2517D8.quest_subtitle: "AppliedE"
	quest.6168444BBA2517D8.title: "ME Transmutation"
	quest.61777EB299FB94E0.quest_desc: ["Made of 10,000 lapis"]
	quest.618D53FB7973A7A1.quest_desc: ["To create Fuel, you need to input oil in the first slot. It will then generate fuel that you can get by putting a bucket in the last slot. You can also use the EnderIO Vat - it's a lot less buggy."]
	quest.61CFDD199E014C42.quest_desc: ["Prevents certain passive mobs from spawning, large radius"]
	quest.61F806630090ECEC.quest_desc: ["Found on End City ships."]
	quest.6220ED19B826E0CB.quest_desc: ["The Farmer is a machine for automatically growing and harvesting crops."]
	quest.6220ED19B826E0CB.quest_subtitle: "Mystical Automation"
	quest.6246EBDEE4DE4F18.quest_desc: [
		"The Natural Altar can be useful for infusing certain items with the power of aura, however, it can also assist in transmuting items from one type into another. This can be achieved by creating the Transmutation Catalyst and placing it on top of any of the four lower Golden Stone Brick blocks around the altar, and then placing the ingredient on the altar as usual."
		""
		"See JEI for a full list of uses."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.6276DB533F7033DB.quest_desc: ["Crafting component and energy storage item used to build and upgrade generators, energy cells, and other power-related devices."]
	quest.62896E7E2DBD777F.quest_desc: ["A powerful crafting ingredient used for high tier and endgame items"]
	quest.6289D3973C5F61B3.quest_desc: ["Connect a drawer with the max storage upgrade to your applied energistics system and fill it up with cobblestone."]
	quest.6299CB158A777246.quest_desc: ["Consumes nearby leaves and turns them into power."]
	quest.62C53D877A059585.quest_desc: ["All fluids piped into here will be voided."]
	quest.62D5202491593442.quest_desc: [
		"用木桶收集雨水，或者将树苗或树叶放进木坩埚内，可以生成水。"
		""
		"木桶非常实用，可以用来制造泥土、黏土、灵魂沙、粘液块等方块！你也可以制作石桶，详见JEI。"
	]
	quest.62D5202491593442.quest_subtitle: "Ex Deorum"
	quest.62D5202491593442.title: "木桶和木坩埚"
	quest.633CEC0C789695E7.quest_desc: ["自动化刷怪的好开始！再也不用亲自站在那儿打怪了。"]
	quest.633CEC0C789695E7.quest_subtitle: "Spiky Spikes"
	quest.6349016135BBD0AC.quest_desc: [
		"高级升级新增的功能有：过滤模式和过滤器。"
		""
		"升级是一种能够对管道进行增强的物品，可以提升管道的传输速度、效率，或是加入新的功能，例如过滤和堆叠。"
	]
	quest.634E83DDF2911DFD.quest_desc: ["Casings are both decorative and functional blocks used to craft and build various machines and devices within the mod."]
	quest.6353A39C04EF7F7D.quest_desc: ["A card used to control which items, fluids, or energies are allowed to pass through a Laser Node connection."]
	quest.63588316070C73FD.quest_desc: ["Even with the dark matter armor, you can still take a noticeable amount of damage when things start getting hairy. You decide to try throwing some red matter at the problem like any good alchemist, and find that this new Red Matter Armor blocks so much incoming damage you can't even feel anything apart from the actual kinetic energy pushing you around. But... Maybe you can go even one step further?"]
	quest.639103C33226046A.quest_desc: ["Knives are also useful for cutting and portioning ingredients when preparing meals"]
	quest.639219AA32B76CE6.quest_desc: ["Augments are used to add new capabilities to Essence Tools and Essence Armor."]
	quest.63B25E731B126624.quest_desc: ["[ \"Must complete the quest \", { \"text\": \"Ender Inhibitor Active\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"097B7BF8B0CBC549\" } }, \" to unlock.\" ]"]
	quest.63B25E731B126624.quest_subtitle: "5 Coins"
	quest.63B25E731B126624.title: "Uncommon Reward Bag"
	quest.63B5756032EE8F24.quest_desc: ["Much faster than a neutron collector!"]
	quest.63B5756032EE8F24.quest_subtitle: "Mystical Agriculture"
	quest.63D6C13107194725.quest_desc: ["Found on End City ships."]
	quest.63F031C92B77E04E.quest_desc: ["The most ultimate ingot out of all the ingots"]
	quest.6402BA4DBC3774E2.quest_desc: [
		"To use framed blocks:"
		""
		"- Right click the block with almost any solid block to make it look alike."
		"- Right click the block with a fluid container to make it look like the fluid in the container."
		"- Right click the block with Glowstone Dust to make it produce light."
		"- Right click the block with a Framed Hammer to remove the camo."
		"- Right click the block with an empty fluid container to remove a fluid camo."
	]
	quest.641393B3F9C6B8FF.quest_desc: ["Filters can be used in Ender IO conduits. More are avaliable, see JEI."]
	quest.641393B3F9C6B8FF.title: "Conduits - Filters"
	quest.6451FD7185BFE271.quest_desc: ["Tier 3. The only armor pieces in Draconic Evolution for 1.21.1 are the chestplates. Modules are needed to make it function, see JEI."]
	quest.64A4DB89F0523BDF.quest_desc: ["Using a simple cooking system and a few familiar ingredients, Farmer's Delight lets you be able to prepare a wide variety of hearty meals: from sandwiches to salads and stews, from beautiful desserts to mouth-watering feasts, no ingredient will be left behind in your kitchen!"]
	quest.64A4DB89F0523BDF.quest_subtitle: "农夫乐事"
	quest.64C55F0D348097E7.quest_desc: [
		"A rudimentary, yet effective way of collecting aura early on is the Natural Altar$. After creating the multiblock setup shown in the guidebook, the altar will start slowly draining aura in the vicinity. However, it is not strong enough to cause major damage, making it only drain until there is none left in the area. The collected aura can then be used in recipes, see JEI."
		""
		"Golden Stone Bricks are used in the Natural Altar's multiblock. Alternatively, Golden Nether Bricks can be used in a similar fashion."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.64D345ED39C8AF6E.quest_desc: [
		"由燧石筛网升级而来。"
		""
		"随着筛网等级的改变，筛取物品的掉落也会改变，详情查看JEI。"
	]
	quest.650B9EB6E578026C.quest_desc: [
		"Crafting co-processors make the system send out ingredient batches from ME Pattern Providers more often by making the CPU tick faster. This allows them to keep up with machines that process quickly. An example of this is a pattern provider surrounded by Molecular Assemblers being able to push ingredients faster than a single assembler can process, and thus distributing the ingredient batches between the surrounding assemblers."
		""
		"Some complex recipes have multiple steps that can be done in parallel, like making planks and books simultaneously for making bookshelves. In the crafting status screen (visible by right clicking a CPU or with the hammer icon in a terminal), these steps will all show up as \"scheduled\". Each extra coprocessor allows one more of these steps to be done in parallel (and thus show up as \"crafting\"). However, this is not as relevant because you'll typically have more coprocessors purely for the insertion speed than a recipe has steps that could conceivably be done in parallel."
	]
	quest.6525B48ED37B4C90.quest_desc: [
		"Nature's Compass is a utility item that allows you to search for a biome's location anywhere in the world and view information about it"
		""
		"Explorer's Compass is an item that allows you to locate structures anywhere in the world."
	]
	quest.6525B48ED37B4C90.title: "Special Compass"
	quest.653BE210E0487B58.quest_desc: ["Used to increase the range of the wireless access point."]
	quest.654DD2C672816436.quest_desc: ["Too lazy to cook on the stove? Try this new invention - the microwave!"]
	quest.6584CD710EFC59ED.quest_desc: ["黑曜石箱子由钻石箱子升级而来。虽然容量没有变化，但它能够抵御爆炸！"]
	quest.65B7E98FC7D9ADBE.quest_desc: ["It can mine all blocks a normal shovel can mine instantly. It uses no durability."]
	quest.664982C92C008BF9.quest_desc: ["Your basic terminal, now portable! View and access the contents of your network's storage and request things from your autocrafting setup from anywhere within the range of a ME Wireless Access Point."]
	quest.6649913A78D19083.quest_desc: ["游戏后期会有更好的制作板子的方式，但在前期，最好的方式就是用工程师锤。"]
	quest.664FCA66D021E5EB.quest_desc: [
		"Years after their original inception, magical botanists have finally found a new material able to harness the powers of aura through new means: the mystical and elusive )Netherite. With it, one can create a most powerful material: Ingots of the Depths. These ingots, as expected, can also be turned into armor and tools."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.665A140AE9AFDEDD.quest_desc: ["高级合成材料，常用于机器，工具，以及模组内高阶科技的合成配方。"]
	quest.665EBED00E67F718.quest_desc: ["Crafting component. Maximum tier (tears?). If you have difficulty with the Chaos Guardian fight, check out the FAQ page of this quest book, there is a section on the Chaos Guardian."]
	quest.6687B589680663C6.quest_desc: ["Craft a stack of Demon Steel Tier 4 (remember, no EMC at all in the process)."]
	quest.669CFE3A168C0788.quest_desc: ["The Exchanging Gadget provides basic exchanging abilities using a set of different Exchanging Modes."]
	quest.66C4AAA972B39531.quest_desc: ["Trust me, this will make your life a lot easier (if you are playing normal mode...)"]
	quest.66C4AAA972B39531.quest_subtitle: "Mystical Agriculture"
	quest.67165901C0E6C509.quest_desc: ["Crafting ingredient needed to make recipe holders and encoders."]
	quest.672951246DF850D1.quest_desc: ["Ice shards are found on cold moons and planets."]
	quest.672B673A2F199A90.quest_desc: ["All Rotspawn drop utheric shards when killed."]
	quest.67684E03885EB857.quest_desc: ["这些方块可以放入压缩筛子进行筛矿，获取资源。"]
	quest.67684E03885EB857.title: "压缩筛矿"
	quest.678ACA1FAD9052E4.quest_desc: ["Generates power from radioactive materials."]
	quest.67A73C10038C9156.quest_desc: ["Uses solar power (sun) to generate RF. Tier 7!"]
	quest.67E4375F1DD59AA0.quest_desc: ["Faster conduits!"]
	quest.67E4375F1DD59AA0.title: "Conduits - Tier 2"
	quest.67F1A287CB30DC14.quest_desc: ["Any animals you slay using a Knife are guaranteed to drop secondary items, such as Leather and Feathers"]
	quest.67FC751E0E5E8451.quest_desc: ["Drops from Stalkers, which can be found in Ancient Temples."]
	quest.68409C310D6932AC.quest_desc: ["Augments are upgrade items that enhance modules through speed, range, and filtering."]
	quest.6857B9C8DAC7D126.quest_desc: [
		"Together with the ritual, knowledge of Tokens can be gained: Wooden figurines, depicting key emotions - created from trees infused with their respective symbols. These figurines contain a combination of the vast power of aura itself and the power of the emotions they represent. Going forward, these Tokens will be a key construction ingredient."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.6857B9C8DAC7D126.title: "More Tokens"
	quest.68A17A4E8C8EA5D9.quest_desc: ["A lilypad that makes nearby crops grow faster and that can be put side by side with other lilypads for even greated effect"]
	quest.68AD773B1A241E01.quest_desc: ["Crafted using the Atomic Reconstructor. See JEI."]
	quest.68AD773B1A241E01.title: "Crystals"
	quest.68B8F9FF9F45348B.quest_desc: ["The fury of the universe in the palm of your hand."]
	quest.68C53139E1D36746.quest_desc: ["Grants infinite souls from all creatures."]
	quest.68D850868C481078.quest_desc: ["升级版电子元件。在专家模式中制作复杂机械和搭建电力系统的必要组件。但在普通模式，它只用于合成化学溶解室和一些沉浸工程后期的器件。"]
	quest.68E1372233643800.quest_desc: [
		"When working with aura, sometimes it can be beneficial to know about its levels in an area without having to be there to check in person. The $Aura Detector gives out a redstone signal based on the amount of in the close vicinity around it, so long as you attach a Comparator to it. For that, its range of display is similar to that of the Environmental Eye."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.68FE2BEC3C90AFFD.quest_desc: [
		"The Card Holder is a portable storage item that holds multiple LaserIO cards for easy management and swapping between nodes."
		""
		"Cards are upgradeable components inserted into Laser Nodes to define how they transfer items, fluids, energy, or redstone."
	]
	quest.6920EAFAB5BDA9FE.quest_desc: [
		"Place one pattern holder in a Packager, and the other in an Unpackager, both connected to a ME Network. "
		""
		"The Packager will accept items and make them into Recipe Packages and the Unpackager will take them and output items into an adjacent inventory. "
		""
		"Both machines tell the ME Network what it can do according to the pattern holder, and the Packager, when connected, ejects packages into the network"
	]
	quest.693C2DD84D42166A.quest_desc: ["Upgrades for Ex Machinis machines. Hold shift while hovering over the upgrade to see its effects."]
	quest.694EEC7F7A1378D8.quest_desc: [
		"Having a Natural Altar around that stores aura is all well and good, but it would be more convenient to be able to carry it around. In that case, the Aura Cache will prove useful: It stores a substantial amount of aura in it so one can use it on the go. To fill the cache up, simply place it on a Natural Altar and wait for the aura to drain into it."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.6960CFAA0006178F.quest_desc: [
		"Mob Flow Utilities是一个模块化的自动化模组，着力于通过定向流动控制，集中处死系统，以及智能物品收集来提高刷怪场效率。设计清爽，UI简洁，视觉反馈良好。"
		""
		"流动板："
		"- 定向移动：将生物和物品推向指定的方向"
		"- 三种速度等级：快速、高速、极速，满足各种需要"
		"- 可含水：无缝兼容各种水流刷怪场"
		"- 无需配置：流动方向由放置时的方向决定"
	]
	quest.6960CFAA0006178F.quest_subtitle: "Mob Flow Utilities"
	quest.696A38C5D80A2CDC.quest_desc: [
		"筛泥土或潜行右击地面可以得到石子。"
		""
		"将鼠标移动至你收集的石子，按下快捷键\"shift\"+\"k\"可以将它们自动合成圆石！"
	]
	quest.696A38C5D80A2CDC.quest_subtitle: "Ex Deorum"
	quest.69C8C3F25F60409F.quest_desc: ["增加吸收漏斗对物品及经验的吸收范围。"]
	quest.69D590FA274E2B41.quest_desc: [
		"Place the Flux Crafter in-world and right-click to view the GUI. Inside there's a 3x3 crafting grid, similar to a Crafting Table. Place your recipe ingredients into the grid."
		""
		"If the recipe is correct, the Flux Crafter should start to take energy from all (powered) Flux Alternators placed within a 4 block radius. You can tell if they're working if they are emitting particle effects.\"Used to craft components for more complex recipes. Requires at least one flux powered alternator placed near the crafter."
	]
	quest.69D590FA274E2B41.quest_subtitle: "Extended Crafting"
	quest.69FEA176E2A431B2.quest_desc: ["Catalysts are used in complex crafting recipes. They get harder to craft as they move higher in tiers."]
	quest.6A0BCEEBEAD7BAAC.quest_desc: ["Carminite is an item that is used for various crafting recipies. Carminite is a special item that can be found in a chest after slaying a Ur-Ghast or by crafting it."]
	quest.6A124FD18647572F.quest_desc: ["Sometimes, building large structures can be a little tedious, and take a lot of effort. Not all of us are great builders you know! Dire's Building Gadgets aims to make building a little bit easier."]
	quest.6A124FD18647572F.quest_subtitle: "Building Gadgets"
	quest.6A174FEBD2766C23.quest_desc: ["Cook bread again to make it toast - yum!"]
	quest.6A3BC809F00251A2.quest_desc: ["A powerful sword in it's own right by charging it and using activating it (C) the Red Matter Sword will consume EMC in exchange for a devastating sweep attack. The area of the attack is controlled by charge level (V, shift+V)."]
	quest.6A3D025A3018689B.quest_desc: ["Made of 10,000 electrum ingots"]
	quest.6A7C4E246A8EE29C.quest_desc: ["Generates loot from neural networks data models."]
	quest.6A82289C0937E69B.quest_desc: ["An upgraded version that processes two items at once for faster resource production."]
	quest.6AFF4DCE31DDCD21.quest_desc: ["手持工具右击控制器以开始配置，然后右击范围内（默认8格）的普通/压缩/末影抽屉，即可将其链接到你的控制器上。"]
	quest.6B205B114E270C9F.quest_desc: [
		"Creative Essense is the base material for all creative items."
		""
		"Before you can craft creative items, you must finish the quest chapter associated with the mod that the item belongs to."
	]
	quest.6B2C7902C393895B.quest_desc: ["Makes your rocket look like a normal rocket!"]
	quest.6B2F0714255943B6.quest_desc: ["[ \"Must complete the quest \", { \"text\": \"Visit Mercury\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"14F9F9F05968992D\" } }, \" to unlock.\" ]"]
	quest.6B2F0714255943B6.quest_subtitle: "20 Coins"
	quest.6B2F0714255943B6.title: "Legendary Reward Bag"
	quest.6B549E0874E32E16.quest_desc: ["Catalysts are used in complex crafting recipes. They get harder to craft as they move higher in tiers."]
	quest.6BBEA10C1DF18B20.quest_desc: [
		"Use a binding card on an enderman or endermite."
		""
		"Link with a player across dimensions!"
	]
	quest.6BC5D6D133C3F0A0.quest_desc: ["Upgrades for Ex Machinis machines. Hold shift while hovering over the upgrade to see its effects."]
	quest.6BCDDE81CC8A2A67.quest_desc: ["Made up of 729 cobblestone!"]
	quest.6C1BC64337960BA4.quest_desc: ["Machine frames are needed to make all Industrial Foregoing (and some other) machines."]
	quest.6C1D7C9A68FBB65D.quest_desc: ["A creative-tier upgrade that provides infinite access to the stored item in a drawer without consuming the original stack."]
	quest.6C647123A99A46DD.quest_desc: ["This block generator has a speed of 8"]
	quest.6C682E372AB94474.quest_desc: ["Max Blocks: 27"]
	quest.6C71752F5F9B7222.quest_desc: ["和木桶差不多，但是这个桶可以盛熔岩等热流体。"]
	quest.6C931BB4213DC381.quest_desc: ["This block generator has a speed of 16"]
	quest.6D1640B0CC4ADAF6.quest_desc: [
		"特色："
		""
		"- 多方块构建：使用砖块、储罐、排液孔和视窗搭建你自己的镕铸炉，打造功能完备的熔炼体系。"
		"- 高效熔炼：镕铸炉的熔炼速度比传统熔炉更快，还可以同时处理多种矿石，用更少的燃料产出更多矿锭。"
		"- 铸造：铸造系统是镕铸炉的特色，你可以将熔融金属灌入铸模，浇筑成锭、块或其他金属物品，为制作和资源管理增添新层次。"
		"- 客制化设计：镕铸炉的大小和布局可以自由搭配。所有镕铸炉方块都支持16种染料颜色，以更好地点缀你的基地。"
	]
	quest.6D16777C65BCA017.quest_desc: [
		"精妙背包，又一个背包模组。这个模组的背包可以放置在地上，染上不同颜色，通过升级变得更大，还能插入各种功能各异的升级。"
		""
		"你可以按快捷键打开背包（默认按B键）。"
		""
		"兼容饰品槽，你可以将背包放在“背部”（“Back”）槽，让你的人物背上背包。"
		""
		"每次升级都会增加存储空间以及升级槽位。"
	]
	quest.6D16777C65BCA017.quest_subtitle: "Sophisticated Backpacks"
	quest.6D594671ED743839.quest_desc: ["Control circuits are used to craft several Mekanism items and machines. Tier 4."]
	quest.6D73A75D85AB43AE.quest_desc: [
		"Using the power of Red Matter to combine the functions of the Red Matter Hammer, Red Matter Pickaxe, and Red Matter Shovel into a single tool. "
		""
		"The Red Morningstar can quickly harvest most blocks under the ground (left click). "
		""
		"Like the Red Matter Pickaxe it can harvest a whole vein of ore in a single action (right click). "
		""
		"Like the Red Matter Hammer it can harvest all blocks in an area based on the charge level. "
		""
		"Like the Red Matter Shovel it will harvest a large area of dirt based on charge or a whole vein of gravel."
	]
	quest.6D73B59E96D6C032.quest_desc: ["Slay a cow and cook its meat to obtain steak"]
	quest.6D73B59E96D6C032.quest_subtitle: "Minecraft"
	quest.6DA1F71A6E40CF8B.quest_desc: ["Using a simple cooking system and a few familiar ingredients, Farmer's Delight lets you be able to prepare a wide variety of hearty meals: from sandwiches to salads and stews, from beautiful desserts to mouth-watering feasts, no ingredient will be left behind in your kitchen!"]
	quest.6DB5CEA763B4C3F6.quest_desc: ["Upgraded machine frames are crafted using the Dissolution Chamber. See JEI."]
	quest.6E03872B3136B79B.quest_desc: ["沉浸工程多方块机器，以3x3x3形式搭建，并在顶部放置漏斗，手持工程师锤右击中心即可形成多方块结构。用法和高炉一样，但性能更好！详情查阅工程师手册和JEI。"]
	quest.6E03872B3136B79B.title: "改良高炉"
	quest.6E0D7B1A597E170E.quest_desc: ["Burns canola oil and turns it into power."]
	quest.6E485E15CB87CDC2.quest_desc: ["Made up of 6561 cobblestone!"]
	quest.6EC8C1F16B88307A.quest_desc: ["Klein Star Omega holds up to 51,200,000 EMC and is also used in the crafting of top-tier EMC seeds."]
	quest.6EC90676B0EEB012.quest_desc: ["A rare gem, found only via mining in the sky islands of the Aether."]
	quest.6EEEDDEA96985BA2.quest_desc: ["The Basic Item Collector has a range of up to 5 blocks!"]
	quest.6EF67A87979A9378.quest_desc: ["Can create portals between different locations. Works across dimensions!"]
	quest.6F68D029D176C4FC.quest_desc: [
		"Infused Iron is good and well, and it has enough natural power to do a variety of things on its own. But for more advanced mechanisms, a more powerful metal is required. For that, and for a lot of other things, the Offering to the Gods is required. The Gods have been, for a long time, the strongest and most powerful beings, and as such, also posess the strongest metals known to man."
		""
		"To construct a way to call to the Gods themselves, simply place down an Offering Table with some flowers around it as depicted in the guidebook. Then, to start an offering, place any amount of items you want to offer into the bowl on the table, and then throw down the item that will call the Gods themselves, in most cases, the Spirit of Calling, close to the table. The requested items will then, with any luck, rain down from the sky."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.6F96B0AF183634BE.quest_desc: ["Made of 10,000 nickel ingots"]
	quest.6FA5A509D5C50572.quest_desc: ["These crafting tables are used for more complex crafting recipes. Automated versions are also avaliable. See JEI for more details."]
	quest.701351A41247EC15.quest_desc: ["在鸡上使用可以制造一个腐烂鸡蛋。在5x5的泥土中央使用以创造一片诅咒之土（无光照时生成敌对生物）。"]
	quest.701D82D7BB8B6812.quest_desc: [
		"使用该手册查看沉浸工程模组中多方块结构的搭建方法。"
		""
		"沉浸工程是一款受现实启发的科技模组："
		"该模组不使用那些发光的红色管道，而是使用真实悬挂着的电线。"
		"该模组不使用能够魔法般地将矿石变成矿粉的单方块机器，而是使用一台大型多方块粉碎机（5x3x3），使用大型粉碎轮粉碎矿石，喷出矿粉。"
		"该模组不使用将电力转化为魔法光束和矿石的激光，而是使用另一台资源密集型大型多方块结构（3x7x8）——挖掘机，用旋转着的大型斗轮将矿物从地下开采出来。"
		""
		"沉浸工程让科技模组更加平衡，更具美感。没有采用冰冷的未来风白+灰管道，而是融入了独具特色的复古未来主义设计风格（就像生化奇兵、教团：1886、天空上尉与明日世界那样）。"
		""
		"和几乎所有科技模组一样，它使用Forge Energy API，但它完全可以独立游玩。和其他模组不同的是，沉浸工程不用一排排方块来传输能量，而是在接线器间连接电线输电。"
		""
		"该模组的特色发电方式有水车、风车、生物柴油等等，许多机器都是多方块结构！"
	]
	quest.701D82D7BB8B6812.quest_subtitle: "Immersive Engineering"
	quest.707FCC07A558D9C6.quest_desc: ["利用相邻方块的温差（例如冰和熔岩）被动发电。"]
	quest.709AE9E272CD7894.quest_desc: ["Upgraded machine frames are crafted using the Dissolution Chamber. See JEI.. Requires Ether Gas, harvested from a wither using a fluid laser."]
	quest.70A8E4AE5CBA60D7.quest_desc: [
		"To use framed blocks:"
		""
		"- Right click the block with almost any solid block to make it look alike."
		"- Right click the block with a fluid container to make it look like the fluid in the container."
		"- Right click the block with Glowstone Dust to make it produce light."
		"- Right click the block with a Framed Hammer to remove the camo."
		"- Right click the block with an empty fluid container to remove a fluid camo."
	]
	quest.70C9EAA003A86448.quest_desc: ["Made up of the most expensive ingot in the game. Maybe not the best choice for building."]
	quest.70D9A79728CFE5F4.quest_desc: ["More complex crafting ingredients than the prosperity shard, needed to progress in Mystical Agriculture."]
	quest.70D9A79728CFE5F4.title: "Gemstone and Ingot"
	quest.70FCC2680E0A8B96.quest_desc: [
		"The base material for Mekanism."
		""
		"Here at Mekanism, Inc., we bring you a suite of low, mid, and high tier machinery to elevate your archaic home and inefficient resource processing to the 21st century. With our collection of high-tech tools, high-end energy generators, advanced transmission systems and intricate processing mechanisms, you’ll find yourself relieved of the tedious tasks of ‘mining’ and ‘crafting’ and quickly progressing to new levels of technological enlightenment."
		""
		"You may not realize it, but every time you smelt an ore directly into its respective ingot, you’re wasting the majority of what you’ve mined. Mekanism’s team of experienced chemical and mechanical engineers have developed advanced ore processing machinery to extract resources from ores with utmost efficiency. With our purification, dissolution, chemical injection, and crystallization technologies, you can now double, triple, quadruple, even quintuple your ingot production per ore, given enough infrastructure and energy."
		""
		"Our engineering team understands and embraces gradual technological progression. For whatever stage of gameplay you’ve reached, we offer a tier of machinery to suit your needs. Every Mekanism machine can be upgraded to a factory, allowing you to process, 3 (basic), 5 (advanced), 7 (elite), or even 9 (ultimate) different items at once -- in a single machine! No more are the rows, even walls of slow and ugly furnaces that once plagued your home. Condense your machinery infrastructure with Mekanism today."
	]
	quest.70FCC2680E0A8B96.quest_subtitle: "Mekanism"
	quest.7105D5D0A4CAABA2.quest_desc: [
		"The Infusion Altar is the core component of the multi-block Infusion crafting structure. Along with Infusion Pedestals, the altar is mainly used to craft Resource Seeds and Augments. See JEI for uses."
		""
		"To use the Infusion Altar, you must first place it down in the world. Make sure the surrounding area is clear of obstructions. Then, you must place Infusion Pedestals around the altar. The altar will show ghost pedestals in the world, indicating where you must place the pedestals."
		""
		"Once your altar is set up, you can place items on the altar and pedestals by right-clicking on them with an item in hand."
		""
		"To activate the altar you can provide the altar with a Redstone signal (ex. button, lever)."
	]
	quest.71104655F18FBDB1.quest_desc: ["Crafting component and energy storage item used to build and upgrade generators, energy cells, and other power-related devices."]
	quest.712D46C093C92BA7.quest_desc: ["A highly advanced multiblock structure that generates massive amounts of RF energy but requires careful management to prevent catastrophic explosions."]
	quest.712D46C093C92BA7.title: "Draconic Reactor"
	quest.7139AC799DC225FA.quest_desc: ["每次升级都会增加存储空间以及升级槽位。"]
	quest.714DD2BC87D5A3A8.quest_desc: ["用钩子破坏被感染的树叶就可以得到线！"]
	quest.71985D320264CC4B.quest_desc: ["如何更改纹理：在合成网格内，第一个槽位放置用于定义抽屉外部纹理的方块，第二个槽位放置用于定义抽屉内部纹理的方块，第三个槽位放置镶框抽屉。你还可以在第四个槽位放置用于定义抽屉隔板纹理的方块。"]
	quest.71C5B72891529DDB.quest_desc: ["Special apples that give different buffs! Hold shift while hovering over the apple to see its effects."]
	quest.71E75FEACF764F83.quest_desc: [
		"Together with the ritual, knowledge of Tokens can be gained: Wooden figurines, depicting key emotions - created from trees infused with their respective symbols. These figurines contain a combination of the vast power of aura itself and the power of the emotions they represent. Going forward, these Tokens will be a key construction ingredient."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.71E75FEACF764F83.title: "Fear and Sorrow"
	quest.72353D397FFE788A.quest_desc: ["Made of 10,000 bronze ingots"]
	quest.7267D02BE7F9E8B7.quest_desc: [
		"Can be used in an accumulator to rapidly create Sal Ammoniac to be used as a solvent."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.72744CCF4110F9DD.quest_desc: [
		"Ender IO machines that have an upgrade slot require capacitors to function."
		""
		"Depending on their Base Modifier, Capacitors can increase the Speed, Range or Energy Storage of machines."
		""
		"Level: 5"
	]
	quest.727C435CCD8998A1.quest_desc: ["Use the Atomic Reconstructor to turn minerals into powerful crystals that allow the creation of useful machines for processing and sorting items, lasers for wirelessly transporting energy, items and fluids, renewable oil to generate power, and much more."]
	quest.7284146C05F63CB7.quest_desc: ["The Quantum Entangloporter from Mekanism is a machine that allows liquids/items/energy/gas to be sent from one Quantum Entangloporter to another through a channel."]
	quest.7284146C05F63CB7.quest_subtitle: "Mekanism"
	quest.72A28DEFA6AC4A0F.quest_desc: ["This machine serves two functions. Firstly, any item placed into its inventory will be converted into EMC. Secondly, it transfers energy from Energy Collectors to Energy Condensers. When transferring, it gives a small, 1 EMC per second bonus. It is also used to charge the Klein Star series with EMC. "]
	quest.72B11DB251170E68.quest_desc: ["Crafting component. Upgradable to next tier, see JEI."]
	quest.72C6F582DAA81CBF.quest_desc: ["多方块机器，使用电力及各种模具加工金属锭和其他材料，将其塑造成板材、金属棒、齿轮等等。"]
	quest.72C6F582DAA81CBF.title: "金属冲压机"
	quest.731CFBA9CEF27A6A.quest_desc: [
		"欢迎来到Ozone Skyblock Reborn 2，一款由MuggleOrWizard制作的专家包！本包是Ozone Skyblock Reborn系列的续作。如果你在游玩过程中想要提出建议或遇到了某些问题，欢迎在项目页面中留下评论，或是在Curseforge给我发送消息，也可以加入Discord服务器进行反馈。"
		""
		"如果你正在多人世界中游玩，可以执行指令\"&b/skyblock gui&r\"来建立团队并创建岛屿。在物品栏开启时点击屏幕左上角的队伍图标，可以建立或加入队伍，共享认领区块和任务进度。任务也可以从物品栏界面屏幕左上角点击查看。"
		""
		"&4阅读带有红心图标的任务可以了解本整合包的不同模式！&r"
		""
		"&2这个整合包系列的灵感源自于TheCazadorSniper的\"Project Ozone\"系列。如果你还没玩过，我强烈推荐你看一看——在Curseforge上就可以找到。&r"
		""
		"部分任务描述中可能包含取自或修改自模组项目页面、wiki或游戏内指引书中的信息。版权归属于对应模组及wiki作者。想要了解更多关于某个模组的信息，访问Ozone Skyblock Reborn 2项目页面，浏览模组列表，然后点击你想要了解的模组即可。"
	]
	quest.731CFBA9CEF27A6A.quest_subtitle: "阅读后打钩！"
	quest.732A662662650FD1.quest_desc: ["The Infusion Altarnator is a single-block automatable version of the Infusion Altar."]
	quest.732A662662650FD1.quest_subtitle: "Mystical Automation"
	quest.735C3B21ACEECB35.quest_desc: [
		"There are six tiers of seeds in Mystical Agricuture."
		""
		"Tier 6 seeds require insanium essence to craft and a corresponding crux in order to grow."
	]
	quest.736D8DE746E2BC8D.quest_desc: ["Use in an infuser to craft or infuse various items."]
	quest.737DDA1BE324E0ED.quest_desc: ["This block generator has a speed of 4"]
	quest.737F70A6CF790A64.quest_desc: ["A simple generator from coal or charcoal"]
	quest.737F70A6CF790A64.quest_subtitle: "RF Tools"
	quest.738F83FF42EC9E08.quest_desc: ["Generates power from coal and other burnable materials."]
	quest.7398BF7730A7D6FF.quest_desc: ["Crafted using the energizing orb. Used for creating items for wireless power transport, see JEI."]
	quest.739E1E96A6CE1DE8.quest_desc: ["右击加压！"]
	quest.73EFC7030BF6A7DE.quest_desc: ["在压力室中用塑料片制作。"]
	quest.740583FBFABFEC87.quest_desc: [
		"The SAG Mill uses power to grind (or mill) items into their crushed variants, like Ores into Dusts. The SAG Mill has four output slots; recipes can have 1-4 different outputs, with different chances of obtaining those outputs."
		""
		"Uniquely, the SAG Mill can use Grinding Balls made from various materials to increase energy efficiency (resulting in higher processing speed), increase bonus output chances, and add a chance to double all output. This makes the SAG Mill a popular option for ore processing, especially for ores with desirable bonus outputs. "
	]
	quest.74353DACE7BECFB0.quest_desc: ["Desh can be found on the moon."]
	quest.74795B5D24F8B27F.quest_desc: ["和存储终端类似，但多了一个合成界面。"]
	quest.749846E05249E17D.quest_desc: [
		"这个扳手能够用来调整pipez模组的管道，随着进一步发展还将解锁更多类型的管道供你选择。"
		""
		"Pipez模组添加了一些简便且可任意调整的管道，同时还具有可高度配置的过滤系统和各种升级。同时还使用了Pretty x Smart Pipez资源包！"
		""
		"注：大量的pipez管道可能会使同一世界内部分玩家的TPS降低！"
	]
	quest.749846E05249E17D.quest_subtitle: "Pipez"
	quest.749E64CD1E5C5529.quest_desc: ["Made of 10,000 silver ingots"]
	quest.74F53C25C2448D66.quest_desc: ["If you want to go beyond the 8 channel limit or you want to connect multiple distinct networks you can make a 'routing network' using routers. A single router is already sufficient to connect up to six (six sides of the router) channels but using routing cables and routing connectors you can also make a routing network out of routers. Note that on a single routing network you can only have 32 published channels."]
	quest.75399B382F21F8D9.quest_desc: ["Automate at least 20 different Mystical Agriculture crops with max growth accelerators (planting, harvesting, compressing, storing)."]
	quest.753C66ACDDE9F171.quest_desc: [
		"Ender IO machines that have an upgrade slot require capacitors to function."
		""
		"Depending on their Base Modifier, Capacitors can increase the Speed, Range or Energy Storage of machines."
		""
		"Level: 9"
	]
	quest.75672DB7BA4D3F9C.quest_desc: ["Used to craft player transmitter."]
	quest.75748983DF84E9AF.quest_desc: ["Uses heat sources and coolant to generate RF."]
	quest.757EE53215AB84B7.quest_desc: [
		"The Alloy Smelter uses power to both smelt items and to create alloys like Dark Steel. The Alloy Smelter has three input slots and one output slot."
		""
		"It has a \"Furnace Mode\" button in the bottom-right corner with three different options:"
		""
		"- Furnace Only: the Alloy Smelter will only smelt Furnace recipes."
		"- Alloys Only: the Alloy Smelter will only create alloys."
		"- All Smelting: the Alloy Smelter will both smelt Furnace recipes and create alloys."
		""
		"By default, the machine is capable of producing alloys from some other mods as well as Ender IO alloys."
		""
		"Ender IO is a full-featured tech mod. It has armor, tools, weapons, machines, conduits, inventory management, mobs, etc."
		""
		"&4Ender IO is currently in Beta and is being rewritten from the ground up for the latest version of Minecraft. As such, some features have not yet been ported, and bugs may be present.&r"
	]
	quest.7580866D67B0614F.quest_desc: ["Made of 10,000 platinum ingots"]
	quest.758C366E1C73F7D3.quest_desc: ["蜘蛛眼是一种有毒食品，可以用来酿药，还可以用来吸引并繁殖犰狳。通常由蜘蛛、洞穴蜘蛛以及女巫掉落。"]
	quest.75A9DCE3CFFAF413.quest_desc: ["Hold shift key when hovering over the item to see stats."]
	quest.75AD65B7786D4698.quest_desc: ["Max Blocks: 1024"]
	quest.75CDC6EFC1F77557.quest_desc: ["Slay a pig and cook its meat to obtain porkchop"]
	quest.75CDC6EFC1F77557.quest_subtitle: "Minecraft"
	quest.75EAFCA3CA9A12BB.quest_desc: ["Craft a Double Compressed Torcherino."]
	quest.75EAFCA3CA9A12BB.title: "Torcherino"
	quest.76110B292750ABFA.quest_desc: ["Elemental seeds create elemental essence - needed for Awakened Supremium."]
	quest.7613DCA157D6F599.quest_desc: ["Functions like a regular Laser Connector but supports faster transfer speeds and longer connection ranges."]
	quest.761C779A9A7EB48B.quest_desc: ["Turns nether stars into RF."]
	quest.76685F7238F1FDAA.quest_desc: ["Fill an experience obelisk with 2000 levels worth of experience."]
	quest.7669D1D2ADABBC61.quest_desc: ["Energy cubes can be used to hold large amounts of RF. The higher the tier, the more RF can be stored. Tier 2!"]
	quest.7690DEBD9A96EAF3.quest_desc: ["Found via mining in the Aether."]
	quest.769575F6979C0E37.quest_desc: ["An upgraded furnace with a base cook time of 140"]
	quest.76DD2F948B595981.quest_desc: ["x8 faster than the standard Import Bus – high-throughput for items."]
	quest.76DD2F948B595981.quest_subtitle: "ExtendedAE"
	quest.76F78E32732D4474.quest_desc: ["Craft at least one of every available Mystical Agriculture seed (see JEI for a list)."]
	quest.7707E9D68DDB4F1C.quest_desc: ["Obtained by defeating a Valkyrie in an Aether dungeon."]
	quest.77242D5BCA09AD9E.quest_desc: ["Made up of 4782969 cobblestone!"]
	quest.77290C3E67AAB489.quest_desc: ["An enchanted golden apple is a food item that, upon consumption, grants much more powerful effects than the golden apple."]
	quest.779090C8D9766F2E.quest_desc: ["It passively generates 4 EMC every 1 second up to a maximum of 10,000 EMC depending on the highest light level. When placed adjacent to an Energy Condenser MK1, Energy Condenser MK2, Anti-Matter Relay MK1, Anti-Matter Relay MK2 or Anti-Matter Relay MK3 it will transfer the EMC into that machine. "]
	quest.77B98898046B2C62.quest_desc: ["Keep cool with the power of ceiling fans!"]
	quest.77BC2640080C1E28.quest_desc: [
		"沉浸工程多方块机器，以3x3x3形式搭建，手持工程师锤右击中心即可形成多方块结构。高炉消耗焦煤和铁来炼钢，详情查阅工程师手册和JEI。"
		""
		"需要下界岩？熔岩接触到巫水即可形成下界岩，你可以依此建造一个类似刷石机的设备来刷取下界岩。"
	]
	quest.77BC2640080C1E28.title: "粗制高炉"
	quest.77BFFEA747850123.quest_desc: ["Upgraded essences are crafted using the previous tier of essence and an infusion crystal. Used to create Tier 6 seeds. (Crystals are required in expert mode)"]
	quest.77E52A098E50BDEB.quest_desc: [
		"Connect a generator to the workbench with the wrench. Use the worbench to craft furniture!"
		""
		"Introducing the next generation of MrCrayfish's Furntiure Mod, built from the ground up with brand new blocks, models, original sounds, and gameplay mechanics. Experience the new yet familiar charm of the original mod, and furnish your house with the hundreds of new and original decorational and functional blocks. Jump into new gameplay mechanics with the introduction of the electricity system to power all your appliances and electronics."
	]
	quest.77E52A098E50BDEB.quest_subtitle: "MrCrayfish's Furniture"
	quest.781B94F14DB8567B.quest_desc: [
		"A simple device to increase the concentration of residual Sal Ammoniac in water by evaporation."
		""
		"Place the accumulator on top of the tank. Fill the accumulator with water and let the magic happen!"
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.783995D4473F8F16.quest_desc: ["Iron Jetpacks is a modern Jetpacks mod that is both feature-rich and easy to use. Jetpacks get better as you craft higher tiers. Coils are an integral part of the jetpack crafting process. See JEI."]
	quest.78551C2B291A2FF4.quest_desc: [
		"Right click to instantly mines blocks based on the charge level (V, shift+V)."
		""
		"- disabled"
		"- 3x3x2"
		"- 5x5x3"
		"- 7x7x4"
		""
		"Does not mine dirt or gravel. It's also a powerful weapon and can be used as a tool to mine a single block at a time."
	]
	quest.7865E729501709AB.quest_desc: ["This is the most expensive ingot in the game. Please don't drop it into the void."]
	quest.7876E8455AEF262E.quest_desc: ["Use the Empowerer to turn minerals into powerful crystals that allow the creation of useful machines for processing and sorting items, lasers for wirelessly transporting energy, items and fluids, renewable oil to generate power, and much more."]
	quest.78894BE946EAEC1A.quest_desc: ["Uses uraninite, redstone, coal, water, and dry ice to generate RF."]
	quest.78A26490832112B9.quest_desc: ["Generate a timed redstone pulse unless a pulse is received in the meantime"]
	quest.78FD281689257180.quest_desc: [
		"由线筛网升级而来。"
		""
		"随着筛网等级的改变，筛取物品的掉落也会改变，详情查看JEI。"
	]
	quest.79929E7B59774B6F.quest_desc: ["Crafted using the energizing orb. Used in crafting recipes for niotic tier Powah items."]
	quest.79A6A2865FCF6823.quest_desc: ["Uses solar power (sun) to generate RF. Tier 1!"]
	quest.79C940682CE162AD.quest_desc: ["Crafting component and energy storage item used to build and upgrade generators, energy cells, and other power-related devices."]
	quest.79E4B4E103F1BCD2.quest_desc: ["Prevent mob spawns like a boss!"]
	quest.79F4C05D5286D51B.quest_desc: ["Hostile Neural Networks is a mod based on Deep Mob Learning for 1.16.5 and higher. It allows you to train data models and run simulations, producing mob predictions, which can be used to generate mob loot."]
	quest.79F4C05D5286D51B.quest_subtitle: "Hostile Neural Networks"
	quest.7A0CF4B9EC0C721A.quest_desc: ["焦煤在熔炉中的熔炼效率是煤炭的两倍：它能一次熔炼16个物品，而煤炭只能熔炼8个。"]
	quest.7A2458033521612B.quest_desc: ["Essence Tools are higher tier tools that can be upgraded using Augments."]
	quest.7A4526B9E3692400.quest_desc: [
		"Some planets are far away and need a larger amount of Fuel."
		""
		"This upgrade changes the maximum capacity of the Rocket fuel tank."
	]
	quest.7A5DEEFFB61A001D.quest_desc: [
		"There are six tiers of seeds in Mystical Agricuture."
		""
		"Tier 6 seeds require insanium essence to craft and a corresponding crux in order to grow."
	]
	quest.7A9732E087A91D3A.quest_desc: ["Klein Star Sphere holds up to 12,800,000 EMC and is also used in the crafting of Klein Star Omega."]
	quest.7AD5C805CE2E669A.quest_desc: ["The Wireless Crafting Terminal is similar to a regular wireless terminal, with all the same settings and sections, but with an added crafting grid that will be automatically refilled from network storage. Be careful when shift-clicking the output!"]
	quest.7AE22C13A4E632C0.quest_desc: ["Special apples that give different buffs! Hold shift while hovering over the apple to see its effects."]
	quest.7B1F4ED59085AA90.quest_desc: ["Kill a wither using Endest Pearls."]
	quest.7B4A91932EDD8AA6.quest_desc: ["Load chunks so stuff keeps on ticking when you aren't around. 7x7 area."]
	quest.7B93DDD4D0F141F5.quest_desc: [
		"This makes it easy to automatically keep items and fluids in your Applied Energistics 2 ME-System in stock!"
		""
		"The ME Requester can host 5 requests. You can place as many of them as you like on your system and remote access them through the ME Requester Terminal. The terminal allows you to configure the requests and monitor the status remotely."
	]
	quest.7B93DDD4D0F141F5.quest_subtitle: "ME Requester"
	quest.7BB443B4C618BE99.quest_desc: ["Made of 10,000 diamonds"]
	quest.7BBDF9B27538EBBF.quest_desc: ["能够吸取物品和经验球，还可以将它们分别输送进箱子和储罐里！"]
	quest.7BBDF9B27538EBBF.quest_subtitle: "Mob Grinding Utils"
	quest.7BE09731E15491FC.quest_desc: [
		"Industrial Foregoing is a comprehensive, industrial automation mod designed to streamline and improve your in-game production systems! Inspired by the classic MineFactory Reloaded, it brings modern, tech-driven machinery and tools to Minecraft, allowing players to create intricate automated systems for farming, processing resources, animal care, and more."
		""
		"With a wide array of industrial machines and utilities, you can automate almost every task in Minecraft. From resource gathering and processing to farming and mob management, Industrial Foregoing offers machines for efficiency and innovation."
	]
	quest.7BE09731E15491FC.quest_subtitle: "Industrial Foregoing"
	quest.7BF4DBAFDA24E9D8.quest_desc: ["Crafted using the energizing orb. Used in crafting recipes for spirited tier Powah items."]
	quest.7C14C70D761F3406.quest_desc: ["A better version of the Molecular Assembler - x8 parallel crafting."]
	quest.7C14C70D761F3406.quest_subtitle: "ExtendedAE"
	quest.7C2F4BFAE63F720C.quest_desc: ["Storage Components are the core of all AE2 cells, determining the capacity of the cells. Each tier increases the capacity by 4x and costs 3 of the previous tier."]
	quest.7C2F4BFAE63F720C.quest_subtitle: "MEGA Cells"
	quest.7C76B69A5387A4B9.quest_desc: [
		"Used as an ingredient and as an energy source."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.7CA54B9E1247379E.quest_desc: [
		"A practicing alchemist like yourself has no time to constantly pick up and place down alchemical chests for storage. By sprinkling high power covalence dust on an alchemical chest and wrapping it in cloth, you've managed to shrink the chest down to the size of a pouch."
		""
		"The bag has all the capacity of the chest. Curiously, the bags seem to be bound to some metaphysical network, as all bags of the same color seem to contain the same items, regardless of if the bag was yours or your neighbor's. The bag also seems to activate items the same way the chest does."
	]
	quest.7CA72D24324AAD71.quest_desc: [
		"Fermentation aid for recipes in the fermentation vat."
		""
		"See The Hermetica for more details on Theurgy."
	]
	quest.7CB1BDAA829F44E1.quest_desc: ["Catalysts are used in complex crafting recipes. They get harder to craft as they move higher in tiers."]
	quest.7CB1BDAA829F44E1.quest_subtitle: "Extended Crafting"
	quest.7D38B35F53BD03BE.quest_desc: ["Allows terminals/crafting devices Infinite range."]
	quest.7D38B35F53BD03BE.quest_subtitle: "AEInfinityBooster"
	quest.7D7844AD2210361D.quest_desc: ["Burns combustable fuels!"]
	quest.7D854FA56E399F98.quest_desc: ["A block that extends and links laser networks between Laser Nodes, allowing items, fluids, energy, or redstone to transfer over long distances."]
	quest.7D8F28A3E8A48CE7.quest_desc: ["Lets you select your desired destination before teleporting. Must have a trasmitter and receiver."]
	quest.7DB698F871417522.quest_desc: ["水晶箱子由钻石箱子升级而来。虽然容量没有变化，但是可以看见容器内的物品！"]
	quest.7DB74BAC57F10381.quest_desc: ["[ \"Must complete the quest \", { \"text\": \"Shepherd's Pie\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"44750CE6BE9DB523\" } }, \" to unlock.\" ]"]
	quest.7DB74BAC57F10381.quest_subtitle: "10 Coins"
	quest.7DB74BAC57F10381.title: "Artifact Reward Bag"
	quest.7DCFA1397747BF96.quest_desc: ["Load chunks so stuff keeps on ticking when you aren't around. 5x5 area."]
	quest.7E1ADEEC8EADE7A8.quest_desc: [
		"ProjectE is an open-source remake of Equivalent Exchange 2, released for Minecraft 1.7.10 and newer. It allows users to transmute materials into other materials, using various items and machines. It adds a system known as Energy-Mass Covalence, or EMC, which is used to represent the values of items."
		""
		"This value differs from item to item, and is used in determining how much of one material another requires. EMC can also be stored and produced through other means. EMC is also used by certain blocks and items to carry out powerful effects."
		""
		"&2Note: Not all items have EMC.&r"
	]
	quest.7E1ADEEC8EADE7A8.quest_subtitle: "ProjectE"
	quest.7E1ADEEC8EADE7A8.title: "Covalence Dust"
	quest.7E56A182F8DEF697.quest_desc: ["The Crusher, well, crushes things. Not to be mistaken for the Enrichment Chamber."]
	quest.7E7C8A3B94BF6C37.quest_desc: ["在筛网上附魔效率和时运，提升速度和掉率！"]
	quest.7ED21876B4C1CE24.quest_desc: ["Obtained by reprocessing benitoite with rossinite, which is a waste product from using verderium as fuel in a reactor."]
	quest.7EE2214DA65D041B.quest_desc: ["Makes your rocket look like a big rocket!"]
	quest.7EEF3486A0EB8B61.quest_desc: ["Use energy to automate chiseling blocks! "]
	quest.7EF319CB8B4339B6.quest_desc: [
		"A space suit is required to survive on other planets and moons."
		""
		"Beware of fall damage with the gravity on different planets/moons!"
	]
	quest.7EF319CB8B4339B6.title: "Space Suit"
	quest.7EFFE27D4D7E6668.quest_desc: [
		"Store RF, like a battery!"
		""
		"It is a shapeless multiblock; putting a Basic Capacitor Bank next to another Basic Capacitor Bank will combine their energy storage."
	]
	quest.7F1466B397B51F04.quest_desc: ["Combine Rogdorium and Utheric Shards in an Infuser to obtain Utherium Crystals."]
	quest.7F147A591795B284.quest_desc: [
		"The finity of aura in the world can be troubling to think about, because once it is drained, it seems like it is not restorable. That, however, is not the case: there are many ways to regenerate aura. See the guidebook for instructions."
		""
		"Refer to the Book of Natural Aura (guidebook) for full detailed information on Nature's Aura."
	]
	quest.7F147A591795B284.title: "Aura Generation"
	quest.7F24945B6C1F2800.quest_desc: ["This is unlocked from the start of the modpack."]
	quest.7F24945B6C1F2800.quest_subtitle: "3 Coins"
	quest.7F24945B6C1F2800.title: "Common Reward Bag"
	quest.7F3DEB9D1E5BC790.quest_desc: ["These are the primary components of AE2 input and output devices. Using the power of Fluix Crystal and a logic processor it allows devices to input and output items, blocks, fluids, etc. (No actual function, just a crafting intermediate)"]
	quest.7F3DEB9D1E5BC790.title: "Cores"
	quest.7F6DDDD318E1BFCC.quest_desc: ["铁箱子由铜箱子升级而来。"]
	quest.7FF33FA53596F5F3.quest_desc: [
		"A single-biome dimension cloaked in darkness."
		""
		"- Normal torches will burn out over time."
		"- The darkness itself deals damage, so stay illuminated."
		"- Hostile mobs spawn frequently and have extra health."
		"- Ores are abundant, making this an excellent (if dangerous) mining zone."
		""
		"Vanilla ores can be found all over, but to find more varied modded ores you need to get below y-level 80."
	]
	quest.7FF33FA53596F5F3.quest_subtitle: "Dimension Expansion"
